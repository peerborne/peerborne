{
  "name": "@peerborne/core",
  "description": "Encrypted local-first CRDT documents over peer-to-peer networks",
  "version": "0.1.0",
  "homepage": "https://peerborne.io/",
  "bugs": {
    "url": "https://github.com/Peerborne/peerborne/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peerborne/peerborne.git",
    "directory": "packages/core"
  },
  "scripts": {
    "tsc": "tsc -b",
    "prepublishOnly": "yarn tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "tsc-watch": "tsc -w -p tsconfig.json",
    "doc": "typedoc --excludePrivate --excludeProtected --excludeInternal",
    "benchmark": "tsx src/__benchmarks__/run.ts",
    "test:coverage": "yarn test --coverage"
  },
  "main": "dist/esm/src/index.js",
  "types": "dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/esm/src/index.js",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/esm/src/peerborne-node.d.ts",
      "import": "./dist/esm/src/peerborne-node.js",
      "require": "./dist/esm/src/peerborne-node.js",
      "default": "./dist/esm/src/peerborne-node.js"
    },
    "./browser-primitives": {
      "types": "./dist/esm/src/browser-primitives.d.ts",
      "import": "./dist/esm/src/browser-primitives.js",
      "require": "./dist/esm/src/browser-primitives.js",
      "default": "./dist/esm/src/browser-primitives.js"
    },
    "./wire-protocols": {
      "types": "./dist/esm/src/wire-protocols.d.ts",
      "import": "./dist/esm/src/wire-protocols.js",
      "require": "./dist/esm/src/wire-protocols.js",
      "default": "./dist/esm/src/wire-protocols.js"
    }
  },
  "files": [
    "dist/esm/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__/**",
    "!dist/**/__benchmarks__/**",
    "!dist/**/__mocks__/**",
    "!dist/**/__testutils__/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "author": "allegrormc@gmail.com",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1"
  },
  "devDependencies": {
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/json-schema": "^3.0.0",
    "@peculiar/webcrypto": "^2.0.0",
    "@types/node": "^26.6.7",
    "asn1js": "^4.0.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "webcrypto-core": "^2.0.0"
  },
  "resolutions": {
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/bitswap": "^4.0.20",
    "@helia/libp2p": "^2.1.5",
    "@helia/unixfs": "^8.0.9",
    "@ipld/dag-cbor": "^11.0.0",
    "@ipld/dag-json": "^12.0.0",
    "@libp2p/autonat": "^3.0.33",
    "@libp2p/bootstrap": "^12.0.37",
    "@libp2p/circuit-relay-v2": "^4.2.18",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/dcutr": "^3.0.33",
    "@libp2p/gossipsub": "^17.2.2",
    "@libp2p/identify": "^4.1.19",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/kad-dht": "^16.4.10",
    "@libp2p/mdns": "^12.0.37",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/ping": "^3.1.18",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/utils": "^7.4.6",
    "@libp2p/webrtc": "^7.0.3",
    "@libp2p/websockets": "^10.1.26",
    "@libp2p/webtransport": "^6.0.45",
    "@multiformats/multiaddr": "^13.0.3",
    "blockstore-core": "^7.0.1",
    "blockstore-idb": "^4.0.1",
    "datastore-core": "^12.0.1",
    "datastore-idb": "^5.0.1",
    "helia": "^7.1.16",
    "ipns": "^11.0.1",
    "it-pipe": "^3.0.1",
    "js-base64": "^3.9.7",
    "libp2p": "^3.5.2",
    "multiformats": "^14.0.7",
    "uint8arraylist": "^3.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node",
      "ts-jest"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__benchmarks__"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.cjs"
    ],
    "moduleNameMapper": {
      "^(.{1,2}/.*).js$": "$1"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.benchmark.ts",
      "!src/**/__mocks__/**",
      "!src/**/__testutils__/**",
      "!src/**/__benchmarks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(fast-check)/)"
    ]
  },
  "module": "dist/esm/src/index.js"
}
