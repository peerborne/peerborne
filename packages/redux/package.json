{
  "name": "@peerborne/redux",
  "description": "Redux bindings for Peerborne collaborative documents",
  "version": "0.1.0",
  "homepage": "https://peerborne.io/",
  "bugs": {
    "url": "https://github.com/Peerborne/peerborne/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peerborne/peerborne.git",
    "directory": "packages/redux"
  },
  "scripts": {
    "tsc": "tsc -b && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "prepublishOnly": "yarn tsc",
    "test": "jest",
    "tsc-watch": "tsc -w -p tsconfig.json"
  },
  "main": "dist/cjs/src/index.js",
  "types": "dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__/**",
    "!dist/**/__benchmarks__/**",
    "!dist/**/__mocks__/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "author": "allegrormc@gmail.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^10.4.1",
    "jest": "^29.2.5",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@peerborne/core": "workspace:^",
    "redux": "^4.0.0 || ^5.0.0",
    "redux-thunk": "^2.0.0 || ^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": false
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@peerborne/core$": "<rootDir>/src/__mocks__/@peerborne/core.ts"
    }
  },
  "module": "dist/esm/src/index.js"
}
