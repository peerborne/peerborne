{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "sourceMap": true,
    "downlevelIteration": true,
    "strict": true,
    "declaration": true,
    "types": ["node"],
    "typeRoots": ["types", "node_modules/@types", "../../node_modules/@types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist/esm",
    "composite": true
  },
  "exclude": [
    "node_modules",
    "examples",
    "extras",
"src/**/*.test.ts",
    "src/**/__benchmarks__/**",
    "src/**/__mocks__/**"
  ],
  "include": [
    "src",
    "types"
  ],
  "references": [{
    "path": "../core"
  }]
}
