{
  "name": "@peerborne/yjs",
  "description": "Yjs adapter for Peerborne collaborative documents",
  "version": "0.1.0",
  "homepage": "https://peerborne.io/",
  "bugs": {
    "url": "https://github.com/Peerborne/peerborne/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peerborne/peerborne.git",
    "directory": "packages/yjs"
  },
  "scripts": {
    "tsc": "tsc -b && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "prepublishOnly": "yarn tsc",
    "test": "jest",
    "tsc-watch": "tsc -w -p tsconfig.json"
  },
  "bin": {
    "peerborne-yjs-d": "dist/esm/bin/peerborne-yjs-d.js"
  },
  "main": "dist/cjs/src/index.js",
  "types": "dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__/**",
    "!dist/**/__benchmarks__/**",
    "!dist/**/__mocks__/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "author": "allegrormc@gmail.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@peculiar/webcrypto": "^1.7.1",
    "@types/node": "^22.7.5",
    "eslint": "^10.4.1",
    "jest": "^29.2.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.1.0",
    "typescript": "^5.9.3",
    "yjs": "^13.6.30"
  },
  "dependencies": {
    "@peerborne/core": "workspace:^"
  },
  "peerDependencies": {
    "yjs": "^13.6.30"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@peerborne/core$": "<rootDir>/../core/src/index.ts",
      "^@chainsafe/libp2p-noise$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@chainsafe/libp2p-yamux$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/gossipsub$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/bootstrap$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/pubsub-peer-discovery$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/circuit-relay-v2$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/webrtc$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/webtransport$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/websockets$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/websockets/filters$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/identify$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/dcutr$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/autonat$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/kad-dht$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/interface$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/mdns$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/peer-id$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@libp2p/ping$": "<rootDir>/src/__mocks__/empty-module.js",
      "^ipns/selector$": "<rootDir>/src/__mocks__/empty-module.js",
      "^ipns/validator$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@helia/bitswap$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@helia/interface$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@helia/libp2p$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@helia/unixfs$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@ipld/(.*)$": "<rootDir>/src/__mocks__/empty-module.js",
      "^helia$": "<rootDir>/src/__mocks__/empty-module.js",
      "^datastore-idb$": "<rootDir>/src/__mocks__/empty-module.js",
      "^blockstore-idb$": "<rootDir>/src/__mocks__/empty-module.js",
      "^libp2p$": "<rootDir>/src/__mocks__/empty-module.js",
      "^it-pipe$": "<rootDir>/src/__mocks__/empty-module.js",
      "^bl$": "<rootDir>/src/__mocks__/empty-module.js",
      "^multiformats$": "<rootDir>/src/__mocks__/empty-module.js",
      "^multiformats/(.*)$": "<rootDir>/src/__mocks__/empty-module.js",
      "^@multiformats/multiaddr$": "<rootDir>/src/__mocks__/empty-module.js"
    }
  },
  "module": "dist/esm/src/index.js"
}
