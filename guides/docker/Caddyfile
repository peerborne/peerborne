# Caddy reverse proxy for Peerborne relay servers
#
# Route each hostname to the relay that owns its advertised libp2p peer ID.
# Caddy uses its local CA for .localhost and automatic HTTPS for public DNS.

{$RELAY_1_DOMAIN:relay-1.localhost} {
	reverse_proxy relay-1:9001
}

{$RELAY_2_DOMAIN:relay-2.localhost} {
	reverse_proxy relay-2:9001
}
