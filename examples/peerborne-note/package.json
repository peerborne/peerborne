{
  "name": "@peerborne/peerborne-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:deployment": "tsc --noEmit && vite build --mode deployment",
    "deploy": "yarn build:deployment && npx --yes wrangler@4.156.0 pages deploy --branch main",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@peerborne/automerge": "workspace:packages/automerge",
    "@peerborne/core": "workspace:packages/core",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@libp2p/peer-id": "^6.0.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-wasm": "^3.6.0"
  }
}
