{
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/automerge",
    "packages/yjs",
    "packages/react",
    "packages/redux",
    "packages/index",
    "examples/browser-test",
    "examples/wiki-swarm",
    "examples/password-manager",
    "site"
  ],
  "resolutions": {
    "@peculiar/asn1-schema": "^2.6.0",
    "uint8arraylist": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -Atvi --include '@peerborne/core' --include '@peerborne/automerge' --include '@peerborne/yjs' --include '@peerborne/react' --include '@peerborne/redux' --include '@peerborne/index' run tsc",
    "build:examples": "yarn build && yarn workspaces foreach -Avi --include '@peerborne/browser-test' --include '@peerborne/wiki-swarm' --include '@peerborne/password-manager' run build",
    "test": "yarn workspaces foreach -Apvi --include '@peerborne/core' --include '@peerborne/yjs' --include '@peerborne/react' --include '@peerborne/automerge' --include '@peerborne/redux' --include '@peerborne/index' run test",
    "test:e2e": "yarn test:e2e:examples",
    "test:e2e:examples": "yarn test:e2e:password-manager && yarn test:e2e:wiki-swarm && yarn test:e2e:browser-test",
    "test:e2e:password-manager": "yarn workspace @peerborne/password-manager build && playwright test --config=playwright.password-manager.config.ts",
    "test:e2e:wiki-swarm": "yarn workspace @peerborne/wiki-swarm build && playwright test --config=playwright.wiki-swarm.config.ts",
    "test:e2e:browser-test": "yarn workspace @peerborne/browser-test build && playwright test --config=playwright.browser-test.config.ts",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:nat": "playwright test --config=playwright.nat-test.config.ts",
    "test:peerborne-nat": "playwright test --config=playwright.peerborne-nat.config.ts",
    "test:relay": "yarn --cwd relay-server test",
    "test:release": "node --test scripts/release-packages.test.mjs scripts/publish-release.tests.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:validate-consumer": "node scripts/validate-release-consumer.mjs",
    "benchmark:all": "yarn workspaces foreach -Apvi --include '@peerborne/core' --include '@peerborne/index' run benchmark"
  },
  "packageManager": "yarn@4.5.0"
}
