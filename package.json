{
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/automerge",
    "packages/yjs",
    "packages/react",
    "packages/redux",
    "packages/index",
    "packages/store",
    "packages/vue",
    "packages/svelte",
    "packages/loro",
    "packages/tanstack-db",
    "examples/browser-test",
    "examples/wiki-swarm",
    "examples/password-manager",
    "examples/peerborne-note",
    "examples/integrations",
    "site"
  ],
  "resolutions": {
    "@peculiar/asn1-schema": "^2.6.0",
    "uint8arraylist": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tsx": "4.23.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -Atvi --include '@peerborne/core' --include '@peerborne/automerge' --include '@peerborne/yjs' --include '@peerborne/react' --include '@peerborne/redux' --include '@peerborne/index' --include '@peerborne/store' --include '@peerborne/vue' --include '@peerborne/svelte' --include '@peerborne/loro' --include '@peerborne/tanstack-db' run tsc",
    "build:examples": "yarn build && yarn workspaces foreach -Avi --include '@peerborne/browser-test' --include '@peerborne/wiki-swarm' --include '@peerborne/password-manager' --include '@peerborne/peerborne-note' --include '@peerborne/integration-examples' run build",
    "test": "yarn workspaces foreach -Apvi --include '@peerborne/core' --include '@peerborne/yjs' --include '@peerborne/react' --include '@peerborne/automerge' --include '@peerborne/redux' --include '@peerborne/index' --include '@peerborne/store' --include '@peerborne/vue' --include '@peerborne/svelte' --include '@peerborne/loro' --include '@peerborne/tanstack-db' run test",
    "test:e2e": "yarn test:e2e:examples",
    "test:e2e:examples": "yarn test:e2e:password-manager && yarn test:e2e:wiki-swarm && yarn test:e2e:browser-test && yarn test:e2e:peerborne-note && yarn test:e2e:integrations",
    "test:e2e:password-manager": "yarn workspace @peerborne/password-manager build && playwright test --config=playwright.password-manager.config.ts",
    "test:e2e:wiki-swarm": "yarn workspace @peerborne/wiki-swarm build && playwright test --config=playwright.wiki-swarm.config.ts",
    "test:e2e:browser-test": "yarn workspace @peerborne/browser-test build && playwright test --config=playwright.browser-test.config.ts",
    "test:e2e:peerborne-note": "yarn workspace @peerborne/peerborne-note build && playwright test --config=playwright.peerborne-note.config.ts",
    "test:e2e:peerborne-note:live": "playwright test --config=playwright.peerborne-note-live.config.ts",
    "test:peerborne-note": "yarn workspace @peerborne/peerborne-note test",
    "test:password-manager": "yarn workspace @peerborne/password-manager test",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:nat": "playwright test --config=playwright.nat-test.config.ts",
    "test:peerborne-nat": "playwright test --config=playwright.peerborne-nat.config.ts",
    "test:relay": "yarn --cwd relay-server test",
    "verify:technical": "yarn build && node --expose-gc verification/run.mjs",
    "verify:technical:browser": "yarn build && playwright test --config=verification/playwright.config.ts",
    "verify:technical:nat": "playwright test --config=verification/playwright.nat.config.ts",
    "test:release": "node --test scripts/release-packages.test.mjs scripts/publish-release.tests.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:validate-consumer": "node scripts/validate-release-consumer.mjs",
    "benchmark:all": "yarn workspaces foreach -Apvi --include '@peerborne/core' --include '@peerborne/index' run benchmark",
    "benchmark:ci": "tsx --expose-gc scripts/benchmark-ci.mjs",
    "visuals:generate": "node scripts/render-peerborne-hook.mjs",
    "visuals:check": "node scripts/render-peerborne-hook.mjs --check",
    "visuals:test": "node --test scripts/render-peerborne-hook.test.mjs && yarn visuals:check",
    "verify:advanced": "yarn build && node --expose-gc verification/advanced/run.mjs",
    "verify:advanced:browser": "yarn build && playwright test --config=verification/advanced/playwright.config.ts",
    "verify:formal:setup": "node verification/formal/setup.mjs",
    "verify:formal": "node verification/formal/run.mjs",
    "verify:formal:regen": "node verification/formal/run.mjs --regen",
    "verify:formal:controls": "node verification/formal/controls.mjs",
    "verify:formal:inventory": "node verification/formal/inventory.mjs",
    "verify:mls-candidate:setup": "yarn --cwd verification/mls-candidate install --immutable",
    "verify:mls-candidate": "node verification/mls-candidate/run.mjs",
    "build:integrations": "yarn build && yarn workspace @peerborne/integration-examples build",
    "test:e2e:integrations": "yarn build:integrations && playwright test --config=playwright.integrations.config.ts",
    "verify:mls-provider:setup": "yarn --cwd verification/mls-provider install --immutable && node verification/mls-provider/setup-vectors.mjs",
    "verify:mls-provider:typecheck": "yarn workspace @peerborne/core exec tsc -p ../../verification/mls-provider/tsconfig.json",
    "verify:mls-provider": "node --import tsx verification/mls-provider/run.mjs"
  },
  "packageManager": "yarn@4.5.0"
}
