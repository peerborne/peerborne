// Generated by lsc from query-order.ts
// lsc options: string-semantics=javascript-utf16

predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

function NormalizeSliceIndex(n: nat, i: int): int
  ensures 0 <= NormalizeSliceIndex(n, i) <= n as int
{
  if i < 0 then
    if n as int + i < 0 then 0 else n as int + i
  else if i > n as int then n as int
  else i
}

function SafeSlice<T>(s: seq<T>, lo: int, hi: int): seq<T>
  ensures |SafeSlice(s, lo, hi)| <= |s|
{
  var lo' := NormalizeSliceIndex(|s|, lo);
  var hi' := NormalizeSliceIndex(|s|, hi);
  if hi' < lo' then [] else s[lo'..hi']
}

datatype SortDirection = SortDirection(direction: string)

function compareCodeUnits(left: string, right: string): int
{
  if (left == right) then
    0
  else
    if JSStringLt(left, right) then
      -1
    else
      1
}

lemma compareCodeUnits_ensures(left: string, right: string)
  ensures ((compareCodeUnits(left, right) == 0) <==> (left == right))
  ensures ((compareCodeUnits(left, right) == -1) <==> JSStringLt(left, right))
  ensures ((compareCodeUnits(left, right) == 1) <==> JSStringLt(right, left))
{
}

function compareFiniteNumbers(left: real, right: real): int
{
  if (left == right) then
    0
  else
    if (left < right) then
      -1
    else
      1
}

lemma compareFiniteNumbers_ensures(left: real, right: real)
  ensures ((compareFiniteNumbers(left, right) == 0) <==> (left == right))
  ensures ((compareFiniteNumbers(left, right) == -1) <==> (left < right))
  ensures ((compareFiniteNumbers(left, right) == 1) <==> (left > right))
{
}

function takeQueryPage<Entry(==)>(entries: seq<Entry>, first: int): seq<Entry>
  requires (0 <= first)
  requires (first <= 9007199254740991)
  requires (|entries| <= 4294967295)
{
  SafeSlice(entries, 0, first)
}

lemma takeQueryPage_ensures<Entry>(entries: seq<Entry>, first: int)
  requires (0 <= first)
  requires (first <= 9007199254740991)
  requires (|entries| <= 4294967295)
  ensures (|takeQueryPage(entries, first)| == (if (first < |entries|) then first else |entries|))
  ensures forall i: int :: ((0 <= i) ==> (i < |takeQueryPage(entries, first)|) ==> (takeQueryPage(entries, first)[i] == entries[i]))
{
}

method compareQueryKeys(directions: seq<SortDirection>, comparisonAt: (int) -> int, leftPath: string, rightPath: string) returns (res: int)
  requires (|directions| <= 8)
  requires forall i: int :: ((0 <= i) ==> (i < |directions|) ==> ((-1 <= comparisonAt(i)) && (comparisonAt(i) <= 1)))
  ensures (-1 <= res)
  ensures (res <= 1)
  ensures ((forall i: int :: ((0 <= i) ==> (i < |directions|) ==> (comparisonAt(i) == 0))) ==> (res == compareCodeUnits(leftPath, rightPath)))
  ensures ((res == 0) <==> ((leftPath == rightPath) && forall i: int :: ((0 <= i) ==> (i < |directions|) ==> (comparisonAt(i) == 0))))
  ensures ((exists i: int :: (((0 <= i) && (i < |directions|)) && (comparisonAt(i) != 0))) ==> exists i: int :: (((((0 <= i) && (i < |directions|)) && (comparisonAt(i) != 0)) && forall j: int :: ((0 <= j) ==> (j < i) ==> (comparisonAt(j) == 0))) && (res == (if (directions[i].direction == "desc") then (-(comparisonAt(i))) else comparisonAt(i)))))
{
  var index := 0;
  while (index < |directions|)
    invariant (0 <= index)
    invariant (index <= |directions|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> (comparisonAt(i) == 0))
    decreases (|directions| - index)
  {
    var compared := comparisonAt(index);
    if (compared != 0) {
      return (if (directions[index].direction == "desc") then (-(compared)) else compared);
    }
    index := (index + 1);
  }
  var i_t0 := compareCodeUnits(leftPath, rightPath);
  return i_t0;
}
