function SeqIndexOf<T(==)>(s: seq<T>, x: T): int
  ensures -1 <= SeqIndexOf(s, x) < |s|
  ensures SeqIndexOf(s, x) >= 0 ==> s[SeqIndexOf(s, x)] == x
  ensures SeqIndexOf(s, x) == -1 ==> x !in s
{
  SeqIndexOfFrom(s, x, 0)
}

function SeqIndexOfFrom<T(==)>(s: seq<T>, x: T, from: nat): int
  requires from <= |s|
  ensures -1 <= SeqIndexOfFrom(s, x, from) < |s|
  ensures SeqIndexOfFrom(s, x, from) >= 0 ==> s[SeqIndexOfFrom(s, x, from)] == x
  ensures SeqIndexOfFrom(s, x, from) == -1 ==> forall i :: from <= i < |s| ==> s[i] != x
  decreases |s| - from
{
  if from == |s| then -1
  else if s[from] == x then from as int
  else SeqIndexOfFrom(s, x, from + 1)
}

function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

datatype DelegatedCapability = DelegatedCapability(resource: string, ability: string)

function capabilityImplies(held: string, required: string): bool
{
  var heldIndex := SeqIndexOf(CAPABILITY_HIERARCHY, held);
  var requiredIndex := SeqIndexOf(CAPABILITY_HIERARCHY, required);
  if ((heldIndex == -1) || (requiredIndex == -1)) then
    (held == required)
  else
    (heldIndex <= requiredIndex)
}

lemma capabilityImplies_ensures(held: string, required: string)
  ensures (capabilityImplies(held, required) <==> (((held == required) || ((held == "/doc/admin") && ((required == "/doc/write") || (required == "/doc/read")))) || ((held == "/doc/write") && (required == "/doc/read"))))
{
}

function isFieldCapability(capability: string): bool
{
  (StringIndexOf(capability, "/field/") >= 0)
}

lemma isFieldCapability_ensures(capability: string)
  ensures (isFieldCapability(capability) <==> (StringIndexOf(capability, "/field/") >= 0))
{
}

function parentGrantsCapability(parent: seq<DelegatedCapability>, resource: string, ability: string): bool
{
  (exists candidate :: candidate in parent && ((candidate.resource == resource) && capabilityImplies(candidate.ability, ability)))
}

lemma parentGrantsCapability_ensures(parent: seq<DelegatedCapability>, resource: string, ability: string)
  ensures (parentGrantsCapability(parent, resource, ability) <==> exists candidate: DelegatedCapability :: (((candidate in parent) && (candidate.resource == resource)) && capabilityImplies(candidate.ability, ability)))
{
}

const CAP_DOC_ADMIN: string := "/doc/admin"

const CAP_DOC_WRITE: string := "/doc/write"

const CAP_DOC_READ: string := "/doc/read"

const CAPABILITY_HIERARCHY: seq<string> := [CAP_DOC_ADMIN, CAP_DOC_WRITE, CAP_DOC_READ]

method findUnauthorizedCapability(delegated: seq<DelegatedCapability>, parent: seq<DelegatedCapability>) returns (res: int)
  requires (|delegated| <= 4294967295)
  requires (|parent| <= 4294967295)
  ensures (-1 <= res)
  ensures (res < |delegated|)
  ensures ((res == -1) <==> forall i: int :: ((0 <= i) ==> (i < |delegated|) ==> parentGrantsCapability(parent, delegated[i].resource, delegated[i].ability)))
  ensures ((res >= 0) ==> !(parentGrantsCapability(parent, delegated[res].resource, delegated[res].ability)))
  ensures forall i: int :: ((0 <= i) ==> (i < res) ==> parentGrantsCapability(parent, delegated[i].resource, delegated[i].ability))
{
  var index := 0;
  while (index < |delegated|)
    invariant (0 <= index)
    invariant (index <= |delegated|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> parentGrantsCapability(parent, delegated[i].resource, delegated[i].ability))
    decreases (|delegated| - index)
  {
    var grant := delegated[index];
    var i_t0 := parentGrantsCapability(parent, grant.resource, grant.ability);
    if !(i_t0) {
      return index;
    }
    index := (index + 1);
  }
  return -1;
}
