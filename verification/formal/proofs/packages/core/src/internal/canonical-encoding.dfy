// Generated by lsc from canonical-encoding.ts
// lsc options: string-semantics=javascript-utf16

function utf8UnitByteLength(code: int): int
  requires (0 <= code)
  requires (code <= 65535)
{
  if (code < 128) then
    1
  else
    if (code < 2048) then
      2
    else
      if ((code >= 55296) && (code <= 57343)) then
        2
      else
        3
}

lemma utf8UnitByteLength_ensures(code: int)
  requires (0 <= code)
  requires (code <= 65535)
  ensures (1 <= utf8UnitByteLength(code))
  ensures (utf8UnitByteLength(code) <= 3)
  ensures (utf8UnitByteLength(code) == (if (code < 128) then 1 else (if (code < 2048) then 2 else (if ((55296 <= code) && (code <= 57343)) then 2 else 3))))
{
}

function isPairedUtf16Unit(value: string, index: int): bool
  requires (0 <= index)
  requires (index < |value|)
  requires (|value| <= 4294967295)
{
  var code := (value[index] as int);
  if isHighSurrogate(code) then
    (((index + 1) < |value|) && isLowSurrogate((value[(index + 1)] as int)))
  else
    if isLowSurrogate(code) then
      ((index > 0) && isHighSurrogate((value[(index - 1)] as int)))
    else
      true
}

lemma isPairedUtf16Unit_ensures(value: string, index: int)
  requires (0 <= index)
  requires (index < |value|)
  requires (|value| <= 4294967295)
  ensures (isPairedUtf16Unit(value, index) <==> ((!(isHighSurrogate((value[index] as int))) || (((index + 1) < |value|) && isLowSurrogate((value[(index + 1)] as int)))) && (!(isLowSurrogate((value[index] as int))) || ((index > 0) && isHighSurrogate((value[(index - 1)] as int))))))
{
}

function isHighSurrogate(code: int): bool
{
  ((code >= 55296) && (code <= 56319))
}

lemma isHighSurrogate_ensures(code: int)
  ensures (isHighSurrogate(code) <==> ((55296 <= code) && (code <= 56319)))
{
}

function isLowSurrogate(code: int): bool
{
  ((code >= 56320) && (code <= 57343))
}

lemma isLowSurrogate_ensures(code: int)
  ensures (isLowSurrogate(code) <==> ((56320 <= code) && (code <= 57343)))
{
}

function Utf8PrefixBytes(value: string, count: int): int
  requires 0 <= count <= |value| <= 4294967295
  ensures count <= Utf8PrefixBytes(value, count) <= 3 * count
  ensures forall start :: 0 <= start < count ==> Utf8PrefixBytes(value, start) < Utf8PrefixBytes(value, count)
  decreases count
{
  if count == 0 then 0 else
    Utf8PrefixBytes(value, count - 1) + utf8UnitByteLength(value[count - 1] as int)
}

lemma utf8PrefixMonotone(value: string, start: int, end: int)
  requires 0 <= start <= end <= |value| <= 4294967295
  ensures Utf8PrefixBytes(value, start) <= Utf8PrefixBytes(value, end)
  decreases end - start
{
  if start < end { utf8PrefixMonotone(value, start, end - 1); }
}

method boundedUtf8ByteLength(value: string, maximum: int) returns (res: int)
  requires (|value| <= 4294967295)
  requires (0 <= maximum)
  requires (maximum <= 4294967295)
  ensures (-2 <= res)
  ensures (res <= maximum)
  ensures ((|value| > maximum) ==> (res == -1))
  ensures ((res >= 0) ==> ((|value| <= res) && (res <= (3 * |value|))))
  ensures ((res >= 0) ==> forall j: int :: ((0 <= j) ==> (j < |value|) ==> isPairedUtf16Unit(value, j)))
  ensures ((res == -2) ==> exists j: int :: (((0 <= j) && (j < |value|)) && !(isPairedUtf16Unit(value, j))))
  ensures res >= 0 <==> (forall j :: 0 <= j < |value| ==> isPairedUtf16Unit(value, j)) && Utf8PrefixBytes(value, |value|) <= maximum
  ensures res >= 0 ==> res == Utf8PrefixBytes(value, |value|)
  ensures res == -1 ==> Utf8PrefixBytes(value, |value|) > maximum
{
  if (|value| > maximum) {
    return -1;
  }
  var bytes := 0;
  var index := 0;
  while (index < |value|)
    invariant (0 <= index)
    invariant (index <= |value|)
    invariant (index <= maximum)
    invariant (0 <= bytes)
    invariant (bytes <= maximum)
    invariant (index <= bytes)
    invariant (bytes <= (3 * index))
    invariant bytes == Utf8PrefixBytes(value, index)
    invariant index < |value| ==> Utf8PrefixBytes(value, index + 1) == bytes + utf8UnitByteLength(value[index] as int)
    invariant index < |value| ==> Utf8PrefixBytes(value, index + 1) <= Utf8PrefixBytes(value, |value|)
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> isPairedUtf16Unit(value, j))
    decreases (|value| - index)
  {
    var i_t0 := isPairedUtf16Unit(value, index);
    if !(i_t0) {
      return -2;
    }
    var i_t1 := utf8UnitByteLength((value[index] as int));
    var width := i_t1;
    if (width > (maximum - bytes)) {
      return -1;
    }
    bytes := (bytes + width);
    index := (index + 1);
  }
  return bytes;
}

method isWellFormedUtf16(value: string) returns (res: bool)
  requires (|value| <= 4294967295)
  ensures (res <==> forall j: int :: ((0 <= j) ==> (j < |value|) ==> isPairedUtf16Unit(value, j)))
{
  var index := 0;
  while (index < |value|)
    invariant (0 <= index)
    invariant (index <= |value|)
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> isPairedUtf16Unit(value, j))
    decreases (|value| - index)
  {
    var i_t2 := isPairedUtf16Unit(value, index);
    if !(i_t2) {
      return false;
    }
    index := (index + 1);
  }
  return true;
}

predicate ValidUtf16Unit(value: string, j: int)
  requires 0 <= j < |value|
{
  (!isHighSurrogate(value[j] as int) || (j + 1 < |value| && isLowSurrogate(value[j + 1] as int))) &&
  (!isLowSurrogate(value[j] as int) || (j > 0 && isHighSurrogate(value[j - 1] as int)))
}

method boundedUtf8_domain()
{
  var empty := boundedUtf8ByteLength("", 0);
  assert empty == 0;
  var ascii := boundedUtf8ByteLength("a", 1);
  assert ascii == 1;
  var two := boundedUtf8ByteLength("\u07FF", 2);
  assert two == 2;
  var three := boundedUtf8ByteLength("\u0800", 3);
  assert three == 3;
  var pair := boundedUtf8ByteLength("\uD83D\uDE00", 4);
  assert pair == 4;
  var limited := boundedUtf8ByteLength("\uD83D\uDE00", 3);
  assert limited == -1;
  assert !isPairedUtf16Unit("\uD800", 0);
  assert Utf8PrefixBytes("\uD800", 1) == 2;
  var unpaired := boundedUtf8ByteLength("\uD800", 3);
  assert unpaired == -2;
  var rejected := boundedUtf8ByteLength("a", 0);
  assert rejected == -1;
}

method canonicalEncoding_domain()
{
  assert isHighSurrogate(55296);
  assert isLowSurrogate(57343);
  assert isPairedUtf16Unit("a", 0);
  var empty := isWellFormedUtf16("");
  var ascii := isWellFormedUtf16("a");
  var paired := isWellFormedUtf16("\uD83D\uDE00");
  var unpaired := isWellFormedUtf16("\uD800");
}

lemma canonicalUnit_exact(value: string, index: int)
  requires 0 <= index < |value| <= 4294967295
  ensures isPairedUtf16Unit(value, index) <==> ValidUtf16Unit(value, index)
{
  isPairedUtf16Unit_ensures(value, index);
}
