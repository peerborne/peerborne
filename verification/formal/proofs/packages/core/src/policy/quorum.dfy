  while (index < |digests|)
    invariant (0 <= index)
    invariant (index <= |digests|)
    invariant forall key :: ((key in counts) <==> exists j: int :: (((0 <= j) && (j < index)) && (digests[j] == key)))
    invariant forall key :: ((key in counts) ==> ((1 <= counts[key]) && (counts[key] <= index)))
    invariant forall key :: (if key in counts then counts[key] else 0) == DigestOccurrences(digests[..index], key)
    decreases (|digests| - index)
  {
    ghost var priorCounts := counts;
    var digest := digests[index];
    var previous := (if digest in counts then Some(counts[digest]) else None);
    var count := (match previous { case Some(i_previous_val) => i_previous_val case None => 0 });
    counts := counts[digest := (count + 1)];
    forall key
      ensures (if key in counts then counts[key] else 0) == DigestOccurrences(digests[..index+1], key)
    {
      DigestOccurrencesAppend(digests[..index], digest, key);
      assert digests[..index+1] == digests[..index] + [digest];
      if key == digest {
        assert count == (if key in priorCounts then priorCounts[key] else 0);
      }
    }
    index := (index + 1);
  }
  assert digests[..index] == digests;
  return counts;
}

