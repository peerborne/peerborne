  var empty := selectQuorumBucket([], 1);
  var unique := selectQuorumBucket([1, 3, 2], 3);
  var conflicting := selectQuorumBucket([3, 3], 3);
  var unreachable := selectQuorumBucket([2, 2], 3);
  var maximum := selectQuorumBucket([9007199254740991], 9007199254740991);
}

function DigestOccurrences(values: seq<string>, key: string): nat
  decreases |values|
{
  if |values| == 0 then 0 else
    DigestOccurrences(values[..|values|-1], key) + (if values[|values|-1] == key then 1 else 0)
}

lemma DigestOccurrencesAppend(values: seq<string>, value: string, key: string)
  ensures DigestOccurrences(values + [value], key) == DigestOccurrences(values, key) + (if value == key then 1 else 0)
{}

lemma DigestCountsDisjoint(values: seq<string>, first: string, second: string)
  requires first != second
  ensures DigestOccurrences(values, first) + DigestOccurrences(values, second) <= |values|
  decreases |values|
{
  if |values| > 0 {
    DigestCountsDisjoint(values[..|values|-1], first, second);
  }
}

lemma quorumTally_majority(values: seq<string>, first: string, second: string, threshold: int)
  requires first != second
  requires 2 * threshold > |values|
  ensures DigestOccurrences(values, first) < threshold || DigestOccurrences(values, second) < threshold
{
  DigestCountsDisjoint(values, first, second);
}

