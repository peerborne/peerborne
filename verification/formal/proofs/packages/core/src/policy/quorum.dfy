function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function defaultQuorumQ(k: int): int
  requires (-9007199254740991 <= k)
  requires (k <= 9007199254740991)
{
  if (k <= 0) then
    0
  else
    (JSFloorDiv(k, 2) + 1)
}

