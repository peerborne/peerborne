method selectQuorumBucket(counts: seq<int>, threshold: int) returns (res: int)
  requires (1 <= threshold)
  requires (threshold <= 9007199254740991)
  requires (|counts| <= 4294967295)
  requires forall k: int :: ((0 <= k) ==> (k < |counts|) ==> ((0 <= counts[k]) && (counts[k] <= 9007199254740991)))
  ensures (-2 <= res)
  ensures (res < |counts|)
  ensures ((res >= 0) ==> (counts[res] >= threshold))
  ensures ((res >= 0) ==> forall k: int :: ((0 <= k) ==> (k < |counts|) ==> (k != res) ==> (counts[k] < threshold)))
  ensures ((res == -1) <==> forall k: int :: ((0 <= k) ==> (k < |counts|) ==> (counts[k] < threshold)))
  ensures ((res == -2) <==> exists a: int, b: int :: (((((0 <= a) && (a < b)) && (b < |counts|)) && (counts[a] >= threshold)) && (counts[b] >= threshold)))
{
  var winner := -1;
  var index := 0;
  while (index < |counts|)
    invariant (0 <= index)
    invariant (index <= |counts|)
    invariant ((winner == -1) || (((0 <= winner) && (winner < index)) && (counts[winner] >= threshold)))
    invariant ((winner == -1) ==> forall k: int :: ((0 <= k) ==> (k < index) ==> (counts[k] < threshold)))
    invariant ((winner >= 0) ==> forall k: int :: ((0 <= k) ==> (k < index) ==> (k != winner) ==> (counts[k] < threshold)))
    decreases (|counts| - index)
  {
    if (counts[index] >= threshold) {
      if (winner != -1) {
        return -2;
      }
      winner := index;
    }
    index := (index + 1);
  }
  return winner;
}

