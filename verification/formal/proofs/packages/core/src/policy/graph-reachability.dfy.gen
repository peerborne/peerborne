method reachableCids(nodes: seq<string>, edges: seq<CidEdge>, root: string) returns (res: set<string>)
  requires (|nodes| <= 32768)
  requires (|edges| <= 131072)
  requires (root in nodes)
  requires forall i: int :: ((0 <= i) ==> (i < |edges|) ==> ((edges[i].from in nodes) && (edges[i].to in nodes)))
  ensures (root in res)
  ensures forall key :: ((key in res) ==> (key in nodes))
  ensures forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in res) ==> (edges[i].to in res))
{
  var adjacency: map<string, seq<string>> := map[];
  var edgeIndex := 0;
  while (edgeIndex < |edges|)
    invariant (0 <= edgeIndex)
    invariant (edgeIndex <= |edges|)
    invariant forall key :: ((key in adjacency) ==> ((key in nodes) && (|adjacency[key]| <= edgeIndex)))
    invariant forall i: int :: ((0 <= i) ==> (i < edgeIndex) ==> ((edges[i].from in adjacency) && (edges[i].to in adjacency[edges[i].from])))
    decreases (|edges| - edgeIndex)
  {
    var edge := edges[edgeIndex];
    var children := (if (edge.from in adjacency) then (var i_oc0_val := adjacency[edge.from]; i_oc0_val) else []);
    children := (children + [edge.to]);
    adjacency := adjacency[edge.from := children];
    edgeIndex := (edgeIndex + 1);
  }
  var seen: set<string> := {};
  var queue := [root];
  var index := 0;
  var enqueuedEdges := 0;
  while (index < |queue|)
    invariant (0 <= index)
    invariant (index <= |queue|)
    invariant (|seen| <= |nodes|)
    invariant (0 <= enqueuedEdges)
    invariant (enqueuedEdges <= |edges|)
    invariant (|queue| <= (|edges| + 1))
    invariant (root in queue)
    invariant forall j: int :: ((0 <= j) ==> (j < |queue|) ==> (queue[j] in nodes))
    invariant forall key :: ((key in seen) ==> (key in nodes))
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> (queue[j] in seen))
    invariant forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in seen) ==> (edges[i].to in queue))
    decreases (((((|nodes| - |seen|) + |edges|) - enqueuedEdges) + |queue|) - index)
  {
    var node := queue[index];
    index := (index + 1);
    if !((node in seen)) {
      seen := (seen + {node});
      var children := (if (node in adjacency) then (var i_oc1_val := adjacency[node]; i_oc1_val) else []);
      enqueuedEdges := (enqueuedEdges + |children|);
      var child := 0;
      while (child < |children|)
        invariant (0 <= child)
        invariant (child <= |children|)
        invariant forall j: int :: ((0 <= j) ==> (j < child) ==> (children[j] in queue))
        invariant (root in queue)
        invariant (index <= |queue|)
        invariant (|seen| <= |nodes|)
        invariant (0 <= enqueuedEdges)
        invariant (enqueuedEdges <= |edges|)
        invariant (|queue| <= (|edges| + 1))
        invariant forall j: int :: ((0 <= j) ==> (j < |queue|) ==> (queue[j] in nodes))
        invariant forall j: int :: ((0 <= j) ==> (j < index) ==> (queue[j] in seen))
        invariant forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in seen) ==> (edges[i].from != node) ==> (edges[i].to in queue))
        decreases (|children| - child)
      {
        queue := (queue + [children[child]]);
        child := (child + 1);
      }
    }
  }
  return seen;
}
