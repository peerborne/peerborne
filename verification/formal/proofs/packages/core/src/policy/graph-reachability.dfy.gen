datatype CidEdge = CidEdge(from: string, to: string)

function shouldPruneDocumentChildren(isAcl: bool, documentNodesVisited: int, keepCount: int): bool
{
  (!(isAcl) && (documentNodesVisited >= keepCount))
}

lemma shouldPruneDocumentChildren_ensures(isAcl: bool, documentNodesVisited: int, keepCount: int)
