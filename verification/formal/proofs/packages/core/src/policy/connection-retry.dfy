// Generated by lsc from connection-retry.ts
// lsc options: string-semantics=javascript-utf16

function shouldRetryConnection(retryable: bool, aborted: bool, attempt: int, maximum: int): bool
  requires (1 <= attempt)
  requires (attempt <= MAX_CONNECTION_ATTEMPTS)
  requires (1 <= maximum)
  requires (maximum <= MAX_CONNECTION_ATTEMPTS)
{
  ((retryable && !(aborted)) && (attempt < maximum))
}

lemma shouldRetryConnection_ensures(retryable: bool, aborted: bool, attempt: int, maximum: int)
  requires (1 <= attempt)
  requires (attempt <= MAX_CONNECTION_ATTEMPTS)
  requires (1 <= maximum)
  requires (maximum <= MAX_CONNECTION_ATTEMPTS)
  ensures (shouldRetryConnection(retryable, aborted, attempt, maximum) <==> ((retryable && !(aborted)) && (attempt < maximum)))
{
}

const MAX_CONNECTION_ATTEMPTS: int := 3

method connectionRetry_domain()
{
  assert shouldRetryConnection(true, false, 1, 3);
  assert shouldRetryConnection(true, false, 2, 3);
  assert !shouldRetryConnection(true, false, 3, 3);
  assert !shouldRetryConnection(true, false, 1, 1);
  assert !shouldRetryConnection(false, false, 1, 3);
  assert !shouldRetryConnection(true, true, 1, 3);
}
