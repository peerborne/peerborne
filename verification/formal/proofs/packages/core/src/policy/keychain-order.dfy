method isKeychainPrefix(prefix: seq<seq<string>>, entries: seq<seq<string>>) returns (res: bool)
  requires (|prefix| <= 4294967295)
  requires (|entries| <= 4294967295)
  requires forall i: int :: ((0 <= i) ==> (i < |prefix|) ==> (|prefix[i]| == 2))
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> (|entries[i]| == 2))
  ensures (res <==> ((|prefix| <= |entries|) && forall i: int :: ((0 <= i) ==> (i < |prefix|) ==> ((prefix[i][0] == entries[i][0]) && (prefix[i][1] == entries[i][1])))))
{
  if (|prefix| > |entries|) {
    return false;
  }
  var index := 0;
  while (index < |prefix|)
    invariant (0 <= index)
    invariant (index <= |prefix|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((prefix[i][0] == entries[i][0]) && (prefix[i][1] == entries[i][1])))
    decreases (|prefix| - index)
  {
    var i_t0 := sameKeychainEntry(prefix[index], entries[index]);
    if !(i_t0) {
      return false;
    }
    index := (index + 1);
  }
  return true;
}

method firstKeychainRewrite(before: seq<seq<string>>, after: seq<seq<string>>) returns (res: int)
  requires (|before| <= |after|)
  requires (|after| <= 4294967295)
  requires forall i: int :: ((0 <= i) ==> (i < |before|) ==> (|before[i]| == 2))
  requires forall i: int :: ((0 <= i) ==> (i < |after|) ==> (|after[i]| == 2))
  ensures (-1 <= res)
  ensures (res < |before|)
  ensures ((res == -1) <==> forall i: int :: ((0 <= i) ==> (i < |before|) ==> ((before[i][0] == after[i][0]) && (before[i][1] == after[i][1]))))
  ensures ((res >= 0) ==> ((before[res][0] != after[res][0]) || (before[res][1] != after[res][1])))
{
  var index := 0;
  while (index < |before|)
    invariant (0 <= index)
    invariant (index <= |before|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((before[i][0] == after[i][0]) && (before[i][1] == after[i][1])))
    decreases (|before| - index)
  {
    var i_t1 := sameKeychainEntry(before[index], after[index]);
    if !(i_t1) {
      return index;
    }
    index := (index + 1);
  }
  return -1;
}

method keychainPrefix_transitive(a: seq<seq<string>>, b: seq<seq<string>>, c: seq<seq<string>>)
  requires |a| <= 4294967295 && |b| <= 4294967295 && |c| <= 4294967295
  requires forall i :: 0 <= i < |a| ==> |a[i]| == 2
  requires forall i :: 0 <= i < |b| ==> |b[i]| == 2
  requires forall i :: 0 <= i < |c| ==> |c[i]| == 2
{
  var ab := isKeychainPrefix(a, b);
  var bc := isKeychainPrefix(b, c);
  var ac := isKeychainPrefix(a, c);
  assert ab && bc ==> ac;
}
method keychainOrder_domain()
{
  assert sameKeychainEntry(["a", "v"], ["a", "v"]);
  assert !sameKeychainEntry(["a", "v"], ["a", "w"]);
  var prefix := isKeychainPrefix([["a", "v"]], [["a", "v"], ["b", "w"]]);
  var empty := isKeychainPrefix([], []);
  var rewrite := firstKeychainRewrite([["a", "v"]], [["a", "w"]]);
