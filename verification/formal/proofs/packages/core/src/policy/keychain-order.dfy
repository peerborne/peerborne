function keychainHistoryTailClock(clock: int, length: int): int
  requires (0 <= clock)
  requires (clock <= 9007199254740991)
  requires (1 <= length)
  requires (length <= 1000)
{
  var offset := (length - 1);
  if (offset > (9007199254740991 - clock)) then
    -1
  else
    (clock + offset)
}

