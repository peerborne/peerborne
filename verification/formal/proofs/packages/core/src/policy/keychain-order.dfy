lemma keychainHistory_removeCardinality(values: map<string, int>, key: string)
  requires key in values
  ensures |map k | k in values && k != key :: values[k]| + 1 == |values|
{
  var retained := map k | k in values && k != key :: values[k];
  assert retained.Keys == values.Keys - {key};
  assert values.Keys == retained.Keys + {key};
  assert key !in retained;
}

predicate KeychainHistoryMetadata(ids: seq<string>, parents: seq<string>)
{
  |ids| == |parents| &&
  (forall i :: 0 <= i < |ids| ==> ids[i] != "") &&
  (forall i, j :: 0 <= i < |ids| && 0 <= j < |ids| && ids[i] == ids[j] ==> i == j) &&
  (forall i, j :: 0 <= i < |ids| && 0 <= j < |ids| && parents[i] == parents[j] ==> i == j)
}

predicate KeychainHistoryPrefix(ids: seq<string>, parents: seq<string>, order: seq<int>)
  requires |ids| == |parents|
{
  (forall i :: 0 <= i < |order| ==> 0 <= order[i] < |ids|) &&
  (forall i, j :: 0 <= i < |order| && 0 <= j < |order| && order[i] == order[j] ==> i == j) &&
  (|order| > 0 ==> parents[order[0]] == "") &&
  (forall i :: 1 <= i < |order| ==> parents[order[i]] == ids[order[i-1]])
}

predicate CompleteKeychainHistory(ids: seq<string>, parents: seq<string>, order: seq<int>)
{
  KeychainHistoryMetadata(ids, parents) &&
  |order| == |ids| && KeychainHistoryPrefix(ids, parents, order)
}

lemma keychainHistory_uniquePrefix(ids: seq<string>, parents: seq<string>, left: seq<int>, right: seq<int>)
  requires KeychainHistoryMetadata(ids, parents)
  requires KeychainHistoryPrefix(ids, parents, left)
  requires KeychainHistoryPrefix(ids, parents, right)
  ensures forall i :: 0 <= i < |left| && i < |right| ==> left[i] == right[i]
{
  var index := 0;
  while index < |left| && index < |right|
    invariant 0 <= index <= |left| && index <= |right|
    invariant forall i :: 0 <= i < index ==> left[i] == right[i]
    decreases |left| - index
  {
    if index == 0 {
      assert parents[left[index]] == "" && parents[right[index]] == "";
    } else {
      assert left[index-1] == right[index-1];
      assert parents[left[index]] == ids[left[index-1]];
      assert parents[right[index]] == ids[right[index-1]];
    }
    assert parents[left[index]] == parents[right[index]];
    assert left[index] == right[index];
    index := index + 1;
  }
}

lemma keychainHistory_certificateComplete(ids: seq<string>, parents: seq<string>, prefix: seq<int>, complete: seq<int>)
  requires CompleteKeychainHistory(ids, parents, complete)
  requires KeychainHistoryPrefix(ids, parents, prefix)
  requires |prefix| <= |ids|
  requires forall i :: 0 <= i < |ids| ==> parents[i] != (if |prefix| == 0 then "" else ids[prefix[|prefix|-1]])
  ensures |prefix| == |ids|
{
  keychainHistory_uniquePrefix(ids, parents, prefix, complete);
  if |prefix| < |ids| {
    assert parents[complete[|prefix|]] == (if |prefix| == 0 then "" else ids[prefix[|prefix|-1]]);
    assert false;
  }
}

method keychainHistory_exact(ids: seq<string>, parents: seq<string>) returns (plan: KeychainHistoryPlan)
  requires |ids| == |parents| && |ids| <= 1000
  ensures plan.valid <==> exists complete: seq<int> :: CompleteKeychainHistory(ids, parents, complete)
  ensures forall complete: seq<int> :: CompleteKeychainHistory(ids, parents, complete) ==> plan.valid
  ensures plan.valid ==> CompleteKeychainHistory(ids, parents, plan.order)
{
  plan := orderKeychainHistory(ids, parents);
  if plan.valid {
    assert CompleteKeychainHistory(ids, parents, plan.order);
  } else if exists complete: seq<int> :: CompleteKeychainHistory(ids, parents, complete) {
    ghost var complete :| CompleteKeychainHistory(ids, parents, complete);
    keychainHistory_certificateComplete(ids, parents, plan.order, complete);
    assert false;
  }
}

method keychainHistory_domain()
{
  var empty := orderKeychainHistory([], []);
  assert empty.valid && empty.probes == 1;
  assert CompleteKeychainHistory(["c", "a", "b"], ["b", "", "a"], [1, 2, 0]);
  var shuffled := keychainHistory_exact(["c", "a", "b"], ["b", "", "a"]);
  assert shuffled.valid;
  var roots := orderKeychainHistory(["a", "b"], ["", ""]);
  assert !roots.valid;
  var forkIds := ["a", "b", "c"];
  var forkParents := ["", "a", "a"];
  var fork := orderKeychainHistory(forkIds, forkParents);
  if fork.probes > 0 {
    assert forkParents[1] == forkParents[2];
    assert 1 == 2;
  }
  assert !fork.valid;
  var orphan := orderKeychainHistory(["a", "b"], ["", "missing"]);
  assert !orphan.valid;
  var cycle := orderKeychainHistory(["a", "b"], ["b", "a"]);
  assert !cycle.valid;
  var duplicate := orderKeychainHistory(["a", "a"], ["", "a"]);
  assert !duplicate.valid;
  var sentinel := orderKeychainHistory([""], [""]);
  assert !sentinel.valid;
  assert keychainHistoryTailClock(9007199254740991, 1) == 9007199254740991;
  assert keychainHistoryTailClock(9007199254740991, 2) == -1;
  assert keychainHistoryTailClock(9007199254739992, 1000) == 9007199254740991;
}
