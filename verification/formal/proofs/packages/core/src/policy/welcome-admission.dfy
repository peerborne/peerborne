  ensures res.retainedBytes <= WelcomeTotal(entries)
{
  var kept: seq<PendingWelcomeMetadata> := [];
  var expiredKeys: seq<string> := [];
  var retainedBytes := 0;
  var index := 0;
  assert WelcomeShape(entries);
  while (index < |entries|)
    invariant (0 <= index)
    invariant (index <= |entries|)
    invariant ((|kept| + |expiredKeys|) == index)
    invariant (0 <= retainedBytes)
    invariant (retainedBytes <= (|kept| * 10485760))
    invariant forall i: int :: ((0 <= i) ==> (i < |kept|) ==> exists j: int :: (((0 <= j) && (j < index)) && (entries[j] == kept[i])))
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((entries[i] in kept) <==> !(isPendingWelcomeExpired(bufferedAtMs[i], now, ttl))))
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((entries[i].key in expiredKeys) <==> isPendingWelcomeExpired(bufferedAtMs[i], now, ttl)))
    invariant forall key :: ((key in expiredKeys) ==> exists j: int :: ((((0 <= j) && (j < index)) && (entries[j].key == key)) && isPendingWelcomeExpired(bufferedAtMs[j], now, ttl)))
    invariant forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |kept|) ==> (kept[i].key != kept[j].key))
    invariant WelcomeShape(kept)
    invariant retainedBytes == WelcomeTotal(kept)
    invariant retainedBytes <= WelcomeTotal(entries[..index])
    decreases (|entries| - index)
  {
    welcomeShape_slice(entries, 0, index);
    welcomeFreshKey(entries, index);
    welcomePrefix_append(entries, index);
    welcomeMeasures_concat(kept, [entries[index]]);
    welcomeMeasures_concat(entries[..index], [entries[index]]);
    ghost var previousExpired := expiredKeys;
    var entry := entries[index];
    var i_t6 := isPendingWelcomeExpired(bufferedAtMs[index], now, ttl);
    if i_t6 {
      expiredKeys := (expiredKeys + [entry.key]);
      assert isPendingWelcomeExpired(bufferedAtMs[index], now, ttl);
    } else {
      assert !isPendingWelcomeExpired(bufferedAtMs[index], now, ttl);
      assert forall prior :: prior in kept ==> prior.key != entry.key;
      welcomeShape_append(kept, entry);
      kept := (kept + [entry]);
      retainedBytes := (retainedBytes + entry.bytes);
    }
    forall key | key in expiredKeys
      ensures exists prior :: 0 <= prior < index + 1 && entries[prior].key == key && isPendingWelcomeExpired(bufferedAtMs[prior], now, ttl)
    {
      if key in previousExpired {
        var prior :| 0 <= prior < index && entries[prior].key == key && isPendingWelcomeExpired(bufferedAtMs[prior], now, ttl);
        assert prior < index + 1;
      } else {
        assert key == entry.key;
        assert isPendingWelcomeExpired(bufferedAtMs[index], now, ttl);
      }
    }
    assert retainedBytes == WelcomeTotal(kept);
    assert retainedBytes <= WelcomeTotal(entries[..index+1]);
    index := (index + 1);
  }
  assert index == |entries| && entries[..index] == entries;
  ghost var expected := PendingWelcomeExpiry(kept, expiredKeys, retainedBytes);
  assert expected.expiredKeys == expiredKeys;
  forall key | key in expected.expiredKeys
    ensures exists prior :: 0 <= prior < |entries| && entries[prior].key == key && isPendingWelcomeExpired(bufferedAtMs[prior], now, ttl)
  {
    assert key in expiredKeys;
    var prior :| 0 <= prior < index && entries[prior].key == key && isPendingWelcomeExpired(bufferedAtMs[prior], now, ttl);
    assert 0 <= prior < |entries|;
  }
  return PendingWelcomeExpiry(kept, expiredKeys, retainedBytes);
}

function WelcomeTotal(entries: seq<PendingWelcomeMetadata>): int
  decreases |entries|
{
  if |entries| == 0 then 0 else WelcomeTotal(entries[..|entries|-1]) + entries[|entries|-1].bytes
}

function WelcomeProtectedBytes(entries: seq<PendingWelcomeMetadata>): int
  decreases |entries|
{
  if |entries| == 0 then 0 else WelcomeProtectedBytes(entries[..|entries|-1]) + (if entries[|entries|-1].authenticated then entries[|entries|-1].bytes else 0)
}

function WelcomeProtectedCount(entries: seq<PendingWelcomeMetadata>): int
  decreases |entries|
{
  if |entries| == 0 then 0 else WelcomeProtectedCount(entries[..|entries|-1]) + (if entries[|entries|-1].authenticated then 1 else 0)
}

function WelcomePreviousBytes(entries: seq<PendingWelcomeMetadata>, key: string): int
  decreases |entries|
{
  if |entries| == 0 then 0 else if entries[|entries|-1].key == key then entries[|entries|-1].bytes else WelcomePreviousBytes(entries[..|entries|-1], key)
}

function WelcomeKeyAuthenticated(entries: seq<PendingWelcomeMetadata>, key: string): bool
  decreases |entries|
{
  |entries| > 0 && (if entries[|entries|-1].key == key then entries[|entries|-1].authenticated else WelcomeKeyAuthenticated(entries[..|entries|-1], key))
}

function WelcomeWithout(entries: seq<PendingWelcomeMetadata>, key: string): seq<PendingWelcomeMetadata>
  decreases |entries|
{
  if |entries| == 0 then [] else WelcomeWithout(entries[..|entries|-1], key) + (if entries[|entries|-1].key == key then [] else [entries[|entries|-1]])
}

predicate WelcomeShape(entries: seq<PendingWelcomeMetadata>)
{
  |entries| <= 16 &&
  (forall i :: 0 <= i < |entries| ==> 1 <= entries[i].bytes <= 10485760) &&
  (forall i, j :: 0 <= i < j < |entries| ==> entries[i].key != entries[j].key)
}

lemma welcomeShape_slice(entries: seq<PendingWelcomeMetadata>, lo: int, hi: int)
  requires WelcomeShape(entries) && 0 <= lo <= hi <= |entries|
  ensures WelcomeShape(entries[lo..hi])
{
}

@IsolateAssertions
lemma welcomeMeasure_bounds(entries: seq<PendingWelcomeMetadata>)
  requires forall i :: 0 <= i < |entries| ==> 1 <= entries[i].bytes <= 10485760
  ensures |entries| <= WelcomeTotal(entries) <= |entries| * 10485760
  ensures 0 <= WelcomeProtectedBytes(entries) <= WelcomeTotal(entries)
  ensures 0 <= WelcomeProtectedCount(entries) <= |entries|
  ensures forall entry :: entry in entries ==> entry.bytes <= WelcomeTotal(entries)
  decreases |entries|
{
  if |entries| > 0 {
    var prefix := entries[..|entries|-1];
    welcomeMeasure_bounds(prefix);
    assert entries == prefix + [entries[|entries|-1]];
    forall entry | entry in entries
      ensures entry.bytes <= WelcomeTotal(entries)
    {
      if entry != entries[|entries|-1] {
        assert entry in prefix;
      }
    }
  }
}

lemma welcomeMeasures_concat(left: seq<PendingWelcomeMetadata>, right: seq<PendingWelcomeMetadata>)
  ensures WelcomeTotal(left + right) == WelcomeTotal(left) + WelcomeTotal(right)
  ensures WelcomeProtectedBytes(left + right) == WelcomeProtectedBytes(left) + WelcomeProtectedBytes(right)
  ensures WelcomeProtectedCount(left + right) == WelcomeProtectedCount(left) + WelcomeProtectedCount(right)
  decreases |right|
{
  if |right| > 0 {
    welcomeMeasures_concat(left, right[..|right|-1]);
    assert (left + right)[..|left + right|-1] == left + right[..|right|-1];
    assert (left + right)[|left + right|-1] == right[|right|-1];
  } else {
    assert right == [] && left + right == left;
    assert WelcomeTotal(right) == 0;
    assert WelcomeProtectedBytes(right) == 0;
    assert WelcomeProtectedCount(right) == 0;
  }
}

lemma welcomeWithout_concat(left: seq<PendingWelcomeMetadata>, right: seq<PendingWelcomeMetadata>, key: string)
  ensures WelcomeWithout(left + right, key) == WelcomeWithout(left, key) + WelcomeWithout(right, key)
  decreases |right|
{
  if |right| > 0 {
    welcomeWithout_concat(left, right[..|right|-1], key);
    assert (left + right)[..|left + right|-1] == left + right[..|right|-1];
    assert (left + right)[|left + right|-1] == right[|right|-1];
  } else {
    assert right == [] && left + right == left;
    assert WelcomeWithout(right, key) == [];
  }
}

@IsolateAssertions
lemma welcomeWithout_facts(entries: seq<PendingWelcomeMetadata>, key: string)
  requires WelcomeShape(entries)
  ensures WelcomeShape(WelcomeWithout(entries, key))
  ensures forall entry :: entry in WelcomeWithout(entries, key) <==> entry in entries && entry.key != key
  ensures 0 <= WelcomePreviousBytes(entries, key) <= 10485760
  ensures WelcomePreviousBytes(entries, key) == 0 <==> (forall entry :: entry in entries ==> entry.key != key)
  ensures WelcomePreviousBytes(entries, key) > 0 ==> exists entry :: entry in entries && entry.key == key && entry.bytes == WelcomePreviousBytes(entries, key)
  ensures |WelcomeWithout(entries, key)| == |entries| - (if WelcomePreviousBytes(entries, key) > 0 then 1 else 0)
  ensures WelcomeTotal(WelcomeWithout(entries, key)) == WelcomeTotal(entries) - WelcomePreviousBytes(entries, key)
  ensures WelcomeProtectedBytes(WelcomeWithout(entries, key)) == WelcomeProtectedBytes(entries) - (if WelcomeKeyAuthenticated(entries, key) then WelcomePreviousBytes(entries, key) else 0)
  ensures WelcomeProtectedCount(WelcomeWithout(entries, key)) == WelcomeProtectedCount(entries) - (if WelcomeKeyAuthenticated(entries, key) then 1 else 0)
  ensures WelcomePreviousBytes(entries, key) == 0 ==> !WelcomeKeyAuthenticated(entries, key)
  ensures WelcomePreviousBytes(entries, key) == 0 ==> WelcomeWithout(entries, key) == entries
  decreases |entries|
{
  if |entries| > 0 {
    var prefix := entries[..|entries|-1];
    var last := entries[|entries|-1];
    assert entries == prefix + [last];
    welcomeShape_slice(entries, 0, |entries|-1);
    welcomeWithout_facts(prefix, key);
    if last.key == key {
      assert forall entry :: entry in prefix ==> entry.key != key;
      assert WelcomePreviousBytes(prefix, key) == 0;
    }
    welcomeMeasures_concat(WelcomeWithout(prefix, key), if last.key == key then [] else [last]);
  }
}

@IsolateAssertions
lemma welcomeWithout_prefix(entries: seq<PendingWelcomeMetadata>, key: string, index: int)
  requires WelcomeShape(entries) && 0 <= index <= |entries|
  ensures |WelcomeWithout(entries[..index], key)| <= |WelcomeWithout(entries, key)|
  ensures WelcomeTotal(WelcomeWithout(entries[..index], key)) <= WelcomeTotal(WelcomeWithout(entries, key))
  ensures index < |entries| && entries[index].key != key ==> |WelcomeWithout(entries[..index], key)| < |WelcomeWithout(entries, key)| && WelcomeTotal(WelcomeWithout(entries, key)) - WelcomeTotal(WelcomeWithout(entries[..index], key)) >= entries[index].bytes
{
  welcomeShape_slice(entries, 0, index);
  welcomeShape_slice(entries, index, |entries|);
  welcomeWithout_facts(entries[index..], key);
  welcomeWithout_concat(entries[..index], entries[index..], key);
  welcomeMeasures_concat(WelcomeWithout(entries[..index], key), WelcomeWithout(entries[index..], key));
  welcomeMeasure_bounds(WelcomeWithout(entries[index..], key));
  assert entries == entries[..index] + entries[index..];
  if index < |entries| && entries[index].key != key {
    assert entries[index] in WelcomeWithout(entries[index..], key);
    assert |WelcomeWithout(entries[index..], key)| > 0;
  }
}

lemma welcomeAllTrusted(entries: seq<PendingWelcomeMetadata>)
  requires forall entry :: entry in entries ==> entry.authenticated
  ensures WelcomeProtectedBytes(entries) == WelcomeTotal(entries)
  ensures WelcomeProtectedCount(entries) == |entries|
  decreases |entries|
{
  if |entries| > 0 {
    welcomeAllTrusted(entries[..|entries|-1]);
  }
}

@IsolateAssertions
lemma welcomeFreshKey(entries: seq<PendingWelcomeMetadata>, index: int)
  requires WelcomeShape(entries) && 0 <= index < |entries|
  ensures forall entry :: entry in entries[..index] ==> entry.key != entries[index].key
{
  forall entry | entry in entries[..index]
    ensures entry.key != entries[index].key
  {
    var prior :| 0 <= prior < index && entries[prior] == entry;
  }
}

lemma welcomePrefix_append(entries: seq<PendingWelcomeMetadata>, index: int)
  requires 0 <= index < |entries|
  ensures entries[..index+1] == entries[..index] + [entries[index]]
{
}

lemma welcomeWithout_append(entries: seq<PendingWelcomeMetadata>, entry: PendingWelcomeMetadata, key: string)
  ensures WelcomeWithout(entries + [entry], key) == (if entry.key == key then WelcomeWithout(entries, key) else WelcomeWithout(entries, key) + [entry])
{
  assert (entries + [entry])[..|entries|] == entries;
  assert (entries + [entry])[|entries|] == entry;
}

@IsolateAssertions
lemma welcomeShape_append(entries: seq<PendingWelcomeMetadata>, entry: PendingWelcomeMetadata)
  requires WelcomeShape(entries) && |entries| < 16
  requires 1 <= entry.bytes <= 10485760
  requires forall prior :: prior in entries ==> prior.key != entry.key
  ensures WelcomeShape(entries + [entry])
{
}

lemma welcomeKey_prefix(entries: seq<PendingWelcomeMetadata>, key: string, index: int)
  requires 0 <= index < |entries|
  ensures (exists i :: 0 <= i < index+1 && entries[i].key == key) <==> (exists i :: 0 <= i < index && entries[i].key == key) || entries[index].key == key
{
}

datatype WelcomeLedger<Value> = WelcomeLedger(entries: seq<PendingWelcomeMetadata>, values: map<string, Value>, retainedBytes: int)
datatype WelcomeAction<Value> = WelcomeAction(store: bool, key: string, bytes: int, authenticated: bool, prepared: bool, value: Value)

predicate WelcomeState<Value>(ledger: WelcomeLedger<Value>, maximumEntries: int, maximumBytes: int)
{
  1 <= maximumEntries <= 16 && 1 <= maximumBytes <= 20971520 &&
  WelcomeShape(ledger.entries) && |ledger.entries| <= maximumEntries &&
  ledger.retainedBytes == WelcomeTotal(ledger.entries) && 0 <= ledger.retainedBytes <= maximumBytes &&
  |ledger.values| == |ledger.entries| &&
  (forall entry :: entry in ledger.entries ==> entry.key in ledger.values) &&
  (forall key :: key in ledger.values ==> exists entry :: entry in ledger.entries && entry.key == key)
}

predicate WelcomeActionValid<Value>(action: WelcomeAction<Value>, maximumBytes: int)
{
  action.store ==> 1 <= action.bytes <= 10485760 && action.bytes <= maximumBytes
}

predicate WelcomePreserves<Value>(action: WelcomeAction<Value>, key: string)
{
  !action.prepared || (action.store && !action.authenticated) || (!action.store && action.key != key)
}

predicate WelcomeTrustedOrigin<Value(==)>(initial: WelcomeLedger<Value>, actions: seq<WelcomeAction<Value>>, entry: PendingWelcomeMetadata, value: Value)
{
  (entry in initial.entries && entry.authenticated && entry.key in initial.values && initial.values[entry.key] == value) ||
  (exists i :: 0 <= i < |actions| && actions[i].store && actions[i].prepared && actions[i].authenticated && actions[i].key == entry.key && actions[i].bytes == entry.bytes && actions[i].value == value)
}

@IsolateAssertions
method welcomeState_step<Value(==)>(ledger: WelcomeLedger<Value>, action: WelcomeAction<Value>, maximumEntries: int, maximumBytes: int)
  returns (result: WelcomeLedger<Value>, stored: bool)
  requires WelcomeState(ledger, maximumEntries, maximumBytes) && WelcomeActionValid(action, maximumBytes)
  ensures WelcomeState(result, maximumEntries, maximumBytes)
  ensures !action.prepared ==> result == ledger && !stored
  ensures stored <==> action.store && action.prepared && (WelcomePreviousBytes(ledger.entries, action.key) == 0 || action.authenticated) && (action.authenticated || (WelcomeProtectedCount(ledger.entries) < maximumEntries && WelcomeProtectedBytes(ledger.entries) <= maximumBytes - action.bytes))
  ensures stored ==> action.key in result.values && result.values[action.key] == action.value && PendingWelcomeMetadata(action.key, action.bytes, action.authenticated) in result.entries
  ensures action.store && !stored ==> result == ledger
  ensures action.prepared && !action.store ==> (forall key :: key in result.values <==> key in ledger.values && key != action.key)
  ensures action.prepared && !action.store ==> (forall key :: key in result.values ==> result.values[key] == ledger.values[key])
  ensures forall entry :: entry in ledger.entries && entry.authenticated && WelcomePreserves(action, entry.key) ==> entry in result.entries && entry.key in result.values && result.values[entry.key] == ledger.values[entry.key]
  ensures forall entry :: entry in result.entries && entry.authenticated ==> WelcomeTrustedOrigin(ledger, [action], entry, result.values[entry.key])
  ensures forall entry :: entry in result.entries ==> entry in ledger.entries || (stored && entry.key == action.key)
  ensures forall key :: key in result.values && (!stored || key != action.key) ==> key in ledger.values && result.values[key] == ledger.values[key]

{
  result, stored := ledger, false;
  if action.prepared {
    if action.store {
      var plan := planPendingWelcomeAdmission(ledger.entries, action.key, action.bytes, action.authenticated, maximumEntries, maximumBytes);
      if plan.admitted {
        var retained := retainPendingWelcomeValues(ledger.values, plan.kept);
        var installed := insertPendingWelcomeValue(retained, action.key, action.value);
        var candidate := PendingWelcomeMetadata(action.key, action.bytes, action.authenticated);
        welcomeShape_append(plan.kept, candidate);
        welcomeMeasures_concat(plan.kept, [candidate]);
        result := WelcomeLedger(plan.kept + [candidate], installed, plan.retainedBytes);
        stored := true;
        assert result.retainedBytes == WelcomeTotal(result.entries);
        assert |result.entries| <= maximumEntries && |result.values| == |result.entries|;
        forall entry | entry in result.entries
          ensures entry.key in result.values
        {
          if entry != candidate {
            assert entry in plan.kept;
          }
        }
        forall key | key in result.values
          ensures exists entry :: entry in result.entries && entry.key == key
        {
          if key == action.key {
            assert candidate in result.entries;
          } else {
            assert key in retained;
            var index :| 0 <= index < |plan.kept| && plan.kept[index].key == key;
            assert plan.kept[index] in result.entries;
          }
        }
        assert WelcomeState(result, maximumEntries, maximumBytes);
        forall entry | entry in result.entries && entry.authenticated
          ensures WelcomeTrustedOrigin(ledger, [action], entry, result.values[entry.key])
        {
          if entry.key == action.key {
            assert entry == candidate && action.authenticated;
            assert [action][0] == action;
          } else {
            assert entry in plan.kept && entry in ledger.entries;
            assert result.values[entry.key] == ledger.values[entry.key];
          }
        }
      }
    } else {
      var plan := planPendingWelcomeRemoval(ledger.entries, action.key);
      var retained := retainPendingWelcomeValues(ledger.values, plan.kept);
      result := WelcomeLedger(plan.kept, retained, plan.retainedBytes);
      assert WelcomeState(result, maximumEntries, maximumBytes);
      forall entry | entry in result.entries && entry.authenticated
        ensures WelcomeTrustedOrigin(ledger, [action], entry, result.values[entry.key])
      {
        assert entry in ledger.entries && result.values[entry.key] == ledger.values[entry.key];
      }
    }
  }
}

@IsolateAssertions
method welcomeState_all_histories<Value(==)>(ledger: WelcomeLedger<Value>, actions: seq<WelcomeAction<Value>>, maximumEntries: int, maximumBytes: int)
  returns (result: WelcomeLedger<Value>)
  requires WelcomeState(ledger, maximumEntries, maximumBytes)
  requires forall i :: 0 <= i < |actions| ==> WelcomeActionValid(actions[i], maximumBytes)
  ensures WelcomeState(result, maximumEntries, maximumBytes)
  ensures forall entry :: entry in ledger.entries && entry.authenticated && (forall i :: 0 <= i < |actions| ==> WelcomePreserves(actions[i], entry.key)) ==> entry in result.entries && entry.key in result.values && result.values[entry.key] == ledger.values[entry.key]
  ensures forall entry :: entry in result.entries && entry.authenticated ==> WelcomeTrustedOrigin(ledger, actions, entry, result.values[entry.key])
  decreases |actions|
{
  if |actions| == 0 {
    result := ledger;
  } else {
    var next, stored := welcomeState_step(ledger, actions[0], maximumEntries, maximumBytes);
    result := welcomeState_all_histories(next, actions[1..], maximumEntries, maximumBytes);
  }
}

@IsolateAssertions
method welcomeProtected_all_histories<Value(==)>(ledger: WelcomeLedger<Value>, actions: seq<WelcomeAction<Value>>, maximumEntries: int, maximumBytes: int)
  returns (result: WelcomeLedger<Value>)
  requires WelcomeState(ledger, maximumEntries, maximumBytes)
  requires forall i :: 0 <= i < |actions| ==> WelcomeActionValid(actions[i], maximumBytes) && (!actions[i].prepared || (actions[i].store && !actions[i].authenticated))
  ensures WelcomeState(result, maximumEntries, maximumBytes)
  ensures forall entry :: entry in ledger.entries && entry.authenticated ==> entry in result.entries && entry.key in result.values && result.values[entry.key] == ledger.values[entry.key]
  ensures forall entry :: entry in result.entries && entry.authenticated ==> entry in ledger.entries && entry.key in ledger.values && result.values[entry.key] == ledger.values[entry.key]
{
  result := welcomeState_all_histories(ledger, actions, maximumEntries, maximumBytes);
}

lemma welcomeHeader_monotone(existing: bool, protectedCount: int, protectedBytes: int, actualBytes: int, maximumEntries: int, maximumBytes: int)
  requires 0 <= protectedCount <= 16 && 0 <= protectedBytes <= 167772160
  requires 1 <= maximumEntries <= 16 && 1 <= actualBytes <= 10485760 && actualBytes <= maximumBytes <= 20971520
  ensures canAdmitPendingWelcome(existing, false, protectedCount, protectedBytes, actualBytes, maximumEntries, maximumBytes) ==> canAdmitPendingWelcome(existing, false, protectedCount, protectedBytes, 1, maximumEntries, maximumBytes)
{
}

@IsolateAssertions
method welcomeAdmission_domain()
{
  welcomeTimed_domain();
  welcomeFresh_domain();
  welcomeRetention_domain();
  welcomeProtected_domain();
  welcomeRemoval_domain();
  welcomeHeader_monotone(false, 1, 2, 2, 2, 4);
  assert canAdmitPendingWelcome(false, false, 1, 2, 2, 2, 4);
  assert !canAdmitPendingWelcome(false, false, 16, 16, 1, 16, 20971520);
  assert !canAdmitPendingWelcome(false, false, 2, 20971520, 1, 16, 20971520);
}

@IsolateAssertions
method welcomeFresh_domain()
{
  var initial: WelcomeLedger<int> := WelcomeLedger([], map[], 0);
  assert WelcomeState(initial, 2, 4);
  var first, firstStored := welcomeState_step(initial, WelcomeAction(true, "unverified", 1, false, true, 10), 2, 4);
  assert firstStored && first.values["unverified"] == 10;
  var trusted, trustedStored := welcomeState_step(first, WelcomeAction(true, "trusted", 2, true, true, 20), 2, 4);
  assert trustedStored && trusted.values["trusted"] == 20;
}

@IsolateAssertions
method welcomeRetention_domain()
{
  var entries := [PendingWelcomeMetadata("unverified", 1, false), PendingWelcomeMetadata("trusted", 2, true)];
  var initial := WelcomeLedger(entries, map["unverified" := 10, "trusted" := 20], 3);
  assert WelcomeState(initial, 2, 4);
  var result, stored := welcomeState_step(initial, WelcomeAction(true, "fresh", 1, false, true, 30), 2, 4);
  assert stored && result.values["trusted"] == 20 && result.values["fresh"] == 30;
  var rejected, rejectedStored := welcomeState_step(initial, WelcomeAction(true, "too-big", 4, false, true, 40), 2, 4);
  assert !rejectedStored && rejected == initial;
  var failed, failedStored := welcomeState_step(initial, WelcomeAction(true, "trusted", 4, true, false, 50), 2, 4);
  assert !failedStored && failed == initial;
}

@IsolateAssertions
method welcomeProtected_domain()
{
  var initial := WelcomeLedger([PendingWelcomeMetadata("trusted", 2, true)], map["trusted" := 20], 2);
  assert WelcomeState(initial, 2, 4);
  var actions := [WelcomeAction(true, "fresh", 1, false, true, 60), WelcomeAction(true, "trusted", 1, false, true, 70), WelcomeAction(true, "other", 4, true, false, 80)];
  var result := welcomeProtected_all_histories(initial, actions, 2, 4);
  assert result.values["trusted"] == 20;
}

@IsolateAssertions
method welcomeRemoval_domain()
{
  var initial := WelcomeLedger([PendingWelcomeMetadata("trusted", 2, true), PendingWelcomeMetadata("fresh", 1, false)], map["trusted" := 20, "fresh" := 30], 3);
  assert WelcomeState(initial, 2, 4);
  var removed, removedStored := welcomeState_step(initial, WelcomeAction(false, "trusted", 0, false, true, 0), 2, 4);
  assert !removedStored && "trusted" !in removed.values && removed.values["fresh"] == 30;
}

datatype WelcomeTimedLedger<Value> = WelcomeTimedLedger(base: WelcomeLedger<Value>, times: map<string, int>, clock: int)
datatype WelcomeTimedAction<Value> = WelcomeTimedAction(expire: bool, now: int, change: WelcomeAction<Value>)

predicate WelcomeTimedState<Value>(ledger: WelcomeTimedLedger<Value>, maximumEntries: int, maximumBytes: int)
{
  WelcomeState(ledger.base, maximumEntries, maximumBytes) &&
  0 <= ledger.clock <= 9007199254740991 &&
  ledger.times.Keys == ledger.base.values.Keys &&
  (forall key :: key in ledger.times ==> 0 <= ledger.times[key] <= ledger.clock)
}

predicate WelcomeTimedActionValid<Value>(action: WelcomeTimedAction<Value>, maximumBytes: int)
{
  0 <= action.now <= 9007199254740991 &&
  (action.expire || WelcomeActionValid(action.change, maximumBytes))
}

function WelcomeTimes(entries: seq<PendingWelcomeMetadata>, times: map<string, int>): seq<int>
  requires forall entry :: entry in entries ==> entry.key in times
  ensures |WelcomeTimes(entries, times)| == |entries|
  ensures forall index :: 0 <= index < |entries| ==> WelcomeTimes(entries, times)[index] == times[entries[index].key]
{
  seq(|entries|, index requires 0 <= index < |entries| => times[entries[index].key])
}

@IsolateAssertions
method welcomeTimed_step<Value(==)>(ledger: WelcomeTimedLedger<Value>, action: WelcomeTimedAction<Value>, maximumEntries: int, maximumBytes: int)
  returns (result: WelcomeTimedLedger<Value>, stored: bool)
  requires WelcomeTimedState(ledger, maximumEntries, maximumBytes)
  requires WelcomeTimedActionValid(action, maximumBytes)
  ensures WelcomeTimedState(result, maximumEntries, maximumBytes)
  ensures ledger.clock <= result.clock
  ensures result.clock == ledger.clock || (action.change.prepared && (action.expire || action.change.store) && result.clock == action.now)
  ensures !action.change.prepared ==> result == ledger && !stored
  ensures !action.expire && action.change.store && !stored ==> result == ledger
  ensures action.expire ==> !stored
  ensures stored <==> !action.expire && action.change.prepared && action.change.store && (WelcomePreviousBytes(ledger.base.entries, action.change.key) == 0 || action.change.authenticated) && (action.change.authenticated || (WelcomeProtectedCount(ledger.base.entries) < maximumEntries && WelcomeProtectedBytes(ledger.base.entries) <= maximumBytes - action.change.bytes))
  ensures stored ==> action.change.key in result.times && result.times[action.change.key] == result.clock && action.now <= result.clock
  ensures action.expire && action.change.prepared ==> action.now <= result.clock
  ensures action.expire && action.change.prepared ==> (forall key :: key in result.times <==> key in ledger.times && result.clock - ledger.times[key] <= 300000)
  ensures forall key :: key in result.times && (!stored || key != action.change.key) ==> key in ledger.times && result.times[key] == ledger.times[key] && result.base.values[key] == ledger.base.values[key]
  ensures forall entry :: entry in result.base.entries ==> entry in ledger.base.entries || (stored && entry.key == action.change.key)
{
  result, stored := ledger, false;
  if action.change.prepared {
    if action.expire {
      var observed := advancePendingWelcomeClock(ledger.clock, action.now);
      var times := WelcomeTimes(ledger.base.entries, ledger.times);
      var plan := planPendingWelcomeExpiry(ledger.base.entries, times, observed, 300000);
      var retained := retainPendingWelcomeValues(ledger.base.values, plan.kept);
      var ages := retainPendingWelcomeValues(ledger.times, plan.kept);
      var base := WelcomeLedger(plan.kept, retained, plan.retainedBytes);
      result := WelcomeTimedLedger(base, ages, observed);
      forall key | key in ages
        ensures key in ledger.times && ages[key] == ledger.times[key] && retained[key] == ledger.base.values[key]
      {
      }
      forall key
        ensures key in ages <==> key in ledger.times && observed - ledger.times[key] <= 300000
      {
        if key in ages {
          var index :| 0 <= index < |plan.kept| && plan.kept[index].key == key;
          var source :| 0 <= source < |ledger.base.entries| && ledger.base.entries[source] == plan.kept[index];
          assert ledger.base.entries[source] in plan.kept;
        } else if key in ledger.times && observed - ledger.times[key] <= 300000 {
          var source :| 0 <= source < |ledger.base.entries| && ledger.base.entries[source].key == key;
          assert !isPendingWelcomeExpired(times[source], observed, 300000);
          assert ledger.base.entries[source] in plan.kept;
        }
      }
      assert ages.Keys == retained.Keys;
      assert WelcomeState(base, maximumEntries, maximumBytes);
      assert WelcomeTimedState(result, maximumEntries, maximumBytes);
    } else {
      var base, accepted := welcomeState_step(ledger.base, action.change, maximumEntries, maximumBytes);
      stored := accepted;
      if stored {
        var observed := advancePendingWelcomeClock(ledger.clock, action.now);
        var without := planPendingWelcomeRemoval(base.entries, action.change.key);
        assert forall entry :: entry in without.kept ==> entry in ledger.base.entries && entry.key in ledger.times;
        var ages := retainPendingWelcomeValues(ledger.times, without.kept);
        var installed := insertPendingWelcomeValue(ages, action.change.key, observed);
        result := WelcomeTimedLedger(base, installed, observed);
        assert installed.Keys == base.values.Keys;
        forall key | key in installed && key != action.change.key
          ensures key in ledger.times && installed[key] == ledger.times[key] && base.values[key] == ledger.base.values[key]
        {
          assert key in ages && key in ledger.base.values;
        }
        assert WelcomeTimedState(result, maximumEntries, maximumBytes);
      } else if action.change.store {
        assert base == ledger.base;
      } else {
        var ages := retainPendingWelcomeValues(ledger.times, base.entries);
        result := WelcomeTimedLedger(base, ages, ledger.clock);
        assert ages.Keys == base.values.Keys;
        assert WelcomeTimedState(result, maximumEntries, maximumBytes);
      }
    }
  }
}

@IsolateAssertions
method welcomeTimed_all_histories<Value(==)>(ledger: WelcomeTimedLedger<Value>, actions: seq<WelcomeTimedAction<Value>>, maximumEntries: int, maximumBytes: int)
  returns (result: WelcomeTimedLedger<Value>)
  requires WelcomeTimedState(ledger, maximumEntries, maximumBytes)
  requires forall index :: 0 <= index < |actions| ==> WelcomeTimedActionValid(actions[index], maximumBytes)
  ensures WelcomeTimedState(result, maximumEntries, maximumBytes)
  ensures ledger.clock <= result.clock
  ensures result.clock == ledger.clock || (exists index :: 0 <= index < |actions| && actions[index].change.prepared && (actions[index].expire || actions[index].change.store) && result.clock == actions[index].now)
  ensures (forall index :: 0 <= index < |actions| ==> !actions[index].change.prepared) ==> result == ledger
  decreases |actions|
{
  if |actions| == 0 {
    result := ledger;
  } else {
    var next, stored := welcomeTimed_step(ledger, actions[0], maximumEntries, maximumBytes);
    result := welcomeTimed_all_histories(next, actions[1..], maximumEntries, maximumBytes);
  }
}

@IsolateAssertions
method welcomeTimed_domain()
{
  var empty: WelcomeTimedLedger<int> := WelcomeTimedLedger(WelcomeLedger([], map[], 0), map[], 0);
  assert WelcomeTimedState(empty, 2, 4);
  var first, firstStored := welcomeTimed_step(empty, WelcomeTimedAction(false, 100, WelcomeAction(true, "old", 1, true, true, 10)), 2, 4);
  assert firstStored && first.times["old"] == 100;
  var boundary, boundaryStored := welcomeTimed_step(first, WelcomeTimedAction(true, 300100, WelcomeAction(false, "", 0, false, true, 0)), 2, 4);
  assert !boundaryStored && "old" in boundary.times && boundary.clock == 300100;
  var backward, backwardStored := welcomeTimed_step(boundary, WelcomeTimedAction(false, 0, WelcomeAction(true, "fresh", 1, true, true, 20)), 2, 4);
  assert backwardStored && backward.times["fresh"] == 300100;
  var expired, expiredStored := welcomeTimed_step(backward, WelcomeTimedAction(true, 300101, WelcomeAction(false, "", 0, false, true, 0)), 2, 4);
  assert !expiredStored && "old" !in expired.times && "fresh" in expired.times;
  var failed, failedStored := welcomeTimed_step(expired, WelcomeTimedAction(true, 9007199254740991, WelcomeAction(false, "", 0, false, false, 0)), 2, 4);
  assert !failedStored && failed == expired;
  var actions := [
    WelcomeTimedAction(false, 100, WelcomeAction(true, "old", 1, true, true, 10)),
    WelcomeTimedAction(true, 300101, WelcomeAction(false, "", 0, false, true, 0))
  ];
  var history := welcomeTimed_all_histories(empty, actions, 2, 4);
  assert WelcomeTimedState(history, 2, 4);
  assert !isPendingWelcomeExpired(9007199254440991, 9007199254740991, 300000);
  assert isPendingWelcomeExpired(9007199254440990, 9007199254740991, 300000);
}
