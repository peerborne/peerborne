@IsolateAssertions
method trimPendingWelcomes(entries: seq<PendingWelcomeMetadata>, incomingBytes: int, allowAuthenticated: bool, maximumEntries: int, maximumBytes: int) returns (res: PendingWelcomePressure)
  requires (|entries| <= 16)
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> ((1 <= entries[i].bytes) && (entries[i].bytes <= 10485760)))
  requires forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |entries|) ==> (entries[i].key != entries[j].key))
  requires (1 <= maximumEntries)
  requires (maximumEntries <= 16)
  requires (1 <= incomingBytes)
  requires (incomingBytes <= 10485760)
  requires (incomingBytes <= maximumBytes)
  requires (maximumBytes <= 20971520)
  ensures (|res.kept| <= |entries|)
  ensures forall i: int :: ((0 <= i) ==> (i < |res.kept|) ==> (res.kept[i] in entries))
  ensures forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res.kept|) ==> (res.kept[i].key != res.kept[j].key))
  ensures ((|res.kept| + |res.evictedKeys|) == |entries|)
  ensures (0 <= res.retainedBytes)
  ensures (res.retainedBytes <= 167772160)
  ensures (!(allowAuthenticated) ==> forall i: int :: ((0 <= i) ==> (i < |entries|) ==> entries[i].authenticated ==> (entries[i] in res.kept)))
  ensures (allowAuthenticated ==> ((|res.kept| < maximumEntries) && (res.retainedBytes <= (maximumBytes - incomingBytes))))
  ensures WelcomeShape(res.kept)
  ensures res.retainedBytes == WelcomeTotal(res.kept)
  ensures !allowAuthenticated ==> WelcomeProtectedBytes(res.kept) == WelcomeProtectedBytes(entries) && WelcomeProtectedCount(res.kept) == WelcomeProtectedCount(entries)
  ensures |res.kept| >= maximumEntries || res.retainedBytes > maximumBytes - incomingBytes ==> !allowAuthenticated && (forall entry :: entry in res.kept ==> entry.authenticated)
  ensures |entries| < maximumEntries && WelcomeTotal(entries) <= maximumBytes - incomingBytes ==> res.kept == entries && res.evictedKeys == []
{
  var i_t5 := pendingWelcomeBudget(entries, "");
  var budget := i_t5;
  var remainingCount := |entries|;
  var remainingBytes := budget.total;
  var kept: seq<PendingWelcomeMetadata> := [];
  var evictedKeys: seq<string> := [];
  var index := 0;
  while (index < |entries|)
    invariant (0 <= index)
    invariant (index <= |entries|)
    invariant (|kept| <= index)
    invariant (0 <= remainingCount)
    invariant (remainingCount <= |entries|)
    invariant (0 <= remainingBytes)
    invariant (remainingBytes <= 167772160)
    invariant ((remainingCount + |evictedKeys|) == |entries|)
    invariant WelcomeShape(kept)
    invariant |kept| <= WelcomeTotal(kept)
    invariant forall entry :: entry in kept ==> entry in entries[..index]
    invariant remainingCount == |kept| + |entries| - index
    invariant remainingBytes == WelcomeTotal(kept) + WelcomeTotal(entries) - WelcomeTotal(entries[..index])
    invariant !allowAuthenticated ==> forall entry :: entry in entries[..index] && entry.authenticated ==> entry in kept
    invariant !allowAuthenticated ==> WelcomeProtectedBytes(kept) == WelcomeProtectedBytes(entries[..index]) && WelcomeProtectedCount(kept) == WelcomeProtectedCount(entries[..index])
    invariant (exists entry :: entry in kept && (allowAuthenticated || !entry.authenticated)) ==> remainingCount < maximumEntries && remainingBytes <= maximumBytes - incomingBytes
    invariant |entries| < maximumEntries && budget.total <= maximumBytes - incomingBytes ==> kept == entries[..index] && evictedKeys == [] && remainingCount == |entries| && remainingBytes == budget.total
    decreases (|entries| - index)
  {
    welcomeShape_slice(entries, index, |entries|);
    welcomeMeasure_bounds(entries[index..]);
    welcomeMeasures_concat(entries[..index], entries[index..]);
    welcomeFreshKey(entries, index);
    welcomePrefix_append(entries, index);
    assert entries == entries[..index] + entries[index..];
    assert entries[index] in entries[index..];
    welcomeMeasures_concat(entries[..index], [entries[index]]);
    welcomeMeasures_concat(kept, [entries[index]]);
    assert (allowAuthenticated || !entries[index].authenticated) && (remainingCount >= maximumEntries || remainingBytes > maximumBytes - incomingBytes) ==> remainingCount > 0 && remainingBytes >= entries[index].bytes;
    var entry := entries[index];
    if ((allowAuthenticated || !(entry.authenticated)) && ((remainingCount >= maximumEntries) || (remainingBytes > (maximumBytes - incomingBytes)))) {
      evictedKeys := (evictedKeys + [entry.key]);
      assert allowAuthenticated || !entry.authenticated;
      assert remainingCount >= maximumEntries || remainingBytes > maximumBytes - incomingBytes;
      remainingCount := (remainingCount - 1);
      remainingBytes := (remainingBytes - entry.bytes);
    } else {
      if allowAuthenticated || !entry.authenticated {
        assert remainingCount < maximumEntries && remainingBytes <= maximumBytes - incomingBytes;
      }
      assert forall prior :: prior in kept ==> prior.key != entry.key;
      welcomeShape_append(kept, entry);
      kept := (kept + [entry]);
    }
    assert remainingBytes == WelcomeTotal(kept) + WelcomeTotal(entries) - WelcomeTotal(entries[..index+1]);
    index := (index + 1);
  }
  assert index == |entries| && entries[..index] == entries;
  assert remainingCount == |kept| && remainingBytes == WelcomeTotal(kept);
  if allowAuthenticated && |kept| == 0 {
    assert remainingCount == 0 && remainingBytes == 0;
  }
  return PendingWelcomePressure(kept, evictedKeys, remainingBytes);
}

