// Project a single author's receipt over successive attempts. The runtime
// stages all of a checkpoint's receipts together and discards it on conflict.
function CatchUpReceiptHistory(current: nat, offers: seq<nat>, matches: seq<bool>, canAdopt: bool): nat
  requires current <= 9007199254740991
  requires |offers| == |matches|
  requires forall i :: 0 <= i < |offers| ==> offers[i] <= 9007199254740991
  ensures CatchUpReceiptHistory(current, offers, matches, canAdopt) >= current
  ensures current > 0 || !canAdopt ==> CatchUpReceiptHistory(current, offers, matches, canAdopt) == current
  decreases |offers|
{
  if |offers| == 0 then current else
    var next := if admitDocumentCatchUpReceipt(current, offers[0], matches[0], canAdopt).adopt?
      then offers[0] else current;
    CatchUpReceiptHistory(next, offers[1..], matches[1..], canAdopt)
}

