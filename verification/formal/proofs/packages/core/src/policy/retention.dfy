// lsc options: string-semantics=javascript-utf16

datatype BlockGcPhase = ready | checking | deleting | settled | aborted

datatype BlockGcAction = check | delete | settle | abort

function canRetainGcCandidate(known: bool, count: int, length: int): bool
  requires (0 <= count)
  requires (count <= 32768)
  requires (0 <= length)
  requires (length <= 9007199254740991)
{
  (((length >= 1) && (length <= 512)) && (known || (count < 32768)))
}

lemma canRetainGcCandidate_ensures(known: bool, count: int, length: int)
  requires (0 <= count)
  requires (count <= 32768)
  requires (0 <= length)
  requires (length <= 9007199254740991)
  ensures (canRetainGcCandidate(known, count, length) <==> (((1 <= length) && (length <= 512)) && (known || (count < 32768))))
  ensures (canRetainGcCandidate(known, count, length) ==> !(known) ==> ((count + 1) <= 32768))
{
}

function gcLeaseIsCurrent(sameTree: bool, sameSnapshot: bool, sameTips: bool, active: bool): bool
{
  (((sameTree && sameSnapshot) && sameTips) && active)
}

lemma gcLeaseIsCurrent_ensures(sameTree: bool, sameSnapshot: bool, sameTips: bool, active: bool)
  ensures (gcLeaseIsCurrent(sameTree, sameSnapshot, sameTips, active) <==> (((sameTree && sameSnapshot) && sameTips) && active))
{
}

function advanceBlockGc(phase: BlockGcPhase, action: BlockGcAction, leaseCurrent: bool, unpinned: bool): BlockGcPhase
{
  if ((phase.ready? && action.check?) && leaseCurrent) then
    BlockGcPhase.checking
  else
    if (((phase.checking? && action.delete?) && leaseCurrent) && unpinned) then
      BlockGcPhase.deleting
    else
      if (phase.deleting? && action.settle?) then
        BlockGcPhase.settled
      else
        BlockGcPhase.aborted
}

lemma advanceBlockGc_ensures(phase: BlockGcPhase, action: BlockGcAction, leaseCurrent: bool, unpinned: bool)
  ensures (advanceBlockGc(phase, action, leaseCurrent, unpinned).deleting? <==> (((phase.checking? && action.delete?) && leaseCurrent) && unpinned))
  ensures (advanceBlockGc(phase, action, leaseCurrent, unpinned).checking? <==> ((phase.ready? && action.check?) && leaseCurrent))
  ensures (advanceBlockGc(phase, action, leaseCurrent, unpinned).settled? <==> (phase.deleting? && action.settle?))
  ensures ((phase.settled? || phase.aborted?) ==> advanceBlockGc(phase, action, leaseCurrent, unpinned).aborted?)
{
}

method selectDeletableCids(candidates: seq<string>, retained: set<string>, protectedCids: set<string>) returns (res: set<string>)
  requires (|candidates| <= 4294967295)
  ensures forall cid :: ((cid in res) <==> (((cid in candidates) && !((cid in retained))) && !((cid in protectedCids))))
{
  var result: set<string> := {};
  var index := 0;
  while (index < |candidates|)
    invariant (0 <= index)
    invariant (index <= |candidates|)
    invariant forall cid :: ((cid in result) ==> ((!((cid in retained)) && !((cid in protectedCids))) && exists j: int :: (((0 <= j) && (j < index)) && (candidates[j] == cid))))
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> !((candidates[j] in retained)) ==> !((candidates[j] in protectedCids)) ==> (candidates[j] in result))
    decreases (|candidates| - index)
  {
    var cid := candidates[index];
    if (!((cid in retained)) && !((cid in protectedCids))) {
      result := (result + {cid});
    }
    index := (index + 1);
  }
  return result;
}

method retention_domain()
{
  blockGc_domain();
  var empty := selectDeletableCids([], {}, {});
  var selection := selectDeletableCids(["a", "a", "b", "c"], {"b"}, {"c"});
  assert empty == {} && selection == {"a"};
  var before, after := retention_protection_monotone(["a", "b", "c"], {}, {}, {"b"}, {"c"});
  assert before == {"a", "b", "c"} && after == {"a"};
  var whole, left, right := retention_batches(["a", "b"], ["a", "c"], {"b"}, {"c"});
  assert whole == {"a"} && left == {"a"} && right == {"a"};
  var remaining := retention_all_sweeps({"a", "b", "c", "untouched"}, [["a", "b"], ["a", "c"]], {"b"}, {"c"});
  assert remaining == {"b", "c", "untouched"};
}

function BlockGcRank(phase: BlockGcPhase): int
{
  if phase.ready? then 0 else if phase.checking? then 1 else
  if phase.deleting? then 2 else if phase.settled? then 3 else 4
}

lemma blockGc_phase_order(phase: BlockGcPhase, action: BlockGcAction, leaseCurrent: bool, unpinned: bool)
  ensures BlockGcRank(advanceBlockGc(phase, action, leaseCurrent, unpinned)) >= BlockGcRank(phase)
  ensures advanceBlockGc(phase, action, leaseCurrent, unpinned).deleting? ==> phase.checking? && action.delete? && leaseCurrent && unpinned
{
}

datatype BlockGcEvent = BlockGcEvent(action: BlockGcAction, leaseCurrent: bool, unpinned: bool)

function BlockGcFinal(initial: BlockGcPhase, events: seq<BlockGcEvent>): BlockGcPhase
  decreases |events|
{
  if |events| == 0 then initial else
    BlockGcFinal(advanceBlockGc(initial, events[0].action, events[0].leaseCurrent, events[0].unpinned), events[1..])
}

function BlockGcStarts(initial: BlockGcPhase, events: seq<BlockGcEvent>): int
  decreases |events|
{
  if |events| == 0 then 0 else
    (if advanceBlockGc(initial, events[0].action, events[0].leaseCurrent, events[0].unpinned).deleting? then 1 else 0) +
    BlockGcStarts(advanceBlockGc(initial, events[0].action, events[0].leaseCurrent, events[0].unpinned), events[1..])
}

method blockGc_all_histories(initial: BlockGcPhase, events: seq<BlockGcEvent>)
  returns (phase: BlockGcPhase, starts: int)
  ensures phase == BlockGcFinal(initial, events)
  ensures starts == BlockGcStarts(initial, events)
  ensures BlockGcRank(phase) >= BlockGcRank(initial)
  ensures 0 <= starts <= (if BlockGcRank(initial) < 2 then 1 else 0)
  ensures (forall i :: 0 <= i < |events| ==> !events[i].leaseCurrent || !events[i].unpinned) ==> starts == 0
  decreases |events|
{
  if |events| == 0 {
    phase := initial;
    starts := 0;
  } else {
    var event := events[0];
    blockGc_phase_order(initial, event.action, event.leaseCurrent, event.unpinned);
    var next := advanceBlockGc(initial, event.action, event.leaseCurrent, event.unpinned);
    var later: int;
    phase, later := blockGc_all_histories(next, events[1..]);
    starts := later + (if next.deleting? then 1 else 0);
  }
}

method blockGc_domain()
{
  assert gcLeaseIsCurrent(true, true, true, true);
  assert !gcLeaseIsCurrent(true, false, true, true);
  var checking := advanceBlockGc(BlockGcPhase.ready, BlockGcAction.check, true, false);
  assert checking.checking?;
  assert advanceBlockGc(checking, BlockGcAction.delete, true, false).aborted?;
  assert advanceBlockGc(checking, BlockGcAction.delete, false, true).aborted?;
  var phase, starts := blockGc_all_histories(checking, [BlockGcEvent(BlockGcAction.delete, true, true)]);
  assert phase.deleting? && starts == 1;
  var finished := advanceBlockGc(phase, BlockGcAction.settle, false, false);
  assert finished.settled?;
  assert advanceBlockGc(finished, BlockGcAction.delete, true, true).aborted?;
  assert canRetainGcCandidate(false, 0, 1);
  assert canRetainGcCandidate(true, 32768, 512);
  assert !canRetainGcCandidate(false, 32768, 512);
  assert !canRetainGcCandidate(true, 32768, 513);
}

method retention_protection_monotone(candidates: seq<string>, retained: set<string>, protectedCids: set<string>, nextRetained: set<string>, nextProtected: set<string>)
  returns (before: set<string>, after: set<string>)
  requires |candidates| <= 4294967295
  requires retained <= nextRetained && protectedCids <= nextProtected
  ensures before == (set cid | cid in candidates) - (retained + protectedCids)
  ensures after == (set cid | cid in candidates) - (nextRetained + nextProtected)
  ensures after <= before
  ensures before - after == before * (nextRetained + nextProtected)
{
  before := selectDeletableCids(candidates, retained, protectedCids);
  after := selectDeletableCids(candidates, nextRetained, nextProtected);
}

method retention_batches(first: seq<string>, second: seq<string>, retained: set<string>, protectedCids: set<string>)
  returns (whole: set<string>, left: set<string>, right: set<string>)
  requires |first| + |second| <= 4294967295
  ensures whole == (set cid | cid in first + second) - (retained + protectedCids)
  ensures left == (set cid | cid in first) - (retained + protectedCids)
  ensures right == (set cid | cid in second) - (retained + protectedCids)
  ensures whole == left + right
{
  whole := selectDeletableCids(first + second, retained, protectedCids);
  left := selectDeletableCids(first, retained, protectedCids);
  right := selectDeletableCids(second, retained, protectedCids);
}

function RetentionCandidates(batches: seq<seq<string>>): set<string>
  decreases |batches|
{
  if |batches| == 0 then {} else
    (set cid | cid in batches[0]) + RetentionCandidates(batches[1..])
}

method retention_all_sweeps(initial: set<string>, batches: seq<seq<string>>, retained: set<string>, protectedCids: set<string>)
  returns (remaining: set<string>)
  requires forall i :: 0 <= i < |batches| ==> |batches[i]| <= 4294967295
  ensures remaining == initial - (RetentionCandidates(batches) - (retained + protectedCids))
  ensures remaining <= initial
  ensures initial * (retained + protectedCids) <= remaining
  ensures initial - RetentionCandidates(batches) <= remaining
  decreases |batches|
{
  if |batches| == 0 {
    remaining := initial;
  } else {
    var selected := selectDeletableCids(batches[0], retained, protectedCids);
    assert selected == (set cid | cid in batches[0]) - (retained + protectedCids);
    remaining := retention_all_sweeps(initial - selected, batches[1..], retained, protectedCids);
  }
}
