lemma DoublePowerFacts(x: int, exponent: int)
  requires 0 <= exponent < 31
  requires x >= 1
  requires JSRem(x, powerOfTwo(exponent)) == 0
  requires JSRem(JSFloorDiv(x, powerOfTwo(exponent)), 2) == 1
  ensures JSRem(2*x, powerOfTwo(exponent+1)) == 0
  ensures JSRem(JSFloorDiv(2*x, powerOfTwo(exponent+1)), 2) == 1
{
  reveal powerOfTwo();
  if exponent == 0 {
    assert powerOfTwo(exponent) == 1;
    assert powerOfTwo(exponent+1) == 2;
    Numeric.DoubleMultiple_0(x);
    return;
  }
  if exponent == 1 {
    assert powerOfTwo(exponent) == 2;
    assert powerOfTwo(exponent+1) == 4;
    Numeric.DoubleMultiple_1(x);
    return;
  }
  if exponent == 2 {
    assert powerOfTwo(exponent) == 4;
    assert powerOfTwo(exponent+1) == 8;
    Numeric.DoubleMultiple_2(x);
    return;
  }
  if exponent == 3 {
    assert powerOfTwo(exponent) == 8;
    assert powerOfTwo(exponent+1) == 16;
    Numeric.DoubleMultiple_3(x);
    return;
  }
  if exponent == 4 {
    assert powerOfTwo(exponent) == 16;
    assert powerOfTwo(exponent+1) == 32;
    Numeric.DoubleMultiple_4(x);
    return;
  }
  if exponent == 5 {
    assert powerOfTwo(exponent) == 32;
    assert powerOfTwo(exponent+1) == 64;
    Numeric.DoubleMultiple_5(x);
    return;
  }
  if exponent == 6 {
    assert powerOfTwo(exponent) == 64;
    assert powerOfTwo(exponent+1) == 128;
    Numeric.DoubleMultiple_6(x);
    return;
  }
  if exponent == 7 {
    assert powerOfTwo(exponent) == 128;
    assert powerOfTwo(exponent+1) == 256;
    Numeric.DoubleMultiple_7(x);
    return;
  }
  if exponent == 8 {
    assert powerOfTwo(exponent) == 256;
    assert powerOfTwo(exponent+1) == 512;
    Numeric.DoubleMultiple_8(x);
    return;
  }
  if exponent == 9 {
    assert powerOfTwo(exponent) == 512;
    assert powerOfTwo(exponent+1) == 1024;
    Numeric.DoubleMultiple_9(x);
    return;
  }
  if exponent == 10 {
    assert powerOfTwo(exponent) == 1024;
    assert powerOfTwo(exponent+1) == 2048;
    Numeric.DoubleMultiple_10(x);
    return;
  }
  if exponent == 11 {
    assert powerOfTwo(exponent) == 2048;
    assert powerOfTwo(exponent+1) == 4096;
    Numeric.DoubleMultiple_11(x);
    return;
  }
  if exponent == 12 {
    assert powerOfTwo(exponent) == 4096;
    assert powerOfTwo(exponent+1) == 8192;
    Numeric.DoubleMultiple_12(x);
    return;
  }
  if exponent == 13 {
    assert powerOfTwo(exponent) == 8192;
    assert powerOfTwo(exponent+1) == 16384;
    Numeric.DoubleMultiple_13(x);
    return;
  }
  if exponent == 14 {
    assert powerOfTwo(exponent) == 16384;
    assert powerOfTwo(exponent+1) == 32768;
    Numeric.DoubleMultiple_14(x);
    return;
  }
