lemma ClampRightAscends(index: int, width: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires powerOfTwo(rootLevel) <= width < 2*powerOfTwo(rootLevel)
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) < rootLevel
  requires index - powerOfTwo(nodeLevel(index)) + 1 < width
  ensures parentInWidth(clampRightChild(index, width), width, rootLevel) == parentInWidth(index, width, rootLevel)
  decreases nodeLevel(index)
{
  reveal clampRightChild();
  if index >= width {
    ClampRightFacts(index, width);
    tree_child_parent(index);
    ClampRightAscends(leftChild(index), width, rootLevel);
    reveal parentInWidth();
  }
}

lemma tree_left_parent(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures treeParent(leftChild(index), leaves) == index
{
  var rootLevel := floorLog2(treeWidth(leaves));
  if index != treeRoot(leaves) { LevelBelowRoot(index, rootLevel); }
  tree_child_parent(index);
  reveal treeParent();
  reveal parentInWidth();
}

lemma tree_right_parent(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures treeParent(treeRight(index, leaves), leaves) == index
{
  var rootLevel := floorLog2(treeWidth(leaves));
  if index != treeRoot(leaves) { LevelBelowRoot(index, rootLevel); }
  RightWithinCompleteTree(index, rootLevel);
  tree_child_parent(index);
  InternalNotLast(index, leaves);
  ClampRightAscends(rightChild(index), treeWidth(leaves), rootLevel);
  reveal treeRight();
  reveal treeParent();
  reveal parentInWidth();
}

method treeIndex_domain()
{
  reveal powerOfTwo();
  assert treeRoot(1) == 0;
  assert treeRoot(5) == 7;
  assert treeWidth(1073741824) == 2147483647;
  assert leafPosition(leafNodeIndex(1073741823)) == 1073741823;
  var path := treeDirectPath(8, 5);
  var co := treeCopath(8, 5);
  assert |path| == |co| && 0 < |path| <= 30;
  assert path[|path|-1] == treeRoot(5);
}

























































































































