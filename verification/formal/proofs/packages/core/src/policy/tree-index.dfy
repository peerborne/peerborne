lemma tree_child_parent(index: int)
  requires 0 <= index <= 2147483646 && nodeLevel(index) > 0
  ensures parentStep(leftChild(index)) == index
  ensures parentStep(rightChild(index)) == index
{
  if nodeLevel(index) == 1 { TreeChildParent_1(index); }
  if nodeLevel(index) == 2 { TreeChildParent_2(index); }
