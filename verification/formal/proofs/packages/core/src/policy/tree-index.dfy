lemma PowerFactor(value: int, exponent: int)
  requires value >= 0 && 0 <= exponent <= 31
  requires JSRem(value, powerOfTwo(exponent)) == 0
  ensures value == JSFloorDiv(value, powerOfTwo(exponent)) * powerOfTwo(exponent)
{
  reveal powerOfTwo();
  if exponent == 0 {
    assert powerOfTwo(exponent) == 1;
    PowerFactor_0(value);
  }
  if exponent == 1 {
    assert powerOfTwo(exponent) == 2;
    PowerFactor_1(value);
  }
  if exponent == 2 {
    assert powerOfTwo(exponent) == 4;
    PowerFactor_2(value);
  }
  if exponent == 3 {
    assert powerOfTwo(exponent) == 8;
    PowerFactor_3(value);
  }
  if exponent == 4 {
    assert powerOfTwo(exponent) == 16;
    PowerFactor_4(value);
  }
  if exponent == 5 {
    assert powerOfTwo(exponent) == 32;
    PowerFactor_5(value);
  }
  if exponent == 6 {
    assert powerOfTwo(exponent) == 64;
    PowerFactor_6(value);
  }
  if exponent == 7 {
    assert powerOfTwo(exponent) == 128;
    PowerFactor_7(value);
  }
  if exponent == 8 {
    assert powerOfTwo(exponent) == 256;
    PowerFactor_8(value);
  }
  if exponent == 9 {
    assert powerOfTwo(exponent) == 512;
    PowerFactor_9(value);
  }
  if exponent == 10 {
    assert powerOfTwo(exponent) == 1024;
    PowerFactor_10(value);
  }
  if exponent == 11 {
    assert powerOfTwo(exponent) == 2048;
    PowerFactor_11(value);
  }
  if exponent == 12 {
    assert powerOfTwo(exponent) == 4096;
    PowerFactor_12(value);
  }
  if exponent == 13 {
    assert powerOfTwo(exponent) == 8192;
    PowerFactor_13(value);
  }
  if exponent == 14 {
    assert powerOfTwo(exponent) == 16384;
    PowerFactor_14(value);
  }
  if exponent == 15 {
    assert powerOfTwo(exponent) == 32768;
    PowerFactor_15(value);
  }
  if exponent == 16 {
    assert powerOfTwo(exponent) == 65536;
    PowerFactor_16(value);
  }
  if exponent == 17 {
    assert powerOfTwo(exponent) == 131072;
    PowerFactor_17(value);
  }
  if exponent == 18 {
    assert powerOfTwo(exponent) == 262144;
    PowerFactor_18(value);
  }
  if exponent == 19 {
    assert powerOfTwo(exponent) == 524288;
    PowerFactor_19(value);
  }
  if exponent == 20 {
    assert powerOfTwo(exponent) == 1048576;
    PowerFactor_20(value);
  }
  if exponent == 21 {
    assert powerOfTwo(exponent) == 2097152;
    PowerFactor_21(value);
  }
  if exponent == 22 {
    assert powerOfTwo(exponent) == 4194304;
    PowerFactor_22(value);
  }
  if exponent == 23 {
    assert powerOfTwo(exponent) == 8388608;
    PowerFactor_23(value);
  }
  if exponent == 24 {
    assert powerOfTwo(exponent) == 16777216;
    PowerFactor_24(value);
  }
  if exponent == 25 {
    assert powerOfTwo(exponent) == 33554432;
    PowerFactor_25(value);
  }
  if exponent == 26 {
    assert powerOfTwo(exponent) == 67108864;
    PowerFactor_26(value);
  }
  if exponent == 27 {
    assert powerOfTwo(exponent) == 134217728;
    PowerFactor_27(value);
  }
  if exponent == 28 {
    assert powerOfTwo(exponent) == 268435456;
    PowerFactor_28(value);
  }
  if exponent == 29 {
    assert powerOfTwo(exponent) == 536870912;
    PowerFactor_29(value);
  }
  if exponent == 30 {
    assert powerOfTwo(exponent) == 1073741824;
    PowerFactor_30(value);
  }
  if exponent == 31 {
    assert powerOfTwo(exponent) == 2147483648;
    PowerFactor_31(value);
  }
}

