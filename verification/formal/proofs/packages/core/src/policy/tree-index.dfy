lemma PowerDivides(low: int, high: int)
  requires 0 <= low <= high <= 31
  ensures JSRem(powerOfTwo(high), powerOfTwo(low)) == 0
  decreases high-low
{
  if low < high {
    PowerDivides(low, high-1);
    TwiceMultiple(powerOfTwo(high-1), low);
  }
}

lemma LevelAtTop(index: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) == rootLevel
  ensures index == powerOfTwo(rootLevel)-1
{
  FactorOne(index+1, rootLevel);
}

lemma LevelBelowRoot(index: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires index != powerOfTwo(rootLevel)-1
  ensures nodeLevel(index) < rootLevel
{
  var actual := nodeLevel(index);
  if actual > rootLevel {
    PowerOrder(rootLevel+1, actual);
  } else if actual == rootLevel {
    LevelAtTop(index, rootLevel);
  }
}

lemma ParentWithinFacts(index: int, width: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires powerOfTwo(rootLevel) <= width < 2*powerOfTwo(rootLevel)
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) < rootLevel
  ensures 0 <= parentStep(index) < 2*powerOfTwo(rootLevel)-1
  ensures nodeLevel(parentStep(index)) <= rootLevel
  ensures parentStep(index) >= width ==> nodeLevel(parentStep(index)) < rootLevel
{
  var exponent := nodeLevel(index);
  PowerDivides(exponent+2, rootLevel+1);
  assert powerOfTwo(exponent+2) == 4*powerOfTwo(exponent);
  assert powerOfTwo(rootLevel+1) == 2*powerOfTwo(rootLevel);
  ParentStepFacts(index, exponent, 2*powerOfTwo(rootLevel));
  ParentStepForm(index);
  if nodeLevel(parentStep(index)) == rootLevel {
    LevelAtTop(parentStep(index), rootLevel);
  }
}

