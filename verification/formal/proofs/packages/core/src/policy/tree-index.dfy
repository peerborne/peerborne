lemma tree_sibling_children(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures treeSibling(leftChild(index), leaves) == treeRight(index, leaves)
  ensures treeSibling(treeRight(index, leaves), leaves) == leftChild(index)
{
  tree_left_parent(index, leaves);
  tree_right_parent(index, leaves);
  reveal treeSibling();
}

