lemma PowerOrder(low: int, high: int)
  requires 0 <= low <= high <= 31
  ensures powerOfTwo(low) <= powerOfTwo(high)
  ensures low < high ==> powerOfTwo(low) < powerOfTwo(high)
  decreases high - low
{
  if low < high { PowerOrder(low, high-1); }
}

lemma LevelFromOddFactor(index: int, exponent: int, factor: int)
  requires 0 <= index <= 2147483646
  requires 0 <= exponent <= 30
  requires factor >= 1 && factor % 2 == 1
  requires index + 1 == factor * powerOfTwo(exponent)
  ensures nodeLevel(index) == exponent
  decreases exponent
{
  reveal nodeLevel();
  if exponent == 0 {
    assert powerOfTwo(exponent) == 1;
    assert index % 2 == 0;
  } else {
    assert powerOfTwo(exponent) == 2 * powerOfTwo(exponent-1);
    assert index + 1 == 2 * (factor * powerOfTwo(exponent-1));
    assert index % 2 == 1;
    var half := JSFloorDiv(index-1, 2);
    assert half + 1 == factor * powerOfTwo(exponent-1);
    LevelFromOddFactor(half, exponent-1, factor);
  }
}

lemma LeftLevelFacts(index: int)
  requires 0 <= index <= 2147483646 && nodeLevel(index) > 0
  ensures 0 <= index - powerOfTwo(nodeLevel(index)-1) < index
  ensures nodeLevel(index - powerOfTwo(nodeLevel(index)-1)) == nodeLevel(index)-1
{
  var exponent := nodeLevel(index);
  var factor := JSFloorDiv(index+1, powerOfTwo(exponent));
  assert factor >= 1 && factor % 2 == 1;
  assert index+1 == factor * powerOfTwo(exponent);
  var child := index - powerOfTwo(exponent-1);
  assert child+1 == (2*factor-1) * powerOfTwo(exponent-1);
  LevelFromOddFactor(child, exponent-1, 2*factor-1);
}

lemma RightLevelFacts(index: int)
  requires 0 <= index <= 2147483646 && nodeLevel(index) > 0
  ensures index < index + powerOfTwo(nodeLevel(index)-1) <= 2147483646
  ensures nodeLevel(index + powerOfTwo(nodeLevel(index)-1)) == nodeLevel(index)-1
{
  var exponent := nodeLevel(index);
  var factor := JSFloorDiv(index+1, powerOfTwo(exponent));
  assert factor >= 1 && factor % 2 == 1;
  assert index+1 == factor * powerOfTwo(exponent);
  RightIndexBound(index, exponent);
  var child := index + powerOfTwo(exponent-1);
  assert child+1 == (2*factor+1) * powerOfTwo(exponent-1);
  LevelFromOddFactor(child, exponent-1, 2*factor+1);
}

lemma ClampRightFacts(index: int, width: int)
  requires 0 <= index <= 2147483646
  requires 1 <= width <= 2147483647
  requires index - powerOfTwo(nodeLevel(index)) + 1 < width
  ensures index >= width ==> nodeLevel(index) > 0
  ensures index >= width ==> leftChild(index) - powerOfTwo(nodeLevel(leftChild(index))) + 1 < width
{
  if nodeLevel(index) == 0 { assert powerOfTwo(0) == 1; }
}

opaque
function ParentNumeral(index: int, step: int): int
  requires step > 0
{
  if JSRem(JSFloorDiv(index, 2*step), 2) == 0 then index+step else index-step
}

lemma ParentStepFacts(index: int, exponent: int, bound: int)
  requires 0 <= index <= 2147483646 && 0 <= exponent < 30
  requires JSRem(index+1, powerOfTwo(exponent)) == 0
  requires JSRem(JSFloorDiv(index+1, powerOfTwo(exponent)), 2) == 1
  requires index+1 < bound <= 2147483648
  requires bound % (4*powerOfTwo(exponent)) == 0
  ensures 0 <= ParentNumeral(index, powerOfTwo(exponent)) < bound-1
  ensures nodeLevel(ParentNumeral(index, powerOfTwo(exponent))) == exponent+1
{
  reveal powerOfTwo();
  if exponent == 0 {
    assert powerOfTwo(exponent) == 1;
    assert powerOfTwo(exponent+1) == 2;
    ParentNumeral_0(index, bound);
  }
  if exponent == 1 {
    assert powerOfTwo(exponent) == 2;
    assert powerOfTwo(exponent+1) == 4;
    ParentNumeral_1(index, bound);
  }
  if exponent == 2 {
    assert powerOfTwo(exponent) == 4;
    assert powerOfTwo(exponent+1) == 8;
    ParentNumeral_2(index, bound);
  }
  if exponent == 3 {
    assert powerOfTwo(exponent) == 8;
    assert powerOfTwo(exponent+1) == 16;
    ParentNumeral_3(index, bound);
  }
  if exponent == 4 {
    assert powerOfTwo(exponent) == 16;
    assert powerOfTwo(exponent+1) == 32;
    ParentNumeral_4(index, bound);
  }
  if exponent == 5 {
    assert powerOfTwo(exponent) == 32;
    assert powerOfTwo(exponent+1) == 64;
    ParentNumeral_5(index, bound);
  }
  if exponent == 6 {
    assert powerOfTwo(exponent) == 64;
    assert powerOfTwo(exponent+1) == 128;
    ParentNumeral_6(index, bound);
  }
  if exponent == 7 {
    assert powerOfTwo(exponent) == 128;
    assert powerOfTwo(exponent+1) == 256;
    ParentNumeral_7(index, bound);
  }
  if exponent == 8 {
    assert powerOfTwo(exponent) == 256;
    assert powerOfTwo(exponent+1) == 512;
    ParentNumeral_8(index, bound);
  }
  if exponent == 9 {
    assert powerOfTwo(exponent) == 512;
    assert powerOfTwo(exponent+1) == 1024;
    ParentNumeral_9(index, bound);
  }
  if exponent == 10 {
    assert powerOfTwo(exponent) == 1024;
    assert powerOfTwo(exponent+1) == 2048;
    ParentNumeral_10(index, bound);
  }
  if exponent == 11 {
    assert powerOfTwo(exponent) == 2048;
    assert powerOfTwo(exponent+1) == 4096;
    ParentNumeral_11(index, bound);
  }
  if exponent == 12 {
    assert powerOfTwo(exponent) == 4096;
    assert powerOfTwo(exponent+1) == 8192;
    ParentNumeral_12(index, bound);
  }
  if exponent == 13 {
    assert powerOfTwo(exponent) == 8192;
    assert powerOfTwo(exponent+1) == 16384;
    ParentNumeral_13(index, bound);
  }
  if exponent == 14 {
    assert powerOfTwo(exponent) == 16384;
    assert powerOfTwo(exponent+1) == 32768;
    ParentNumeral_14(index, bound);
  }
  if exponent == 15 {
    assert powerOfTwo(exponent) == 32768;
    assert powerOfTwo(exponent+1) == 65536;
    ParentNumeral_15(index, bound);
  }
  if exponent == 16 {
    assert powerOfTwo(exponent) == 65536;
    assert powerOfTwo(exponent+1) == 131072;
    ParentNumeral_16(index, bound);
  }
  if exponent == 17 {
    assert powerOfTwo(exponent) == 131072;
    assert powerOfTwo(exponent+1) == 262144;
    ParentNumeral_17(index, bound);
  }
  if exponent == 18 {
    assert powerOfTwo(exponent) == 262144;
    assert powerOfTwo(exponent+1) == 524288;
    ParentNumeral_18(index, bound);
  }
  if exponent == 19 {
    assert powerOfTwo(exponent) == 524288;
    assert powerOfTwo(exponent+1) == 1048576;
    ParentNumeral_19(index, bound);
  }
  if exponent == 20 {
    assert powerOfTwo(exponent) == 1048576;
    assert powerOfTwo(exponent+1) == 2097152;
    ParentNumeral_20(index, bound);
  }
  if exponent == 21 {
    assert powerOfTwo(exponent) == 2097152;
    assert powerOfTwo(exponent+1) == 4194304;
    ParentNumeral_21(index, bound);
  }
  if exponent == 22 {
    assert powerOfTwo(exponent) == 4194304;
    assert powerOfTwo(exponent+1) == 8388608;
    ParentNumeral_22(index, bound);
  }
  if exponent == 23 {
    assert powerOfTwo(exponent) == 8388608;
    assert powerOfTwo(exponent+1) == 16777216;
    ParentNumeral_23(index, bound);
  }
  if exponent == 24 {
    assert powerOfTwo(exponent) == 16777216;
    assert powerOfTwo(exponent+1) == 33554432;
    ParentNumeral_24(index, bound);
  }
  if exponent == 25 {
    assert powerOfTwo(exponent) == 33554432;
    assert powerOfTwo(exponent+1) == 67108864;
    ParentNumeral_25(index, bound);
  }
  if exponent == 26 {
    assert powerOfTwo(exponent) == 67108864;
    assert powerOfTwo(exponent+1) == 134217728;
    ParentNumeral_26(index, bound);
  }
  if exponent == 27 {
    assert powerOfTwo(exponent) == 134217728;
    assert powerOfTwo(exponent+1) == 268435456;
    ParentNumeral_27(index, bound);
  }
  if exponent == 28 {
    assert powerOfTwo(exponent) == 268435456;
    assert powerOfTwo(exponent+1) == 536870912;
    ParentNumeral_28(index, bound);
  }
  if exponent == 29 {
    assert powerOfTwo(exponent) == 536870912;
    assert powerOfTwo(exponent+1) == 1073741824;
    ParentNumeral_29(index, bound);
  }

  var candidate := ParentNumeral(index, powerOfTwo(exponent));
  var factor := JSFloorDiv(candidate+1, powerOfTwo(exponent+1));
  PowerFactor(candidate+1, exponent+1);
  assert candidate+1 == factor * powerOfTwo(exponent+1);
  LevelFromOddFactor(candidate, exponent+1, factor);
}

lemma PowerDivides(low: int, high: int)
  requires 0 <= low <= high <= 31
  ensures JSRem(powerOfTwo(high), powerOfTwo(low)) == 0
  decreases high-low
{
  if low < high {
    PowerDivides(low, high-1);
    TwiceMultiple(powerOfTwo(high-1), low);
  }
}

lemma LevelAtTop(index: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) == rootLevel
  ensures index == powerOfTwo(rootLevel)-1
{
  FactorOne(index+1, rootLevel);
}

lemma LevelBelowRoot(index: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires index != powerOfTwo(rootLevel)-1
  ensures nodeLevel(index) < rootLevel
{
  var actual := nodeLevel(index);
  if actual > rootLevel {
    PowerOrder(rootLevel+1, actual);
  } else if actual == rootLevel {
    LevelAtTop(index, rootLevel);
  }
}

lemma ParentWithinFacts(index: int, width: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires powerOfTwo(rootLevel) <= width < 2*powerOfTwo(rootLevel)
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) < rootLevel
  ensures 0 <= parentStep(index) < 2*powerOfTwo(rootLevel)-1
  ensures nodeLevel(parentStep(index)) <= rootLevel
  ensures parentStep(index) >= width ==> nodeLevel(parentStep(index)) < rootLevel
{
  var exponent := nodeLevel(index);
  PowerDivides(exponent+2, rootLevel+1);
  assert powerOfTwo(exponent+2) == 4*powerOfTwo(exponent);
  assert powerOfTwo(rootLevel+1) == 2*powerOfTwo(rootLevel);
  ParentStepFacts(index, exponent, 2*powerOfTwo(rootLevel));
  ParentStepForm(index);
  if nodeLevel(parentStep(index)) == rootLevel {
    LevelAtTop(parentStep(index), rootLevel);
  }
}

lemma RightIndexBound(index: int, exponent: int)
  requires 0 <= index <= 2147483646 && 1 <= exponent <= 30
  requires JSRem(index+1, powerOfTwo(exponent)) == 0
  ensures index + powerOfTwo(exponent-1) <= 2147483646
{
  reveal powerOfTwo();
  if exponent == 1 {
    assert powerOfTwo(exponent) == 2;
    assert powerOfTwo(exponent-1) == 1;
    RightBound_1(index);
  }
  if exponent == 2 {
    assert powerOfTwo(exponent) == 4;
    assert powerOfTwo(exponent-1) == 2;
    RightBound_2(index);
  }
  if exponent == 3 {
    assert powerOfTwo(exponent) == 8;
    assert powerOfTwo(exponent-1) == 4;
    RightBound_3(index);
  }
  if exponent == 4 {
    assert powerOfTwo(exponent) == 16;
    assert powerOfTwo(exponent-1) == 8;
    RightBound_4(index);
  }
  if exponent == 5 {
