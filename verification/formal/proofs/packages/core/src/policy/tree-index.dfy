  @IsolateAssertions
  lemma ParentNumeral_0(index: int, bound: int)
    requires 0 <= index <= 2147483646
    requires JSRem(index+1, 1) == 0
    requires JSRem(JSFloorDiv(index+1, 1), 2) == 1
    requires index+1 < bound <= 2147483648
    requires bound % 4 == 0
    ensures 0 <= ParentNumeral(index, 1) < bound-1
    ensures JSRem(ParentNumeral(index, 1)+1, 2) == 0
    ensures JSRem(JSFloorDiv(ParentNumeral(index, 1)+1, 2), 2) == 1
  {
    var quotient := JSFloorDiv(index+1, 1);
    var block := JSFloorDiv(quotient, 4);
    var blocks := JSFloorDiv(bound, 4);
    assert quotient >= 1 && JSRem(quotient, 2) == 1;
    assert index+1 == quotient*1;
    var residue := quotient % 4;
    assert 0 <= residue < 4;
    assert quotient == 4*block+residue;
    assert residue % 2 == 1;
    assert residue == 1 || residue == 3;
    assert quotient == 4*block+1 || quotient == 4*block+3;
