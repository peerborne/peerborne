    requires 0 <= index <= 2147483646
    requires JSRem(index+1, 2) == 0
    requires JSRem(JSFloorDiv(index+1, 2), 2) == 1
    ensures ParentNumeral(index-1, 1) == index
    ensures ParentNumeral(index+1, 1) == index
  {
