lemma InternalNotLast(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures index+1 < treeWidth(leaves)
{
  treeWidth_ensures(leaves);
  nodeLevel_ensures(index);
  if index+1 == treeWidth(leaves) {
    assert index == 2*leaves-2;
    assert JSRem(index, 2) == 0;
    assert false;
  }
}

module Numeric {

  lemma OddRemainder(block: int)
    requires block >= 0
    ensures JSRem(2*block+1, 2) == 1
  {
    assert 2*block+1 > 0;
    assert (2*block+1) % 2 == 1;
  }

  function JSFloorDiv(a: int, b: int): int
    requires b != 0
  {
    if b > 0 then
      if a >= 0 then a / b
      else -((-a - 1) / b) - 1
    else
      if a <= 0 then (-a) / (-b)
      else -((a - 1) / (-b)) - 1
  }

  function JSRem(a: int, b: int): int
    requires b != 0
  {
    var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
    if a < 0 then -r else r
  }

  opaque
  function ParentNumeral(index: int, step: int): int
    requires step > 0
  {
    if JSRem(JSFloorDiv(index, 2*step), 2) == 0 then index+step else index-step
  }

  lemma DoubleMultiple_0(x: int)
    requires x >= 1
    requires JSRem(x, 1) == 0
    requires JSRem(JSFloorDiv(x, 1), 2) == 1
    ensures JSRem(2*x, 2) == 0
    ensures JSRem(JSFloorDiv(2*x, 2), 2) == 1
  {
    var quotient := JSFloorDiv(x, 1);
    assert x == quotient*1;
    assert 2*x == quotient*2;
    assert JSFloorDiv(2*x, 2) == quotient;

  }

