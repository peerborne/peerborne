  if exponent == 7 { assert powerOfTwo(exponent) == 128; Numeric.TwiceMultiple_7(x); }
  if exponent == 8 { assert powerOfTwo(exponent) == 256; Numeric.TwiceMultiple_8(x); }
  if exponent == 9 { assert powerOfTwo(exponent) == 512; Numeric.TwiceMultiple_9(x); }
  if exponent == 10 { assert powerOfTwo(exponent) == 1024; Numeric.TwiceMultiple_10(x); }
  if exponent == 11 { assert powerOfTwo(exponent) == 2048; Numeric.TwiceMultiple_11(x); }
  if exponent == 12 { assert powerOfTwo(exponent) == 4096; Numeric.TwiceMultiple_12(x); }
  if exponent == 13 { assert powerOfTwo(exponent) == 8192; Numeric.TwiceMultiple_13(x); }
  if exponent == 14 { assert powerOfTwo(exponent) == 16384; Numeric.TwiceMultiple_14(x); }
  if exponent == 15 { assert powerOfTwo(exponent) == 32768; Numeric.TwiceMultiple_15(x); }
  if exponent == 16 { assert powerOfTwo(exponent) == 65536; Numeric.TwiceMultiple_16(x); }
  if exponent == 17 { assert powerOfTwo(exponent) == 131072; Numeric.TwiceMultiple_17(x); }
  if exponent == 18 { assert powerOfTwo(exponent) == 262144; Numeric.TwiceMultiple_18(x); }
  if exponent == 19 { assert powerOfTwo(exponent) == 524288; Numeric.TwiceMultiple_19(x); }
  if exponent == 20 { assert powerOfTwo(exponent) == 1048576; Numeric.TwiceMultiple_20(x); }
  if exponent == 21 { assert powerOfTwo(exponent) == 2097152; Numeric.TwiceMultiple_21(x); }
  if exponent == 22 { assert powerOfTwo(exponent) == 4194304; Numeric.TwiceMultiple_22(x); }
  if exponent == 23 { assert powerOfTwo(exponent) == 8388608; Numeric.TwiceMultiple_23(x); }
  if exponent == 24 { assert powerOfTwo(exponent) == 16777216; Numeric.TwiceMultiple_24(x); }
