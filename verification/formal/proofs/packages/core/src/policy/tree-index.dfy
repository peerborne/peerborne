lemma FactorOne(value: int, exponent: int)
  requires 0 <= exponent <= 30
  requires powerOfTwo(exponent) <= value < 2*powerOfTwo(exponent)
  requires JSRem(value, powerOfTwo(exponent)) == 0
  ensures value == powerOfTwo(exponent)
{
  reveal powerOfTwo();
  if exponent == 0 { assert powerOfTwo(exponent) == 1; FactorOne_0(value); }
  if exponent == 1 { assert powerOfTwo(exponent) == 2; FactorOne_1(value); }
  if exponent == 2 { assert powerOfTwo(exponent) == 4; FactorOne_2(value); }
  if exponent == 3 { assert powerOfTwo(exponent) == 8; FactorOne_3(value); }
  if exponent == 4 { assert powerOfTwo(exponent) == 16; FactorOne_4(value); }
  if exponent == 5 { assert powerOfTwo(exponent) == 32; FactorOne_5(value); }
  if exponent == 6 { assert powerOfTwo(exponent) == 64; FactorOne_6(value); }
  if exponent == 7 { assert powerOfTwo(exponent) == 128; FactorOne_7(value); }
  if exponent == 8 { assert powerOfTwo(exponent) == 256; FactorOne_8(value); }
  if exponent == 9 { assert powerOfTwo(exponent) == 512; FactorOne_9(value); }
  if exponent == 10 { assert powerOfTwo(exponent) == 1024; FactorOne_10(value); }
  if exponent == 11 { assert powerOfTwo(exponent) == 2048; FactorOne_11(value); }
  if exponent == 12 { assert powerOfTwo(exponent) == 4096; FactorOne_12(value); }
  if exponent == 13 { assert powerOfTwo(exponent) == 8192; FactorOne_13(value); }
  if exponent == 14 { assert powerOfTwo(exponent) == 16384; FactorOne_14(value); }
  if exponent == 15 { assert powerOfTwo(exponent) == 32768; FactorOne_15(value); }
  if exponent == 16 { assert powerOfTwo(exponent) == 65536; FactorOne_16(value); }
  if exponent == 17 { assert powerOfTwo(exponent) == 131072; FactorOne_17(value); }
  if exponent == 18 { assert powerOfTwo(exponent) == 262144; FactorOne_18(value); }
  if exponent == 19 { assert powerOfTwo(exponent) == 524288; FactorOne_19(value); }
  if exponent == 20 { assert powerOfTwo(exponent) == 1048576; FactorOne_20(value); }
  if exponent == 21 { assert powerOfTwo(exponent) == 2097152; FactorOne_21(value); }
  if exponent == 22 { assert powerOfTwo(exponent) == 4194304; FactorOne_22(value); }
  if exponent == 23 { assert powerOfTwo(exponent) == 8388608; FactorOne_23(value); }
  if exponent == 24 { assert powerOfTwo(exponent) == 16777216; FactorOne_24(value); }
  if exponent == 25 { assert powerOfTwo(exponent) == 33554432; FactorOne_25(value); }
  if exponent == 26 { assert powerOfTwo(exponent) == 67108864; FactorOne_26(value); }
  if exponent == 27 { assert powerOfTwo(exponent) == 134217728; FactorOne_27(value); }
  if exponent == 28 { assert powerOfTwo(exponent) == 268435456; FactorOne_28(value); }
  if exponent == 29 { assert powerOfTwo(exponent) == 536870912; FactorOne_29(value); }
  if exponent == 30 { assert powerOfTwo(exponent) == 1073741824; FactorOne_30(value); }
}

