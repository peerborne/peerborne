lemma TwiceMultiple(x: int, exponent: int)
  requires 0 <= exponent <= 31
  requires x >= 1 && JSRem(x, powerOfTwo(exponent)) == 0
  ensures JSRem(2*x, powerOfTwo(exponent)) == 0
{
  reveal powerOfTwo();
  if exponent == 0 { assert powerOfTwo(exponent) == 1; Numeric.TwiceMultiple_0(x); }
  if exponent == 1 { assert powerOfTwo(exponent) == 2; Numeric.TwiceMultiple_1(x); }
  if exponent == 2 { assert powerOfTwo(exponent) == 4; Numeric.TwiceMultiple_2(x); }
