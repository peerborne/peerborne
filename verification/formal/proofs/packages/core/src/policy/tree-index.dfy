  if exponent == 29 { assert powerOfTwo(exponent) == 536870912; Numeric.TwiceMultiple_29(x); }
  if exponent == 30 { assert powerOfTwo(exponent) == 1073741824; Numeric.TwiceMultiple_30(x); }
  if exponent == 31 { assert powerOfTwo(exponent) == 2147483648; Numeric.TwiceMultiple_31(x); }
}

























































































































































































lemma FactorOne(value: int, exponent: int)
  requires 0 <= exponent <= 30
  requires powerOfTwo(exponent) <= value < 2*powerOfTwo(exponent)
  requires JSRem(value, powerOfTwo(exponent)) == 0
  ensures value == powerOfTwo(exponent)
{
  reveal powerOfTwo();
  if exponent == 0 { assert powerOfTwo(exponent) == 1; Numeric.FactorOne_0(value); }
  if exponent == 1 { assert powerOfTwo(exponent) == 2; Numeric.FactorOne_1(value); }
  if exponent == 2 { assert powerOfTwo(exponent) == 4; Numeric.FactorOne_2(value); }
