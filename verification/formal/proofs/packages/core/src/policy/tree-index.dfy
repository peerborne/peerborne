    assert JSRem(JSFloorDiv(index-1, 2), 2) == 0;
    assert JSRem(JSFloorDiv(index+1, 2), 2) == 1;
    reveal ParentNumeral();
    assert ParentNumeral(index-1, 1) == index;
    assert ParentNumeral(index+1, 1) == index;
  }

