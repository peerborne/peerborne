lemma PowerOrder(low: int, high: int)
  requires 0 <= low <= high <= 31
  ensures powerOfTwo(low) <= powerOfTwo(high)
  ensures low < high ==> powerOfTwo(low) < powerOfTwo(high)
  decreases high - low
{
  if low < high { PowerOrder(low, high-1); }
}

lemma LevelFromOddFactor(index: int, exponent: int, factor: int)
  requires 0 <= index <= 2147483646
  requires 0 <= exponent <= 30
  requires factor >= 1 && factor % 2 == 1
  requires index + 1 == factor * powerOfTwo(exponent)
  ensures nodeLevel(index) == exponent
  decreases exponent
{
  reveal nodeLevel();
  if exponent == 0 {
    assert powerOfTwo(exponent) == 1;
    assert index % 2 == 0;
  } else {
    assert powerOfTwo(exponent) == 2 * powerOfTwo(exponent-1);
    assert index + 1 == 2 * (factor * powerOfTwo(exponent-1));
    assert index % 2 == 1;
    var half := JSFloorDiv(index-1, 2);
    assert half + 1 == factor * powerOfTwo(exponent-1);
    LevelFromOddFactor(half, exponent-1, factor);
  }
}

@IsolateAssertions
lemma LeftLevelFacts(index: int)
  requires 0 <= index <= 2147483646 && nodeLevel(index) > 0
  ensures 0 <= index - powerOfTwo(nodeLevel(index)-1) < index
  ensures nodeLevel(index - powerOfTwo(nodeLevel(index)-1)) == nodeLevel(index)-1
{
  var exponent := nodeLevel(index);
  PowerFactor(index+1, exponent);
  var factor := JSFloorDiv(index+1, powerOfTwo(exponent));
  assert factor >= 1 && factor % 2 == 1;
  assert index+1 == factor * powerOfTwo(exponent);
  assert {:split_here} true;
  powerOfTwo_ensures(exponent);
  assert powerOfTwo(exponent) == 2*powerOfTwo(exponent-1);
  ShiftProduct(factor, powerOfTwo(exponent-1), -1);
  var child := index - powerOfTwo(exponent-1);
  assert child+1 == (2*factor-1) * powerOfTwo(exponent-1);
  assert {:split_here} true;
  LevelFromOddFactor(child, exponent-1, 2*factor-1);
}

@IsolateAssertions
lemma RightLevelFacts(index: int)
  requires 0 <= index <= 2147483646 && nodeLevel(index) > 0
  ensures index < index + powerOfTwo(nodeLevel(index)-1) <= 2147483646
  ensures nodeLevel(index + powerOfTwo(nodeLevel(index)-1)) == nodeLevel(index)-1
{
  var exponent := nodeLevel(index);
  PowerFactor(index+1, exponent);
  var factor := JSFloorDiv(index+1, powerOfTwo(exponent));
  assert factor >= 1 && factor % 2 == 1;
  assert index+1 == factor * powerOfTwo(exponent);
  RightIndexBound(index, exponent);
  assert {:split_here} true;
  powerOfTwo_ensures(exponent);
  assert powerOfTwo(exponent) == 2*powerOfTwo(exponent-1);
  ShiftProduct(factor, powerOfTwo(exponent-1), 1);
  var child := index + powerOfTwo(exponent-1);
  assert child+1 == (2*factor+1) * powerOfTwo(exponent-1);
  assert {:split_here} true;
  LevelFromOddFactor(child, exponent-1, 2*factor+1);
}

lemma ClampRightFacts(index: int, width: int)
  requires 0 <= index <= 2147483646
  requires 1 <= width <= 2147483647
  requires index - powerOfTwo(nodeLevel(index)) + 1 < width
  ensures index >= width ==> nodeLevel(index) > 0
  ensures index >= width ==> leftChild(index) - powerOfTwo(nodeLevel(leftChild(index))) + 1 < width
{
  if nodeLevel(index) == 0 { assert powerOfTwo(0) == 1; }
}

