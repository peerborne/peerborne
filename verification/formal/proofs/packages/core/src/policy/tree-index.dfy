lemma RightWithinCompleteTree(index: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires 0 < nodeLevel(index) <= rootLevel
  ensures rightChild(index) < 2*powerOfTwo(rootLevel)-1
{
  reveal powerOfTwo();
  var exponent := nodeLevel(index);
  PowerDivides(exponent, rootLevel+1);
  assert powerOfTwo(rootLevel+1) == 2*powerOfTwo(rootLevel);
  if exponent == 1 {
    assert powerOfTwo(exponent) == 2;
    assert powerOfTwo(exponent-1) == 1;
    RightWithin_1(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 2 {
    assert powerOfTwo(exponent) == 4;
    assert powerOfTwo(exponent-1) == 2;
    RightWithin_2(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 3 {
    assert powerOfTwo(exponent) == 8;
    assert powerOfTwo(exponent-1) == 4;
    RightWithin_3(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 4 {
    assert powerOfTwo(exponent) == 16;
    assert powerOfTwo(exponent-1) == 8;
    RightWithin_4(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 5 {
    assert powerOfTwo(exponent) == 32;
    assert powerOfTwo(exponent-1) == 16;
    RightWithin_5(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 6 {
    assert powerOfTwo(exponent) == 64;
    assert powerOfTwo(exponent-1) == 32;
    RightWithin_6(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 7 {
    assert powerOfTwo(exponent) == 128;
    assert powerOfTwo(exponent-1) == 64;
    RightWithin_7(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 8 {
    assert powerOfTwo(exponent) == 256;
    assert powerOfTwo(exponent-1) == 128;
    RightWithin_8(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 9 {
    assert powerOfTwo(exponent) == 512;
    assert powerOfTwo(exponent-1) == 256;
    RightWithin_9(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 10 {
    assert powerOfTwo(exponent) == 1024;
    assert powerOfTwo(exponent-1) == 512;
    RightWithin_10(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 11 {
    assert powerOfTwo(exponent) == 2048;
    assert powerOfTwo(exponent-1) == 1024;
    RightWithin_11(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 12 {
    assert powerOfTwo(exponent) == 4096;
    assert powerOfTwo(exponent-1) == 2048;
    RightWithin_12(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 13 {
    assert powerOfTwo(exponent) == 8192;
    assert powerOfTwo(exponent-1) == 4096;
    RightWithin_13(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 14 {
    assert powerOfTwo(exponent) == 16384;
    assert powerOfTwo(exponent-1) == 8192;
    RightWithin_14(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 15 {
    assert powerOfTwo(exponent) == 32768;
    assert powerOfTwo(exponent-1) == 16384;
    RightWithin_15(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 16 {
    assert powerOfTwo(exponent) == 65536;
    assert powerOfTwo(exponent-1) == 32768;
    RightWithin_16(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 17 {
    assert powerOfTwo(exponent) == 131072;
    assert powerOfTwo(exponent-1) == 65536;
    RightWithin_17(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 18 {
    assert powerOfTwo(exponent) == 262144;
    assert powerOfTwo(exponent-1) == 131072;
    RightWithin_18(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 19 {
    assert powerOfTwo(exponent) == 524288;
    assert powerOfTwo(exponent-1) == 262144;
    RightWithin_19(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 20 {
    assert powerOfTwo(exponent) == 1048576;
    assert powerOfTwo(exponent-1) == 524288;
    RightWithin_20(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 21 {
    assert powerOfTwo(exponent) == 2097152;
    assert powerOfTwo(exponent-1) == 1048576;
    RightWithin_21(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 22 {
    assert powerOfTwo(exponent) == 4194304;
    assert powerOfTwo(exponent-1) == 2097152;
    RightWithin_22(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 23 {
    assert powerOfTwo(exponent) == 8388608;
    assert powerOfTwo(exponent-1) == 4194304;
    RightWithin_23(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 24 {
    assert powerOfTwo(exponent) == 16777216;
    assert powerOfTwo(exponent-1) == 8388608;
    RightWithin_24(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 25 {
    assert powerOfTwo(exponent) == 33554432;
    assert powerOfTwo(exponent-1) == 16777216;
    RightWithin_25(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 26 {
    assert powerOfTwo(exponent) == 67108864;
    assert powerOfTwo(exponent-1) == 33554432;
    RightWithin_26(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 27 {
    assert powerOfTwo(exponent) == 134217728;
    assert powerOfTwo(exponent-1) == 67108864;
    RightWithin_27(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 28 {
    assert powerOfTwo(exponent) == 268435456;
    assert powerOfTwo(exponent-1) == 134217728;
    RightWithin_28(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 29 {
    assert powerOfTwo(exponent) == 536870912;
    assert powerOfTwo(exponent-1) == 268435456;
    RightWithin_29(index, 2*powerOfTwo(rootLevel));
  }
  if exponent == 30 {
    assert powerOfTwo(exponent) == 1073741824;
    assert powerOfTwo(exponent-1) == 536870912;
    RightWithin_30(index, 2*powerOfTwo(rootLevel));
  }
}

lemma ClampRightAscends(index: int, width: int, rootLevel: int)
  requires 0 <= rootLevel <= 30
  requires powerOfTwo(rootLevel) <= width < 2*powerOfTwo(rootLevel)
  requires 0 <= index < 2*powerOfTwo(rootLevel)-1
  requires nodeLevel(index) < rootLevel
  requires index - powerOfTwo(nodeLevel(index)) + 1 < width
  ensures parentInWidth(clampRightChild(index, width), width, rootLevel) == parentInWidth(index, width, rootLevel)
  decreases nodeLevel(index)
{
  reveal clampRightChild();
  if index >= width {
    ClampRightFacts(index, width);
    tree_child_parent(index);
    ClampRightAscends(leftChild(index), width, rootLevel);
    reveal parentInWidth();
  }
}

lemma tree_left_parent(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures treeParent(leftChild(index), leaves) == index
{
  var rootLevel := floorLog2(treeWidth(leaves));
  if index != treeRoot(leaves) { LevelBelowRoot(index, rootLevel); }
  tree_child_parent(index);
  reveal treeParent();
  reveal parentInWidth();
}

lemma tree_right_parent(index: int, leaves: int)
  requires 1 <= leaves <= 1073741824
  requires 0 <= index < treeWidth(leaves) && nodeLevel(index) > 0
  ensures treeParent(treeRight(index, leaves), leaves) == index
{
  var rootLevel := floorLog2(treeWidth(leaves));
  if index != treeRoot(leaves) { LevelBelowRoot(index, rootLevel); }
  RightWithinCompleteTree(index, rootLevel);
  tree_child_parent(index);
  InternalNotLast(index, leaves);
  ClampRightAscends(rightChild(index), treeWidth(leaves), rootLevel);
  reveal treeRight();
  reveal treeParent();
  reveal parentInWidth();
}

method treeIndex_domain()
{
  reveal powerOfTwo();
  assert treeRoot(1) == 0;
  assert treeRoot(5) == 7;
  assert treeWidth(1073741824) == 2147483647;
  assert leafPosition(leafNodeIndex(1073741823)) == 1073741823;
  var path := treeDirectPath(8, 5);
  var co := treeCopath(8, 5);
  assert |path| == |co| && 0 < |path| <= 30;
  assert path[|path|-1] == treeRoot(5);
}

