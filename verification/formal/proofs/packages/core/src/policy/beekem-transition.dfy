datatype BeeKEMGenerationDisposition = stale | duplicate | fork | next | gap

function classifyBeeKEMGeneration(current: int, incoming: int, sameUpdateDigest: bool): BeeKEMGenerationDisposition
  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
{
  if (incoming < current) then
    BeeKEMGenerationDisposition.stale
  else
    if (incoming == current) then
      if sameUpdateDigest then
        BeeKEMGenerationDisposition.duplicate
      else
        BeeKEMGenerationDisposition.fork
    else
      if (incoming == (current + 1)) then
        BeeKEMGenerationDisposition.next
      else
        BeeKEMGenerationDisposition.gap
}

lemma classifyBeeKEMGeneration_ensures(current: int, incoming: int, sameUpdateDigest: bool)
  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
  ensures (classifyBeeKEMGeneration(current, incoming, sameUpdateDigest).stale? <==> (incoming < current))
  ensures (classifyBeeKEMGeneration(current, incoming, sameUpdateDigest).duplicate? <==> ((incoming == current) && sameUpdateDigest))
  ensures (classifyBeeKEMGeneration(current, incoming, sameUpdateDigest).fork? <==> ((incoming == current) && !(sameUpdateDigest)))
  ensures (classifyBeeKEMGeneration(current, incoming, sameUpdateDigest).next? <==> (incoming == (current + 1)))
  ensures (classifyBeeKEMGeneration(current, incoming, sameUpdateDigest).gap? <==> (incoming > (current + 1)))
{
}

function isCompetingBeeKEMEpoch(current: int, incoming: int, sameAcceptedParent: bool, validatedDifferentTree: bool): bool
  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
{
  (((incoming == current) && sameAcceptedParent) && validatedDifferentTree)
}

