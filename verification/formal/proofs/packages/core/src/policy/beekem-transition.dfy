  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
  ensures (canCommitBeeKEMPathUpdate(current, incoming, sameParent, sameWriters) <==> (((incoming == (current + 1)) && sameParent) && sameWriters))
