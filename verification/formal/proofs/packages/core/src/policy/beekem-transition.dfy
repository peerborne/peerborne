  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
  ensures (isCompetingBeeKEMEpoch(current, incoming, sameAcceptedParent, validatedDifferentTree) <==> (((incoming == current) && sameAcceptedParent) && validatedDifferentTree))
{
}

function isAppendOnlyLeafCount(current: int, incoming: int, capacity: int): bool
  requires (1 <= current)
  requires (current <= capacity)
  requires (capacity < 9007199254740991)
  requires (1 <= incoming)
  requires (incoming <= 9007199254740991)
{
  ((incoming <= capacity) && ((incoming == current) || (incoming == (current + 1))))
}

lemma isAppendOnlyLeafCount_ensures(current: int, incoming: int, capacity: int)
  requires (1 <= current)
  requires (current <= capacity)
  requires (capacity < 9007199254740991)
  requires (1 <= incoming)
  requires (incoming <= 9007199254740991)
  ensures (isAppendOnlyLeafCount(current, incoming, capacity) <==> ((incoming <= capacity) && ((incoming == current) || (incoming == (current + 1)))))
  ensures (isAppendOnlyLeafCount(current, incoming, capacity) ==> (((current <= incoming) && (incoming <= (current + 1))) && (incoming <= capacity)))
  ensures ((current == capacity) ==> isAppendOnlyLeafCount(current, incoming, capacity) ==> (incoming == current))
{
}

function canCommitBeeKEMPathUpdate(current: int, incoming: int, sameParent: bool, sameWriters: bool): bool
  requires (0 <= current)
  requires (current <= 4294967295)
  requires (1 <= incoming)
  requires (incoming <= 4294967295)
{
  ((classifyBeeKEMGeneration(current, incoming, false).next? && sameParent) && sameWriters)
}

