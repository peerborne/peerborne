function ChunkBytes(chunks: seq<int>): int
  decreases |chunks|
{
  if |chunks| == 0 then 0 else ChunkBytes(chunks[..|chunks|-1]) + chunks[|chunks|-1]
}

method frameLayout_chunks(expected: int, chunks: seq<int>) returns (received: int)
  requires 0 <= expected <= 4294967295
  requires forall i :: 0 <= i < |chunks| ==> 0 <= chunks[i] <= 9007199254740991
  ensures 0 <= received <= expected
  ensures received == (if ChunkBytes(chunks) < expected then ChunkBytes(chunks) else expected)
{
  var index := 0;
  received := 0;
  while index < |chunks|
    invariant 0 <= index <= |chunks|
    invariant 0 <= received <= expected
    invariant received == (if ChunkBytes(chunks[..index]) < expected then ChunkBytes(chunks[..index]) else expected)
    decreases |chunks| - index
  {
    var prefix := chunks[..index+1];
    assert prefix[..|prefix|-1] == chunks[..index];
    assert prefix[|prefix|-1] == chunks[index];
    received := received + frameCopyLength(received, expected, chunks[index]);
    index := index + 1;
  }
  assert chunks[..index] == chunks;
}

method frameLayout_domain()
{
  assert boundedFieldEnd(16, 4, 8, 1, 8, 4) == 12;
  assert boundedFieldEnd(16, 4, 9, 1, 9, 4) == -1;
  assert boundedFieldEnd(4294967295, 4294967294, 1, 0, 4294967295, 0) == 4294967295;
  assert frameCopyLength(0, 4294967295, 9007199254740991) == 4294967295;
  assert frameCopyLength(3, 4, 0) == 0;
  frameLayout_disjoint(16, 4, 3, 5, 4, 6, 7);
  var received := frameLayout_chunks(7, [0, 1, 0, 3, 8]);
}

datatype DocumentWriteAttempt = DocumentWriteAttempt(length: int, maximum: int, framed: bool, copySucceeded: bool)

method documentWrite_step(capacity: int, used: int, length: int, maximum: int, framed: bool, copySucceeded: bool)
  returns (next: int, copied: int, parts: int, accepted: bool)
  requires 0 <= capacity <= 4294967295
  requires 0 <= used <= capacity
  requires 0 <= length <= 4294967295
  requires 0 <= maximum <= 4294967295
  ensures accepted <==> copySucceeded && length <= maximum && length + (if framed then 4 else 0) <= capacity - used
  ensures used <= next <= capacity
  ensures !accepted ==> next == used && copied == 0 && parts == 0
  ensures accepted ==> next == used + length + (if framed then 4 else 0) && copied == length
  ensures accepted ==> parts == (if framed then 1 else 0) + (if length > 0 then 1 else 0)
  ensures 0 <= copied <= next - used
  ensures 0 <= parts <= 2 && parts <= next - used
{
  planDocumentFieldWrite_ensures(capacity, used, length, maximum, framed);
  var plan := planDocumentFieldWrite(capacity, used, length, maximum, framed);
  if !plan.valid || !copySucceeded {
    return used, 0, 0, false;
  }
  return plan.end, plan.copyBytes, plan.parts, true;
}

method documentWrite_all_histories(capacity: int, initial: int, attempts: seq<DocumentWriteAttempt>)
  returns (used: int, copied: int, parts: int, accepted: int, framed: int)
  requires 0 <= capacity <= 4294967295
  requires 0 <= initial <= capacity
  requires forall i :: 0 <= i < |attempts| ==> 0 <= attempts[i].length <= 4294967295 && 0 <= attempts[i].maximum <= 4294967295
  ensures initial <= used <= capacity
  ensures used == initial + copied + 4 * framed
  ensures 0 <= copied <= used - initial
  ensures 0 <= parts <= used - initial && parts <= 2 * accepted
  ensures 0 <= framed <= accepted <= |attempts|
{
  used := initial;
  copied, parts, accepted, framed := 0, 0, 0, 0;
  var index := 0;
  while index < |attempts|
    invariant 0 <= index <= |attempts|
    invariant initial <= used <= capacity
    invariant used == initial + copied + 4 * framed
    invariant 0 <= copied <= used - initial
    invariant 0 <= parts <= used - initial && parts <= 2 * accepted
    invariant 0 <= framed <= accepted <= index
    decreases |attempts| - index
  {
    var attempt := attempts[index];
    var next, payload, chunks, admitted := documentWrite_step(capacity, used, attempt.length, attempt.maximum, attempt.framed, attempt.copySucceeded);
    if admitted {
      accepted := accepted + 1;
      if attempt.framed { framed := framed + 1; }
    }
    used := next;
    copied := copied + payload;
    parts := parts + chunks;
    index := index + 1;
  }
}

method documentWrite_domain()
{
  var empty := planDocumentFieldWrite(0, 0, 0, 0, false);
  assert empty.valid && empty.end == 0 && empty.copyBytes == 0 && empty.parts == 0;
  var prefixed := planDocumentFieldWrite(4, 0, 0, 0, true);
  assert prefixed.valid && prefixed.end == 4 && prefixed.parts == 1;
  var rejected := planDocumentFieldWrite(3, 0, 0, 0, true);
  assert !rejected.valid && rejected.end == 0 && rejected.copyBytes == 0 && rejected.parts == 0;
  var full := planDocumentFieldWrite(4294967295, 0, 4294967295, 4294967295, false);
  assert full.valid && full.end == 4294967295 && full.copyBytes == 4294967295 && full.parts == 1;
  var last := planDocumentFieldWrite(4294967295, 4294967291, 0, 0, true);
  assert last.valid && last.end == 4294967295 && last.parts == 1;
  var failed, failedCopy, failedParts, failedAccepted := documentWrite_step(8, 1, 2, 8, true, false);
  assert failed == 1 && failedCopy == 0 && failedParts == 0 && !failedAccepted;
  var used, copied, parts, accepted, framed := documentWrite_all_histories(9, 1, [
    DocumentWriteAttempt(0, 0, false, true), DocumentWriteAttempt(2, 2, true, true),
    DocumentWriteAttempt(0, 0, true, true), DocumentWriteAttempt(2, 2, false, false),
    DocumentWriteAttempt(2, 2, false, true), DocumentWriteAttempt(0, 0, false, true)
  ]);
  assert 1 <= used <= 9 && used == 1 + copied + 4 * framed && parts <= used - 1 && parts <= 2 * accepted;
  var first, firstCopy, firstParts, firstAccepted := documentWrite_step(9, 1, 2, 2, true, true);
  assert first == 7 && firstCopy == 2 && firstParts == 2 && firstAccepted;
  var over, overCopy, overParts, overAccepted := documentWrite_step(9, first, 0, 0, true, true);
  assert over == first && overCopy == 0 && overParts == 0 && !overAccepted;
  var final, finalCopy, finalParts, finalAccepted := documentWrite_step(9, over, 2, 2, false, true);
  assert final == 9 && finalCopy == 2 && finalParts == 1 && finalAccepted;
}

datatype JournalReadAttempt = JournalReadAttempt(length: int, exact: bool, copySucceeded: bool)

opaque predicate JournalReadRejected(declared: int, copied: int, event: JournalReadAttempt)
  requires 0 <= declared <= 134217728
  requires 0 <= copied <= declared
  requires 0 <= event.length <= 4294967295
{
  event.length == 0 || !event.copySucceeded ||
  boundedFieldEnd(declared, copied, event.length, if event.exact then declared else 1, if event.exact then declared else 134217728, 0) == -1
}

method journalRead_step(declared: int, copied: int, length: int, exact: bool, alreadyFailed: bool, copySucceeded: bool)
  returns (next: int, failed: bool)
  requires 0 <= declared <= 134217728
  requires 0 <= copied <= declared
  requires 0 <= length <= 4294967295
  ensures copied <= next <= declared
  ensures alreadyFailed ==> failed
  ensures failed ==> next == copied
  ensures !failed ==> copySucceeded && 1 <= length <= 134217728 && next == copied + length && copied < next
  ensures !failed && exact ==> length == declared
  ensures failed <==> alreadyFailed || length == 0 || !copySucceeded || length > 134217728 || length > declared - copied || (exact && length != declared)
  ensures failed <==> alreadyFailed || JournalReadRejected(declared, copied, JournalReadAttempt(length, exact, copySucceeded))
{
  reveal JournalReadRejected();
  if alreadyFailed || length == 0 {
    return copied, true;
  }
  var end := boundedFieldEnd(declared, copied, length, if exact then declared else 1, if exact then declared else 134217728, 0);
  if end < 0 || !copySucceeded {
    return copied, true;
  }
  return end, false;
}

method {:isolate_assertions} journalRead_all_histories(declared: int, attempts: seq<JournalReadAttempt>)
  returns (copied: int, accepted: seq<int>, failed: bool)
  requires 0 <= declared <= 134217728
  requires forall i :: 0 <= i < |attempts| ==> 0 <= attempts[i].length <= 4294967295
  ensures 0 <= copied <= declared
  ensures copied == ChunkBytes(accepted)
  ensures |accepted| <= copied && |accepted| <= |attempts|
  ensures forall i :: 0 <= i < |accepted| ==> 1 <= accepted[i] <= 134217728
  ensures failed <==> |accepted| < |attempts|
  ensures forall i :: 0 <= i < |accepted| ==> accepted[i] == attempts[i].length && attempts[i].copySucceeded && (attempts[i].exact ==> accepted[i] == declared)
  ensures failed ==> JournalReadRejected(declared, copied, attempts[|accepted|])
{
  copied := 0;
  accepted := [];
  failed := false;
  var index := 0;
  while index < |attempts|
    invariant 0 <= index <= |attempts|
    invariant 0 <= copied <= declared
    invariant copied == ChunkBytes(accepted)
    invariant |accepted| <= copied && |accepted| <= index
    invariant forall i :: 0 <= i < |accepted| ==> 1 <= accepted[i] <= 134217728
    invariant failed <==> |accepted| < index
    invariant forall i :: 0 <= i < |accepted| ==> accepted[i] == attempts[i].length && attempts[i].copySucceeded && (attempts[i].exact ==> accepted[i] == declared)
    invariant failed ==> JournalReadRejected(declared, copied, attempts[|accepted|])
    decreases |attempts| - index
  {
    var event := attempts[index];
    var next, stopped := journalRead_step(declared, copied, event.length, event.exact, failed, event.copySucceeded);
    if !stopped {
      assert !failed && |accepted| == index;
      var previous := accepted;
      accepted := accepted + [event.length];
      assert accepted[..|accepted|-1] == previous;
      assert accepted[|accepted|-1] == event.length;
    } else if !failed {
      assert |accepted| == index;
      assert JournalReadRejected(declared, copied, attempts[|accepted|]);
    }
    copied := next;
    failed := stopped;
    index := index + 1;
  }
}

method journalRead_batch_bound(declared: int, attempts: seq<JournalReadAttempt>)
  returns (copied: int, accepted: seq<int>, failed: bool)
  requires 0 <= declared <= 134217728
  requires |attempts| <= 128
  requires forall i :: 0 <= i < |attempts| ==> 0 <= attempts[i].length <= 4294967295
  ensures 0 <= copied <= declared <= 134217728
  ensures |accepted| <= 128
  ensures copied == ChunkBytes(accepted)
  ensures |accepted| <= |attempts|
  ensures failed <==> |accepted| < |attempts|
  ensures forall i :: 0 <= i < |accepted| ==> accepted[i] == attempts[i].length && attempts[i].copySucceeded && (attempts[i].exact ==> accepted[i] == declared)
  ensures failed ==> JournalReadRejected(declared, copied, attempts[|accepted|])
{
  copied, accepted, failed := journalRead_all_histories(declared, attempts);
}

method journalRead_domain()
{
  reveal JournalReadRejected();
  var first, live := journalRead_step(5, 0, 3, false, false, true);
  assert first == 3 && !live;
  var second, stopped := journalRead_step(5, first, 3, false, live, true);
  assert second == 3 && stopped;
  var third, terminal := journalRead_step(5, second, 1, false, stopped, true);
  assert third == 3 && terminal;
  var exact, exactFailed := journalRead_step(5, 0, 5, true, false, true);
  assert exact == 5 && !exactFailed;
  var mismatch, mismatchFailed := journalRead_step(5, 0, 4, true, false, true);
  assert mismatch == 0 && mismatchFailed;
  var failedCopy, copyFailed := journalRead_step(5, 0, 4, false, false, false);
  assert failedCopy == 0 && copyFailed;
  var attempts := [JournalReadAttempt(3, false, true), JournalReadAttempt(3, false, true), JournalReadAttempt(1, false, true)];
  assert ChunkBytes([]) == 0;
  assert ChunkBytes([3]) == 3;
  assert ChunkBytes([3, 3]) == 6;
  assert ChunkBytes([3, 3, 1]) == 7;
  var copied, accepted, failed := journalRead_batch_bound(5, attempts);
  assert 0 <= copied <= 5 && |accepted| <= 128;
  if |accepted| == 0 {
    assert accepted == [] && copied == 0 && failed;
    assert JournalReadRejected(5, 0, attempts[0]);
  }
  if |accepted| >= 2 {
    assert accepted[0] == 3 && accepted[1] == 3;
    if |accepted| == 2 {
      assert accepted == [3, 3];
    } else {
      assert |accepted| == 3 && accepted[2] == 1;
      assert accepted == [3, 3, 1];
    }
    assert copied >= 6;
  }
  assert |accepted| == 1 && accepted[0] == 3;
  assert copied == 3 && accepted == [3] && failed;
}
