function boundedFieldEnd(total: int, offset: int, length: int, minimum: int, maximum: int, trailer: int): int
  requires (0 <= total)
  requires (total <= 4294967295)
  requires (0 <= offset)
  requires (offset <= total)
  requires (0 <= length)
  requires (length <= 4294967295)
  requires (0 <= minimum)
  requires (minimum <= maximum)
  requires (maximum <= 4294967295)
  requires (0 <= trailer)
  requires (trailer <= 4294967295)
{
  if ((((length < minimum) || (length > maximum)) || (trailer > (total - offset))) || (length > ((total - offset) - trailer))) then
    -1
  else
    (offset + length)
}

