  var payloadEnd := boundedFieldEnd(capacity, used, length, 0, maximum, prefix);
  var valid := (payloadEnd >= 0);
  DocumentFieldWritePlan(valid, (if valid then (payloadEnd + prefix) else used), (if valid then length else 0), (if valid then ((if framed then 1 else 0) + (if (length > 0) then 1 else 0)) else 0))
}

