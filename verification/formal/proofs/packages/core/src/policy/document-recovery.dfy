// Generated by lsc from document-recovery.ts
// lsc options: string-semantics=javascript-utf16

datatype DocumentRecoveryDisposition = ready | already_active | stale

function classifyDocumentRecovery(baseRevision: int, observedRevision: int, baseMatches: bool, successorMatches: bool): DocumentRecoveryDisposition
  requires (0 <= baseRevision)
  requires (baseRevision < MAX_REVISION)
  requires (0 <= observedRevision)
  requires (observedRevision <= MAX_REVISION)
{
  if ((observedRevision == baseRevision) && baseMatches) then
    DocumentRecoveryDisposition.ready
  else
    if ((observedRevision == (baseRevision + 1)) && successorMatches) then
      DocumentRecoveryDisposition.already_active
    else
      DocumentRecoveryDisposition.stale
}

lemma classifyDocumentRecovery_ensures(baseRevision: int, observedRevision: int, baseMatches: bool, successorMatches: bool)
  requires (0 <= baseRevision)
  requires (baseRevision < MAX_REVISION)
  requires (0 <= observedRevision)
  requires (observedRevision <= MAX_REVISION)
  ensures (classifyDocumentRecovery(baseRevision, observedRevision, baseMatches, successorMatches).ready? <==> ((observedRevision == baseRevision) && baseMatches))
  ensures (classifyDocumentRecovery(baseRevision, observedRevision, baseMatches, successorMatches).already_active? <==> ((observedRevision == (baseRevision + 1)) && successorMatches))
  ensures (classifyDocumentRecovery(baseRevision, observedRevision, baseMatches, successorMatches).stale? <==> (!(((observedRevision == baseRevision) && baseMatches)) && !(((observedRevision == (baseRevision + 1)) && successorMatches))))
{
}

function canPublishDocumentRecovery(disposition: DocumentRecoveryDisposition, staged: bool): bool
{
  (disposition.ready? && staged)
}

lemma canPublishDocumentRecovery_ensures(disposition: DocumentRecoveryDisposition, staged: bool)
  ensures (canPublishDocumentRecovery(disposition, staged) <==> (disposition.ready? && staged))
{
}

const MAX_REVISION: int := 9007199254740991

datatype RecoveryLocator = Locator(revision: int, binding: string)
datatype RecoveryAttempt = Attempt(binding: string, authorized: bool, contentMatches: bool, staged: bool, committed: bool)

// The runtime supplies full-locator equality, verified content and durable CAS
// results. A stopped process has no effect beyond a CAS already committed.
function RecoveryStep(base: RecoveryLocator, current: RecoveryLocator, attempt: RecoveryAttempt): RecoveryLocator
  requires 0 <= base.revision < MAX_REVISION
  requires 0 <= current.revision <= MAX_REVISION
  ensures 0 <= RecoveryStep(base, current, attempt).revision <= MAX_REVISION
{
  var decision := classifyDocumentRecovery(
    base.revision, current.revision, current == base,
    current.binding == attempt.binding);
  if attempt.authorized && attempt.contentMatches &&
    canPublishDocumentRecovery(decision, attempt.staged) && attempt.committed
  then Locator(base.revision + 1, attempt.binding)
  else current
}

function RecoveryHistory(base: RecoveryLocator, current: RecoveryLocator, attempts: seq<RecoveryAttempt>): RecoveryLocator
  requires 0 <= base.revision < MAX_REVISION
  requires 0 <= current.revision <= MAX_REVISION
  ensures 0 <= RecoveryHistory(base, current, attempts).revision <= MAX_REVISION
  decreases |attempts|
{
  if |attempts| == 0 then current
  else RecoveryHistory(base, RecoveryStep(base, current, attempts[0]), attempts[1..])
}

lemma documentRecovery_all_histories(base: RecoveryLocator, current: RecoveryLocator, attempts: seq<RecoveryAttempt>)
  requires 0 <= base.revision < MAX_REVISION
  requires 0 <= current.revision <= MAX_REVISION
  ensures RecoveryHistory(base, current, attempts).revision >= current.revision
  ensures current != base ==> RecoveryHistory(base, current, attempts) == current
  ensures RecoveryHistory(base, current, attempts) != current ==>
    RecoveryHistory(base, current, attempts).revision == base.revision + 1
  ensures RecoveryHistory(base, current, attempts) != current ==>
    exists i :: 0 <= i < |attempts| && attempts[i].authorized &&
      attempts[i].contentMatches && attempts[i].staged && attempts[i].committed &&
      attempts[i].binding == RecoveryHistory(base, current, attempts).binding
  decreases |attempts|
{
  if |attempts| > 0 {
    var first := attempts[0];
    var after := RecoveryStep(base, current, first);
    documentRecovery_all_histories(base, after, attempts[1..]);
    if after != current {
      assert after != base;
      assert RecoveryHistory(base, current, attempts) == after;
      assert 0 <= 0 < |attempts|;
    } else if RecoveryHistory(base, current, attempts) != current {
      var i :| 0 <= i < |attempts[1..]| && attempts[1..][i].authorized &&
        attempts[1..][i].contentMatches && attempts[1..][i].staged && attempts[1..][i].committed &&
        attempts[1..][i].binding == RecoveryHistory(base, current, attempts).binding;
      assert attempts[i + 1] == attempts[1..][i];
    }
  }
}

method documentRecovery_domain()
{
  assert classifyDocumentRecovery(0, 0, true, false).ready?;
  assert classifyDocumentRecovery(0, 0, false, true).stale?;
  assert classifyDocumentRecovery(MAX_REVISION - 1, MAX_REVISION, false, true).already_active?;
  assert !canPublishDocumentRecovery(DocumentRecoveryDisposition.ready, false);
  assert canPublishDocumentRecovery(DocumentRecoveryDisposition.ready, true);
  var base := Locator(7, "old");
  var attempts := [Attempt("denied", false, true, true, true),
    Attempt("interrupted", true, true, true, false),
    Attempt("accepted", true, true, true, true),
    Attempt("competing", true, true, true, true),
    Attempt("accepted", true, true, true, true)];
  documentRecovery_all_histories(base, base, attempts);
  assert RecoveryHistory(base, base, attempts) == Locator(8, "accepted");
}
