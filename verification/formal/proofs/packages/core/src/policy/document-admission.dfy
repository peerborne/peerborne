  ensures ((!phase.applying?) ==> (advancePreparedDocumentChange(phase, event).applying? <==> (phase.prepared? && event.begin?)))
  ensures (phase.applying? ==> event.cancel? ==> advancePreparedDocumentChange(phase, event).applying?)
