datatype DocumentBudgetState = DocumentBudgetState(count: int, bytes: int)

predicate ValidDocumentBudget(s: DocumentBudgetState, countLimit: int, byteLimit: int)
{
  0 <= s.count <= countLimit <= 9007199254740991 &&
  0 <= s.bytes <= byteLimit <= 9007199254740991
}

function DocumentBudgetStep(s: DocumentBudgetState, reserve: bool, amount: int, countLimit: int, byteLimit: int): DocumentBudgetState
  requires ValidDocumentBudget(s, countLimit, byteLimit)
  requires 0 <= amount <= 9007199254740991
  ensures ValidDocumentBudget(DocumentBudgetStep(s, reserve, amount, countLimit, byteLimit), countLimit, byteLimit)
{
  if reserve && canReserveDocumentOperation(s.count, s.bytes, amount, countLimit, byteLimit) then
    DocumentBudgetState(s.count+1, s.bytes+amount)
  else if !reserve && s.count > 0 && amount <= s.bytes then
    DocumentBudgetState(s.count-1, releaseDocumentOperationBytes(s.bytes, amount))
  else s
}

function DocumentBudgetHistory(s: DocumentBudgetState, reserves: seq<bool>, amounts: seq<int>, countLimit: int, byteLimit: int): DocumentBudgetState
  requires ValidDocumentBudget(s, countLimit, byteLimit)
  requires |reserves| == |amounts|
  requires forall i :: 0 <= i < |amounts| ==> 0 <= amounts[i] <= 9007199254740991
  ensures ValidDocumentBudget(DocumentBudgetHistory(s, reserves, amounts, countLimit, byteLimit), countLimit, byteLimit)
  decreases |reserves|
