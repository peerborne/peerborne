function advanceDocumentOperation(phase: DocumentOperationPhase, event: DocumentOperationEvent, contextMatches: bool, authorizationMatches: bool): DocumentOperationPhase
{
  if (phase.committed? || phase.cancelled?) then
    phase
  else
    if event.cancel? then
      DocumentOperationPhase.cancelled
    else
      if (event.prepare? && phase.preparing?) then
        DocumentOperationPhase.prepared
      else
        if (event.commit? && phase.prepared?) then
          if (contextMatches && authorizationMatches) then
            DocumentOperationPhase.committed
          else
            phase
        else
          phase
}

