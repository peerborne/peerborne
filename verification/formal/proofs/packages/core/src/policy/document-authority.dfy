function canBindDocumentController<Controller(==)>(controllers: map<string, Controller>, head: string, limit: int): bool
  requires (0 <= limit)
  requires (limit <= 9007199254740991)
{
  ((|controllers| < limit) && !((head in controllers)))
}

lemma canBindDocumentController_ensures<Controller>(controllers: map<string, Controller>, head: string, limit: int)
  requires (0 <= limit)
  requires (limit <= 9007199254740991)
  ensures (canBindDocumentController(controllers, head, limit) <==> ((|controllers| < limit) && !((head in controllers))))
{
}

method documentAuthorityControllerIndex(roles: seq<int>) returns (res: int)
  requires (|roles| <= 4294967295)
  ensures (-1 <= res)
  ensures (res < |roles|)
  ensures ((res >= 0) <==> ((((1 <= |roles|) && (|roles| <= 256)) && forall i: int :: ((0 <= i) ==> (i < |roles|) ==> (((roles[i] == 1) || (roles[i] == 2)) || (roles[i] == 3)))) && exists i: int :: ((((0 <= i) && (i < |roles|)) && (roles[i] == 3)) && forall j: int :: ((0 <= j) ==> (j < |roles|) ==> (roles[j] == 3) ==> (j == i)))))
  ensures ((res >= 0) ==> ((roles[res] == 3) && forall i: int :: ((0 <= i) ==> (i < |roles|) ==> (roles[i] == 3) ==> (i == res))))
{
  if ((|roles| < 1) || (|roles| > 256)) {
    return -1;
  }
  var controller := -1;
  var index := 0;
  while (index < |roles|)
    invariant (0 <= index)
    invariant (index <= |roles|)
    invariant (-1 <= controller)
    invariant (controller < index)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> (((roles[i] == 1) || (roles[i] == 2)) || (roles[i] == 3)))
    invariant ((controller == -1) <==> forall i: int :: ((0 <= i) ==> (i < index) ==> (roles[i] != 3)))
    invariant ((controller >= 0) ==> ((roles[controller] == 3) && forall i: int :: ((0 <= i) ==> (i < index) ==> (roles[i] == 3) ==> (i == controller))))
    decreases (|roles| - index)
  {
    var role := roles[index];
    if (((role != 1) && (role != 2)) && (role != 3)) {
      return -1;
    }
    if (role == 3) {
      if (controller != -1) {
        return -1;
      }
      controller := index;
    }
    index := (index + 1);
  }
  return controller;
}

method validDocumentAuthorityFields(values: seq<string>, minimum: int, maximum: int) returns (res: bool)
  requires (|values| <= 4294967295)
  requires (0 <= minimum)
  requires (minimum <= maximum)
  requires (maximum <= 4294967295)
  ensures (res <==> ((forall i: int :: ((0 <= i) ==> (i < |values|) ==> ((minimum <= |values[i]|) && (|values[i]| <= maximum)))) && forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |values|) ==> (values[i] != values[j]))))
{
  var seen: set<string> := {};
  var index := 0;
  while (index < |values|)
    invariant (0 <= index)
    invariant (index <= |values|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((minimum <= |values[i]|) && (|values[i]| <= maximum)))
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> (values[i] in seen))
    invariant forall key :: ((key in seen) ==> exists i: int :: (((0 <= i) && (i < index)) && (values[i] == key)))
    invariant forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < index) ==> (values[i] != values[j]))
    decreases (|values| - index)
  {
    if (values[index] in seen) {
      return false;
    }
    if ((|values[index]| < minimum) || (|values[index]| > maximum)) {
      return false;
    }
    seen := (seen + {values[index]});
    index := (index + 1);
  }
  return true;
}

method isDocumentAuthorityRosterValid(memberIds: seq<string>, publicKeys: seq<string>, roles: seq<int>) returns (res: bool)
  requires (|memberIds| <= 4294967295)
  requires (|publicKeys| <= 4294967295)
  requires (|roles| <= 4294967295)
  ensures (res <==> ((((((((|memberIds| == |roles|) && (|publicKeys| == |roles|)) && (1 <= |roles|)) && (|roles| <= 256)) && forall i: int :: ((0 <= i) ==> (i < |roles|) ==> (((roles[i] == 1) || (roles[i] == 2)) || (roles[i] == 3)))) && exists i: int :: ((((0 <= i) && (i < |roles|)) && (roles[i] == 3)) && forall j: int :: ((0 <= j) ==> (j < |roles|) ==> (roles[j] == 3) ==> (j == i)))) && forall i: int :: ((0 <= i) ==> (i < |roles|) ==> (((|memberIds[i]| == 64) && (1 <= |publicKeys[i]|)) && (|publicKeys[i]| <= 4096)))) && forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |roles|) ==> ((memberIds[i] != memberIds[j]) && (publicKeys[i] != publicKeys[j])))))
{
  if ((|memberIds| != |roles|) || (|publicKeys| != |roles|)) {
    return false;
  }
  var i_t0 := documentAuthorityControllerIndex(roles);
  if (i_t0 < 0) {
    return false;
  }
  var i_t1 := validDocumentAuthorityFields(memberIds, 64, 64);
  if !(i_t1) {
    return false;
  }
  var i_t2 := validDocumentAuthorityFields(publicKeys, 1, 4096);
  if !(i_t2) {
    return false;
  }
  return true;
}

method bindDocumentController<Controller(==)>(controllers: map<string, Controller>, head: string, controller: Controller, limit: int) returns (res: map<string, Controller>)
  requires (0 <= limit)
  requires (limit <= 9007199254740991)
  requires (|controllers| < limit)
  requires !((head in controllers))
  ensures (|res| == (|controllers| + 1))
  ensures (|res| <= limit)
  ensures (head in res)
  ensures (res[head] == controller)
  ensures forall key :: ((key in res) <==> ((key in controllers) || (key == head)))
  ensures forall key :: ((key in controllers) ==> (res[key] == controllers[key]))
{
  var result := controllers;
  result := result[head := controller];
  return result;
}


datatype AuthorityAttempt = AuthorityAttempt(head: string, memberIds: seq<string>, publicKeys: seq<string>, roles: seq<int>, signedByCurrent: bool)

function SignedAuthorityHeads(attempts: seq<AuthorityAttempt>): set<string>
  decreases |attempts|
{
  if |attempts| == 0 then {} else
    (if attempts[0].signedByCurrent then {attempts[0].head} else {}) + SignedAuthorityHeads(attempts[1..])
}

predicate AdmissibleAuthorityRoster(attempt: AuthorityAttempt)
{
  |attempt.memberIds| == |attempt.roles| && |attempt.publicKeys| == |attempt.roles| &&
  1 <= |attempt.roles| <= 256 &&
  (forall i :: 0 <= i < |attempt.roles| ==> attempt.roles[i] == 1 || attempt.roles[i] == 2 || attempt.roles[i] == 3) &&
  (exists i :: 0 <= i < |attempt.roles| && attempt.roles[i] == 3 && forall j :: 0 <= j < |attempt.roles| && attempt.roles[j] == 3 ==> j == i) &&
  (forall i :: 0 <= i < |attempt.roles| ==> |attempt.memberIds[i]| == 64 && 1 <= |attempt.publicKeys[i]| <= 4096) &&
  (forall i, j :: 0 <= i < j < |attempt.roles| ==> attempt.memberIds[i] != attempt.memberIds[j] && attempt.publicKeys[i] != attempt.publicKeys[j])
}

lemma unsignedAuthorityHeads_excluded(attempts: seq<AuthorityAttempt>, head: string)
  requires forall i :: 0 <= i < |attempts| && attempts[i].signedByCurrent ==> attempts[i].head != head
  ensures head !in SignedAuthorityHeads(attempts)
  decreases |attempts|
{
  if |attempts| > 0 {
    if attempts[0].signedByCurrent {
      assert attempts[0].head != head;
    }
    unsignedAuthorityHeads_excluded(attempts[1..], head);
  }
}

method controllerBindings_all_histories(bindings: map<string, string>, attempts: seq<AuthorityAttempt>, limit: int)
  returns (result: map<string, string>)
  requires |bindings| <= limit <= 9007199254740991
  requires forall i :: 0 <= i < |attempts| ==> |attempts[i].memberIds| <= 4294967295 && |attempts[i].publicKeys| <= 4294967295 && |attempts[i].roles| <= 4294967295
  ensures |bindings| <= |result| <= limit
  ensures bindings.Keys <= result.Keys
  ensures forall head :: head in bindings ==> result[head] == bindings[head]
  ensures result.Keys <= bindings.Keys + SignedAuthorityHeads(attempts)
  ensures |attempts| > 0 && attempts[0].signedByCurrent && AdmissibleAuthorityRoster(attempts[0]) && |bindings| < limit && attempts[0].head !in bindings ==> attempts[0].head in result && forall i :: 0 <= i < |attempts[0].roles| && attempts[0].roles[i] == 3 ==> result[attempts[0].head] == attempts[0].memberIds[i]
  decreases |attempts|
{
  if |attempts| == 0 {
    result := bindings;
  } else {
    var attempt := attempts[0];
    var candidate := bindings;
    var rosterValid := isDocumentAuthorityRosterValid(attempt.memberIds, attempt.publicKeys, attempt.roles);
    assert rosterValid <==> AdmissibleAuthorityRoster(attempt);
    var permitted := canBindDocumentController(bindings, attempt.head, limit);
    if attempt.signedByCurrent && rosterValid && permitted {
      var controller := documentAuthorityControllerIndex(attempt.roles);
      assert 0 <= controller < |attempt.memberIds|;
      candidate := bindDocumentController(bindings, attempt.head, attempt.memberIds[controller], limit);
    }
    assert bindings.Keys <= candidate.Keys;
    assert forall head :: head in bindings ==> candidate[head] == bindings[head];
    assert candidate.Keys <= bindings.Keys + (if attempt.signedByCurrent then {attempt.head} else {});
    result := controllerBindings_all_histories(candidate, attempts[1..], limit);
  }
}

method documentAuthority_domain()
{
  var a := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  var b := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
  var validRoles := [1, 3, 2];
  assert forall i :: 0 <= i < |validRoles| ==> validRoles[i] == 1 || validRoles[i] == 2 || validRoles[i] == 3;
  assert forall j :: 0 <= j < |validRoles| && validRoles[j] == 3 ==> j == 1;
  assert 0 <= 1 < |validRoles| && validRoles[1] == 3 && forall j :: 0 <= j < |validRoles| && validRoles[j] == 3 ==> j == 1;
  assert exists i :: 0 <= i < |validRoles| && validRoles[i] == 3 && forall j :: 0 <= j < |validRoles| && validRoles[j] == 3 ==> j == i;
  var unique := documentAuthorityControllerIndex(validRoles);
  assert unique >= 0;
  assert validRoles[unique] == 3;
  assert unique == 1;
  var absent := documentAuthorityControllerIndex([1, 2]);
  assert absent == -1;
  var duplicateRoles := [3, 3];
  var duplicate := documentAuthorityControllerIndex(duplicateRoles);
  if duplicate >= 0 {
    assert duplicateRoles[0] == 3 && duplicateRoles[1] == 3;
    assert 0 == duplicate && 1 == duplicate;
  }
  assert duplicate == -1;
  var invalidRoles := [3, 4];
  var invalid := documentAuthorityControllerIndex(invalidRoles);
  if invalid >= 0 {
    assert invalidRoles[1] == 1 || invalidRoles[1] == 2 || invalidRoles[1] == 3;
  }
  assert invalid == -1;
  var empty := documentAuthorityControllerIndex([]);
  assert empty == -1;
  var ids := [a, b];
  var keys := ["key-a", "key-b"];
  var roles := [3, 1];
  assert forall i :: 0 <= i < |roles| ==> roles[i] == 1 || roles[i] == 2 || roles[i] == 3;
  assert forall j :: 0 <= j < |roles| && roles[j] == 3 ==> j == 0;
  assert 0 <= 0 < |roles| && roles[0] == 3 && forall j :: 0 <= j < |roles| && roles[j] == 3 ==> j == 0;
  assert exists i :: 0 <= i < |roles| && roles[i] == 3 && forall j :: 0 <= j < |roles| && roles[j] == 3 ==> j == i;
  assert forall i :: 0 <= i < |roles| ==> |ids[i]| == 64 && 1 <= |keys[i]| <= 4096;
  assert forall i, j :: 0 <= i < j < |roles| ==> ids[i] != ids[j] && keys[i] != keys[j];
  var roster := isDocumentAuthorityRosterValid(ids, keys, roles);
  assert roster;
  var duplicatedIds := [a, a];
  var duplicatedMember := isDocumentAuthorityRosterValid(duplicatedIds, keys, roles);
  if duplicatedMember {
    assert duplicatedIds[0] != duplicatedIds[1];
  }
  assert !duplicatedMember;
  var repeatedKeys := ["key-a", "key-a"];
  var duplicatedKey := isDocumentAuthorityRosterValid(ids, repeatedKeys, roles);
  if duplicatedKey {
    assert repeatedKeys[0] != repeatedKeys[1];
  }
  assert !duplicatedKey;
  var emptyKeys := [""];
  var emptyKey := isDocumentAuthorityRosterValid([a], emptyKeys, [3]);
  if emptyKey {
    assert 1 <= |emptyKeys[0]|;
  }
  assert !emptyKey;
  var shortIds := ["short"];
  var wrongSize := isDocumentAuthorityRosterValid(shortIds, ["key"], [3]);
  if wrongSize {
    assert |shortIds[0]| == 64;
  }
  assert !wrongSize;
  var wrongShape := isDocumentAuthorityRosterValid([a, b], ["key"], [3]);
  assert !wrongShape;
  var initial: map<string, string> := map["initial" := a];
  assert !canBindDocumentController(initial, "initial", 1024);
  assert !canBindDocumentController(initial, "next", 1);
  assert canBindDocumentController(initial, "next", 1024);
  var bound := bindDocumentController(initial, "next", b, 1024);
  assert bound == map["initial" := a, "next" := b];
  var attempts := [
    AuthorityAttempt("next", ids, keys, roles, true),
    AuthorityAttempt("initial", [a, b], ["key-a", "key-b"], [1, 3], true),
    AuthorityAttempt("invalid", [a, b], ["key-a", "key-b"], [3, 3], true),
    AuthorityAttempt("unsigned", [a, b], ["key-a", "key-b"], [3, 1], false)
  ];
  assert AdmissibleAuthorityRoster(attempts[0]);
  var history := controllerBindings_all_histories(initial, attempts, 1024);
  assert history["initial"] == a;
  assert history["next"] == a;
  unsignedAuthorityHeads_excluded(attempts, "unsigned");
  assert "unsigned" !in history;
}
