// Generated by lsc from commit-lifecycle.ts
// lsc options: string-semantics=javascript-utf16

datatype PreparedCommitPhase = prepared | claimed | committed

function claimPreparedCommit(phase: PreparedCommitPhase, baseCurrent: bool, hydrating: bool): string
{
  if (!phase.prepared?) then
    "notPrepared"
  else
    if !(baseCurrent) then
      "stale"
    else
      if hydrating then
        "hydrating"
      else
        "claimed"
}

lemma claimPreparedCommit_ensures(phase: PreparedCommitPhase, baseCurrent: bool, hydrating: bool)
  ensures ((claimPreparedCommit(phase, baseCurrent, hydrating) == "claimed") <==> ((phase.prepared? && baseCurrent) && !(hydrating)))
  ensures ((claimPreparedCommit(phase, baseCurrent, hydrating) == "notPrepared") <==> (!phase.prepared?))
  ensures ((claimPreparedCommit(phase, baseCurrent, hydrating) == "stale") <==> (phase.prepared? && !(baseCurrent)))
  ensures ((claimPreparedCommit(phase, baseCurrent, hydrating) == "hydrating") <==> ((phase.prepared? && baseCurrent) && hydrating))
{
}

function completePreparedCommit(phase: PreparedCommitPhase): PreparedCommitPhase
  requires (phase.claimed? || phase.committed?)
{
  PreparedCommitPhase.committed
}

lemma completePreparedCommit_ensures(phase: PreparedCommitPhase)
  requires (phase.claimed? || phase.committed?)
  ensures completePreparedCommit(phase).committed?
{
}

function coordinatorAdmission(forked: bool, poisoned: bool, initialized: bool): string
{
  if forked then
    "forked"
  else
    if poisoned then
      "poisoned"
    else
      if initialized then
        "usable"
      else
        "uninitialized"
}

lemma coordinatorAdmission_ensures(forked: bool, poisoned: bool, initialized: bool)
  ensures ((coordinatorAdmission(forked, poisoned, initialized) == "usable") <==> ((!(forked) && !(poisoned)) && initialized))
  ensures ((coordinatorAdmission(forked, poisoned, initialized) == "forked") <==> forked)
  ensures ((coordinatorAdmission(forked, poisoned, initialized) == "poisoned") <==> (!(forked) && poisoned))
  ensures ((coordinatorAdmission(forked, poisoned, initialized) == "uninitialized") <==> ((!(forked) && !(poisoned)) && !(initialized)))
{
}

function failedCommitRecovery(ambiguousStoreFailure: bool): string
{
  if ambiguousStoreFailure then
    "propagate"
  else
    "poison"
}

lemma failedCommitRecovery_ensures(ambiguousStoreFailure: bool)
  ensures ((failedCommitRecovery(ambiguousStoreFailure) == "propagate") <==> ambiguousStoreFailure)
  ensures ((failedCommitRecovery(ambiguousStoreFailure) == "poison") <==> !(ambiguousStoreFailure))
{
}

lemma commitLifecycle_claim_then_finish(phase: PreparedCommitPhase, current: bool, hydrating: bool)
  ensures claimPreparedCommit(phase, current, hydrating) == "claimed" ==> phase.prepared? && current && !hydrating
  ensures claimPreparedCommit(claimed, current, hydrating) == "notPrepared"
  ensures claimPreparedCommit(completePreparedCommit(claimed), current, hydrating) == "notPrepared"
  ensures completePreparedCommit(completePreparedCommit(claimed)) == committed
  ensures !current ==> claimPreparedCommit(prepared, current, hydrating) == "stale"
  ensures current && hydrating ==> claimPreparedCommit(prepared, current, hydrating) == "hydrating"
{}

function FinalizeRepeated(phase: PreparedCommitPhase, repetitions: nat): PreparedCommitPhase
  requires phase.claimed? || phase.committed?
  ensures repetitions > 0 ==> FinalizeRepeated(phase, repetitions) == committed
  ensures phase.committed? ==> FinalizeRepeated(phase, repetitions) == committed
  decreases repetitions
{
  if repetitions == 0 then phase else FinalizeRepeated(completePreparedCommit(phase), repetitions-1)
}

method commitLifecycle_domain()
{
  assert claimPreparedCommit(prepared, true, false) == "claimed";
  assert completePreparedCommit(claimed) == committed;
  assert FinalizeRepeated(claimed, 500) == committed;
  assert coordinatorAdmission(false, false, true) == "usable";
  assert coordinatorAdmission(true, true, true) == "forked";
  assert coordinatorAdmission(false, true, true) == "poisoned";
  assert failedCommitRecovery(true) == "propagate";
  assert failedCommitRecovery(false) == "poison";
}
