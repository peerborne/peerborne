method countQuorumDigests(digests: seq<string>) returns (res: map<string, int>)
  requires (|digests| <= 4294967295)
  ensures forall key :: ((key in res) <==> (key in digests))
  ensures forall key :: ((key in res) ==> ((1 <= res[key]) && (res[key] <= |digests|)))
