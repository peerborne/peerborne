datatype JournalPublicationIndex = JournalPublicationIndex(id: string, bytes: int)

datatype JournalPublicationPlan = JournalPublicationPlan(decision: string, publications: seq<JournalPublicationIndex>, retained: seq<int>, bytes: int)

opaque
function JournalPublicationBytes(publications: seq<JournalPublicationIndex>): int
{
  if |publications| == 0 then 0
  else JournalPublicationBytes(publications[..|publications|-1]) + publications[|publications|-1].bytes
}

opaque
function JournalPublicationsWithout(publications: seq<JournalPublicationIndex>, id: string): seq<JournalPublicationIndex>
{
  if |publications| == 0 then []
  else
    var prefix := JournalPublicationsWithout(publications[..|publications|-1], id);
    if publications[|publications|-1].id == id then prefix
    else prefix + [publications[|publications|-1]]
}

lemma journalPublication_empty(id: string)
  ensures JournalPublicationBytes([]) == 0
  ensures JournalPublicationsWithout([], id) == []
{
  reveal JournalPublicationBytes();
  reveal JournalPublicationsWithout();
}

