      forall i :: 0 <= i < |state.publications| ==> state.publications[i].id != action.id))
}

function classifyJournalStage(revision: int, expected: int, hasPending: bool, checkpoint: bool, entries: int, retainedBytes: int, entryBytes: int): string
  requires (0 <= revision)
  requires (revision <= 9007199254740991)
  requires (0 <= expected)
  requires (expected <= 9007199254740991)
  requires (0 <= entries)
  requires (entries <= 128)
  requires (0 <= retainedBytes)
  requires (retainedBytes <= 134217728)
  requires (1 <= entryBytes)
  requires (entryBytes <= 134217728)
{
