  assert (publications + [entry])[..|publications|] == publications;
}

@IsolateAssertions
lemma journalPublication_withoutBounds(publications: seq<JournalPublicationIndex>, id: string)
  requires forall i :: 0 <= i < |publications| ==> publications[i].bytes > 0
  ensures 0 <= JournalPublicationBytes(JournalPublicationsWithout(publications, id)) <= JournalPublicationBytes(publications)
  ensures |JournalPublicationsWithout(publications, id)| <= |publications|
  ensures forall entry :: entry in JournalPublicationsWithout(publications, id) ==> entry in publications && entry.id != id
  decreases |publications|
{
