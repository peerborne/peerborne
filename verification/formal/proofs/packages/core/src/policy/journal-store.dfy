@IsolateAssertions
method planJournalPublication(publications: seq<JournalPublicationIndex>, id: string, bytes: int, append: bool) returns (res: JournalPublicationPlan)
  requires (|publications| <= 16)
  requires forall i: int :: ((0 <= i) ==> (i < |publications|) ==> ((1 <= publications[i].bytes) && (publications[i].bytes <= 1048648)))
  requires forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |publications|) ==> (publications[i].id != publications[j].id))
  requires (if append then ((1 <= bytes) && (bytes <= 1048648)) else (bytes == 0))
  ensures (((res.decision == "accept") || (res.decision == "duplicate")) || (res.decision == "capacity"))
  ensures (0 <= res.bytes)
  ensures (res.bytes <= 16777216)
  ensures (|res.publications| <= 16)
  ensures ((res.decision != "accept") ==> (((|res.publications| == 0) && (|res.retained| == 0)) && (res.bytes == 0)))
  ensures ((res.decision == "duplicate") <==> (append && exists i: int :: (((0 <= i) && (i < |publications|)) && (publications[i].id == id))))
  ensures ((res.decision == "accept") ==> (|res.publications| == (|res.retained| + (if append then 1 else 0))))
  ensures ((res.decision == "accept") ==> forall i: int :: ((0 <= i) ==> (i < |res.retained|) ==> ((((0 <= res.retained[i]) && (res.retained[i] < |publications|)) && (res.publications[i].id == publications[res.retained[i]].id)) && (res.publications[i].bytes == publications[res.retained[i]].bytes))))
  ensures forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res.retained|) ==> (res.retained[i] < res.retained[j]))
  ensures ((res.decision == "accept") ==> forall i: int :: ((0 <= i) ==> (i < |publications|) ==> ((i in res.retained) <==> (append || (publications[i].id != id)))))
  ensures ((res.decision == "accept") ==> append ==> ((res.publications[(|res.publications| - 1)].id == id) && (res.publications[(|res.publications| - 1)].bytes == bytes)))
  ensures ((res.decision == "accept") ==> forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res.publications|) ==> (res.publications[i].id != res.publications[j].id)))
  ensures res.bytes == JournalPublicationBytes(res.publications)
  ensures res.decision == "accept" ==> res.publications == (if append then publications + [JournalPublicationIndex(id, bytes)] else JournalPublicationsWithout(publications, id))
  ensures res.decision == "accept" <==>
    !(append && exists i :: 0 <= i < |publications| && publications[i].id == id) &&
    (if append then |publications| < 16 && JournalPublicationBytes(publications) + bytes <= 16777216
     else JournalPublicationBytes(JournalPublicationsWithout(publications, id)) <= 16777216)
{
  var next: seq<JournalPublicationIndex> := [];
  var retained: seq<int> := [];
  var total := 0;
  var removed := false;
  var index := 0;
  journalPublication_empty(id);
  assert {:split_here} true;
  while (index < |publications|)
    invariant (0 <= index)
    invariant (index <= |publications|)
    invariant total == JournalPublicationBytes(next)
    invariant next == (if append then publications[..index] else JournalPublicationsWithout(publications[..index], id))
    invariant index == |publications| ==> next == (if append then publications else JournalPublicationsWithout(publications, id))
    invariant index == |publications| ==> total == JournalPublicationBytes(if append then publications else JournalPublicationsWithout(publications, id))
    invariant (|next| == |retained|)
    invariant (|retained| <= index)
    invariant (0 <= total)
    invariant (total <= (|next| * 1048648))
    invariant ((|retained| + (if removed then 1 else 0)) == index)
    invariant (removed <==> (!(append) && exists i: int :: (((0 <= i) && (i < index)) && (publications[i].id == id))))
    invariant (append ==> forall i: int :: ((0 <= i) ==> (i < index) ==> (publications[i].id != id)))
    invariant forall i: int :: ((0 <= i) ==> (i < |retained|) ==> ((((0 <= retained[i]) && (retained[i] < index)) && (next[i].id == publications[retained[i]].id)) && (next[i].bytes == publications[retained[i]].bytes)))
    invariant forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |retained|) ==> (retained[i] < retained[j]))
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> ((i in retained) <==> (append || (publications[i].id != id))))
    decreases (|publications| - index)
  {
    var publication := publications[index];
    assert publications[..index+1] == publications[..index] + [publication];
    journalPublication_filterAppend(publications[..index], publication, id);
    journalPublication_appendBytes(next, publication);
    if (append && (publication.id == id)) {
      return JournalPublicationPlan("duplicate", [], [], 0);
    }
    if (append || (publication.id != id)) {
      next := (next + [JournalPublicationIndex(publication.id, publication.bytes)]);
      retained := (retained + [index]);
      total := (total + publication.bytes);
    } else {
      removed := true;
    }
    assert next == (if append then publications[..index+1] else JournalPublicationsWithout(publications[..index+1], id));
    if index + 1 == |publications| {
      assert publications[..index+1] == publications;
      assert next == (if append then publications else JournalPublicationsWithout(publications, id));
    }
    index := (index + 1);
  }
  if ((total > 16777216) || (append && ((|publications| >= 16) || (bytes > (16777216 - total))))) {
    return JournalPublicationPlan("capacity", [], [], 0);
  }
  journalPublication_appendBytes(next, JournalPublicationIndex(id, bytes));
  if append {
    next := (next + [JournalPublicationIndex(id, bytes)]);
    total := (total + bytes);
  }
  assert next == (if append then publications + [JournalPublicationIndex(id, bytes)] else JournalPublicationsWithout(publications, id));
  return JournalPublicationPlan("accept", next, retained, total);
}

@IsolateAssertions
method journalStore_step(state: JournalStoreState, action: JournalStoreAction)
  returns (next: JournalStoreState, committed: bool)
  requires JournalStoreValid(state) && JournalStoreActionValid(action)
  ensures JournalStoreValid(next)
  ensures action.operation == 0 ==> next == (if action.storageSucceeded && JournalStageAdmitted(state, action)
    then JournalStoreState(state.revision, state.entries, state.publications, ReservedJournal(action.token, action.checkpoint, action.entryBytes, action.publishes, action.id, action.publicationBytes)) else state)
  ensures !action.storageSucceeded ==> next == state
  ensures committed <==> next.revision == state.revision + 1
  ensures committed <==> action.operation == 1 && action.storageSucceeded && action.payloadMatches && state.pending.ReservedJournal? && action.expected == state.revision && action.token == state.pending.token && action.checkpoint == state.pending.checkpoint
  ensures !committed ==> next.revision == state.revision && next.entries == state.entries
  ensures committed ==> action.operation == 1 && action.storageSucceeded && action.payloadMatches && state.pending.ReservedJournal?
  ensures committed ==> action.expected == state.revision && action.token == state.pending.token && action.checkpoint == state.pending.checkpoint
  ensures committed ==> next.pending.NoJournalReservation? && next.entries == (if state.pending.checkpoint then [state.pending.entryBytes+32] else state.entries + [state.pending.entryBytes+32])
  ensures action.operation != 1 || !action.checkpoint ==> JournalEntriesPrefix(state.entries, next.entries)
  ensures action.operation == 1 && state.pending.ReservedJournal? && action.checkpoint != state.pending.checkpoint ==> next == state
  ensures action.operation == 2 ==> next.pending == state.pending
{
  next := state;
  committed := false;
  if action.operation == 0 {
    var decision := classifyJournalStage(state.revision, action.expected, state.pending.ReservedJournal?, action.checkpoint, |state.entries|, JournalEntryBytes(state.entries), action.entryBytes);
    var admitted := decision == "accept";
    if action.publishes {
      var publication := planJournalPublication(state.publications, action.id, action.publicationBytes, true);
      admitted := admitted && publication.decision == "accept";
    }
    if admitted && action.storageSucceeded {
      next := JournalStoreState(state.revision, state.entries, state.publications,
        ReservedJournal(action.token, action.checkpoint, action.entryBytes, action.publishes, action.id, action.publicationBytes));
    }
  } else if action.operation == 1 {
    var pending := state.pending;
    var current := isJournalCommitCurrent(state.revision, action.expected, pending.ReservedJournal?,
      pending.ReservedJournal? && pending.token == action.token,
      pending.ReservedJournal? && pending.checkpoint == action.checkpoint);
    if current && action.payloadMatches && action.storageSucceeded {
      assert pending.ReservedJournal?;
      var publications := state.publications;
      var admitted := true;
      if pending.publishes {
        var publication := planJournalPublication(publications, pending.id, pending.publicationBytes, true);
        admitted := publication.decision == "accept";
        publications := publication.publications;
      }
      if admitted {
        var entries := if pending.checkpoint then [pending.entryBytes+32] else state.entries + [pending.entryBytes+32];
        next := JournalStoreState(state.revision+1, entries, publications, NoJournalReservation);
        committed := true;
      }
    }
  } else if action.operation == 2 {
    journalPublication_withoutBounds(state.publications, action.id);
    var publication := planJournalPublication(state.publications, action.id, 0, false);
    assert publication.decision == "accept";
    if action.storageSucceeded {
      next := JournalStoreState(state.revision, state.entries, publication.publications, state.pending);
    }
  } else if action.storageSucceeded && state.pending.ReservedJournal? && state.pending.token == action.token {
    next := JournalStoreState(state.revision, state.entries, state.publications, NoJournalReservation);
  }
}

method journalStore_all_histories(state: JournalStoreState, actions: seq<JournalStoreAction>)
  returns (result: JournalStoreState, commits: int)
  requires JournalStoreValid(state)
  requires forall i :: 0 <= i < |actions| ==> JournalStoreActionValid(actions[i])
  ensures JournalStoreValid(result)
  ensures |actions| == 0 ==> result == state
  ensures 0 <= commits <= |actions|
  ensures result.revision == state.revision + commits
  ensures (forall i :: 0 <= i < |actions| && actions[i].operation == 1 ==> !actions[i].checkpoint) ==> JournalEntriesPrefix(state.entries, result.entries)
  decreases |actions|
{
  if |actions| == 0 {
    result := state;
    commits := 0;
  } else {
    var next, committed := journalStore_step(state, actions[0]);
    var remaining: int;
    result, remaining := journalStore_all_histories(next, actions[1..]);
    commits := remaining + (if committed then 1 else 0);
  }
}

method journalStore_domain()
{
  journalPublication_empty("frame");
  var initial := JournalStoreState(0, [], [], NoJournalReservation);
  assert JournalStoreValid(initial);
  var staged, first := journalStore_step(initial, JournalStoreAction(0, 0, "token", false, 1, true, "frame", 1, true, true));
  assert !first && staged.pending.ReservedJournal?;
  var rejected, badCommit := journalStore_step(staged, JournalStoreAction(1, 0, "token", true, 1, false, "", 0, true, true));
  assert !badCommit && rejected == staged;
  var accepted, goodCommit := journalStore_step(staged, JournalStoreAction(1, 0, "token", false, 1, false, "", 0, true, true));
  assert goodCommit && accepted.revision == 1;
  assert classifyJournalStage(9007199254740991, 9007199254740991, false, true, 1, 1, 1) == "conflict";
  assert classifyJournalStage(0, 0, false, false, 0, 0, 134217728 - 32) == "accept";
  assert classifyJournalStage(0, 0, false, false, 0, 0, 134217728 - 31) == "capacity";
  var sameState, count := journalStore_all_histories(initial, []);
  assert sameState == initial && count == 0;
}

method journalPublication_domain()
{
  reveal JournalPublicationsWithout();
  reveal JournalPublicationBytes();
  journalPublication_empty("frame");
  var before := [JournalPublicationIndex("frame", 1)];
  assert before[0].id == "frame";
  assert exists i :: 0 <= i < |before| && before[i].id == "frame";
  var duplicate := planJournalPublication(before, "frame", 1, true);
  assert duplicate.decision == "duplicate";
  journalPublication_filterAppend([], before[0], "frame");
  assert JournalPublicationsWithout(before, "frame") == [];
  var removed := planJournalPublication(before, "frame", 0, false);
  assert removed.decision == "accept" && removed.bytes == 0 && removed.publications == [];
}
