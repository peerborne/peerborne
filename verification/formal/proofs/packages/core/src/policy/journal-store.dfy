  if |publications| > 0 {
    var prefix := publications[..|publications|-1];
    var last := publications[|publications|-1];
    journalPublication_withoutBounds(prefix, id);
    assert publications == prefix + [last];
    journalPublication_filterAppend(prefix, last, id);
    journalPublication_appendBytes(prefix, last);
    assert last.bytes > 0;
    assert JournalPublicationBytes(publications) == JournalPublicationBytes(prefix) + last.bytes;
    if last.id == id {
      assert JournalPublicationsWithout(publications, id) == JournalPublicationsWithout(prefix, id);
      assert JournalPublicationBytes(JournalPublicationsWithout(publications, id)) == JournalPublicationBytes(JournalPublicationsWithout(prefix, id));
    } else {
      assert JournalPublicationsWithout(publications, id) == JournalPublicationsWithout(prefix, id) + [last];
      journalPublication_appendBytes(JournalPublicationsWithout(prefix, id), last);
      assert JournalPublicationBytes(JournalPublicationsWithout(publications, id)) == JournalPublicationBytes(JournalPublicationsWithout(prefix, id)) + last.bytes;
    }
    forall entry | entry in JournalPublicationsWithout(publications, id)
      ensures entry in publications && entry.id != id
    {
      if last.id == id || entry != last {
        assert entry in JournalPublicationsWithout(prefix, id);
      }
    }
  }
}

predicate JournalPublicationShape(publications: seq<JournalPublicationIndex>)
{
  |publications| <= 16 &&
  (forall i :: 0 <= i < |publications| ==> 1 <= publications[i].bytes <= 1048648) &&
  (forall i, j :: 0 <= i < j < |publications| ==> publications[i].id != publications[j].id) &&
  0 <= JournalPublicationBytes(publications) <= 16777216
}

function JournalEntryBytes(entries: seq<int>): int
{
  if |entries| == 0 then 0 else JournalEntryBytes(entries[..|entries|-1]) + entries[|entries|-1]
}

datatype JournalReservation = NoJournalReservation | ReservedJournal(token: string, checkpoint: bool, entryBytes: int, publishes: bool, id: string, publicationBytes: int)
datatype JournalStoreState = JournalStoreState(revision: int, entries: seq<int>, publications: seq<JournalPublicationIndex>, pending: JournalReservation)
datatype JournalStoreAction = JournalStoreAction(operation: int, expected: int, token: string, checkpoint: bool, entryBytes: int, publishes: bool, id: string, publicationBytes: int, payloadMatches: bool, storageSucceeded: bool)

