datatype CidEdge = CidEdge(from: string, to: string)

function shouldPruneDocumentChildren(isAcl: bool, documentNodesVisited: int, keepCount: int): bool
{
  (!(isAcl) && (documentNodesVisited >= keepCount))
}

lemma shouldPruneDocumentChildren_ensures(isAcl: bool, documentNodesVisited: int, keepCount: int)
  ensures (shouldPruneDocumentChildren(isAcl, documentNodesVisited, keepCount) <==> (!(isAcl) && (documentNodesVisited >= keepCount)))
  ensures (isAcl ==> !(shouldPruneDocumentChildren(isAcl, documentNodesVisited, keepCount)))
{
}

@IsolateAssertions
method reachableCids(nodes: seq<string>, edges: seq<CidEdge>, root: string) returns (res: set<string>)
  requires (|nodes| <= 32768)
  requires (|edges| <= 131072)
  requires (root in nodes)
  requires forall i: int :: ((0 <= i) ==> (i < |edges|) ==> ((edges[i].from in nodes) && (edges[i].to in nodes)))
  ensures forall allowed: set<string> :: ClosedUnderEdges(allowed, edges, root) ==> res <= allowed
  ensures (root in res)
  ensures forall key :: ((key in res) ==> (key in nodes))
  ensures forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in res) ==> (edges[i].to in res))
{
  var adjacency: map<string, seq<string>> := map[];
  var edgeIndex := 0;
  while (edgeIndex < |edges|)
    invariant (0 <= edgeIndex)
    invariant (edgeIndex <= |edges|)
    invariant forall key :: ((key in adjacency) ==> ((key in nodes) && (|adjacency[key]| <= edgeIndex)))
    invariant forall i: int :: ((0 <= i) ==> (i < edgeIndex) ==> ((edges[i].from in adjacency) && (edges[i].to in adjacency[edges[i].from])))
    invariant forall key :: (if key in adjacency then adjacency[key] else []) == Outgoing(edges[..edgeIndex], key)
    decreases (|edges| - edgeIndex)
  {
    var edge := edges[edgeIndex];
    var children := (if (edge.from in adjacency) then (var i_oc0_val := adjacency[edge.from]; i_oc0_val) else []);
    children := (children + [edge.to]);
    adjacency := adjacency[edge.from := children];
    assert {:split_here} true;
    forall key: string
      ensures (if key in adjacency then adjacency[key] else []) == Outgoing(edges[..edgeIndex+1], key)
    {
      OutgoingStep(edges, edgeIndex, key);
    }
    forall key: string | key in adjacency
    {
      OutgoingFacts(edges[..edgeIndex+1], key);
    }
    forall key: string, at: int | key in adjacency && 0 <= at < |adjacency[key]|
      ensures exists i :: 0 <= i < edgeIndex+1 && edges[i].from == key && edges[i].to == adjacency[key][at]
    {
      var edgePosition := OutgoingWitness(edges[..edgeIndex+1], key, at);
      assert edges[edgePosition] == edges[..edgeIndex+1][edgePosition];
    }
    edgeIndex := (edgeIndex + 1);
  }
  assert edges[..|edges|] == edges;
  SeqSetBound(nodes);
  EdgeCostEmpty(edges);
  var seen: set<string> := {};
  var queue := [root];
  var index := 0;
  var enqueuedEdges := 0;
  while (index < |queue|)
    invariant (0 <= index)
    invariant (index <= |queue|)
    invariant (|seen| <= |nodes|)
    invariant (0 <= enqueuedEdges)
    invariant (enqueuedEdges <= |edges|)
    invariant (|queue| <= (|edges| + 1))
    invariant (root in queue)
    invariant forall j: int :: ((0 <= j) ==> (j < |queue|) ==> (queue[j] in nodes))
    invariant forall key :: ((key in seen) ==> (key in nodes))
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> (queue[j] in seen))
    invariant forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in seen) ==> (edges[i].to in queue))
    invariant forall key :: (if key in adjacency then adjacency[key] else []) == Outgoing(edges, key)
    invariant seen <= NodeSet(nodes)
    invariant |queue| == 1 + EdgeCost(edges, seen)
    invariant enqueuedEdges == EdgeCost(edges, seen)
    invariant forall allowed: set<string> :: ClosedUnderEdges(allowed, edges, root) ==> seen <= allowed && (forall j :: 0 <= j < |queue| ==> queue[j] in allowed)
    decreases (((((|nodes| - |seen|) + |edges|) - enqueuedEdges) + |queue|) - index)
  {
    ghost var beforePotential := |nodes| - |seen| + |edges| - enqueuedEdges + |queue| - index;
    var node := queue[index];
    index := (index + 1);
    assert {:split_here} true;
    if !((node in seen)) {
      ghost var beforeSeen := seen;
      EdgeCostAdd(edges, seen, node);
      seen := (seen + {node});
      assert seen <= NodeSet(nodes);
      SubsetCard(seen, NodeSet(nodes));
      var children := (if (node in adjacency) then (var i_oc1_val := adjacency[node]; i_oc1_val) else []);
      OutgoingFacts(edges, node);
      assert children == Outgoing(edges, node);
      ghost var beforeQueue := queue;
      enqueuedEdges := (enqueuedEdges + |children|);
      var child := 0;
      while (child < |children|)
        invariant (0 <= child)
        invariant (child <= |children|)
        invariant forall j: int :: ((0 <= j) ==> (j < child) ==> (children[j] in queue))
        invariant (root in queue)
        invariant (index <= |queue|)
        invariant (|seen| <= |nodes|)
        invariant (0 <= enqueuedEdges)
        invariant (enqueuedEdges <= |edges|)
        invariant (|queue| <= (|edges| + 1))
        invariant forall j: int :: ((0 <= j) ==> (j < |queue|) ==> (queue[j] in nodes))
        invariant forall j: int :: ((0 <= j) ==> (j < index) ==> (queue[j] in seen))
        invariant forall i: int :: ((0 <= i) ==> (i < |edges|) ==> (edges[i].from in seen) ==> (edges[i].from != node) ==> (edges[i].to in queue))
        invariant |queue| == |beforeQueue| + child
        invariant forall j :: 0 <= j < |beforeQueue| ==> queue[j] == beforeQueue[j]
        invariant |queue| + |children| - child == 1 + EdgeCost(edges, seen)
        invariant forall allowed: set<string> :: ClosedUnderEdges(allowed, edges, root) ==> seen <= allowed && (forall j :: 0 <= j < |queue| ==> queue[j] in allowed)
        decreases (|children| - child)
      {
        ghost var sourceEdge := OutgoingWitness(edges, node, child);
        forall allowed: set<string> | ClosedUnderEdges(allowed, edges, root)
          ensures children[child] in allowed
        {
          assert node in allowed;
        }
        queue := (queue + [children[child]]);
        child := (child + 1);
      }
    }
    assert |nodes| - |seen| + |edges| - enqueuedEdges + |queue| - index >= 0;
    assert |nodes| - |seen| + |edges| - enqueuedEdges + |queue| - index < beforePotential;
  }
  return seen;
}

opaque function Outgoing(edges: seq<CidEdge>, node: string): seq<string>
  ensures |Outgoing(edges, node)| <= |edges|
  ensures |edges| == 0 ==> Outgoing(edges, node) == []
  decreases |edges|
{
  if |edges| == 0 then [] else
    Outgoing(edges[..|edges|-1], node) +
    (if edges[|edges|-1].from == node then [edges[|edges|-1].to] else [])
}

lemma OutgoingStep(edges: seq<CidEdge>, count: int, node: string)
  requires 0 <= count < |edges|
  ensures Outgoing(edges[..count+1], node) == Outgoing(edges[..count], node) + (if edges[count].from == node then [edges[count].to] else [])
{
  reveal Outgoing();
  assert edges[..count+1][..count] == edges[..count];
}

lemma OutgoingFacts(edges: seq<CidEdge>, node: string)
  ensures |Outgoing(edges, node)| <= |edges|
  ensures forall j {:trigger Outgoing(edges, node)[j]} :: 0 <= j < |Outgoing(edges, node)| ==> 0 <= OutgoingWitness(edges, node, j) < |edges| && edges[OutgoingWitness(edges, node, j)].from == node && edges[OutgoingWitness(edges, node, j)].to == Outgoing(edges, node)[j]
  ensures forall i {:trigger edges[i]} :: 0 <= i < |edges| && edges[i].from == node ==> edges[i].to in Outgoing(edges, node)
{
  forall j | 0 <= j < |Outgoing(edges, node)|
    ensures 0 <= OutgoingWitness(edges, node, j) < |edges| && edges[OutgoingWitness(edges, node, j)].from == node && edges[OutgoingWitness(edges, node, j)].to == Outgoing(edges, node)[j]
  {
    var edgePosition := OutgoingWitness(edges, node, j);
  }
  reveal Outgoing();
  if |edges| > 0 {
    OutgoingFacts(edges[..|edges|-1], node);
  }
}

function OutgoingWitness(edges: seq<CidEdge>, node: string, at: int): int
  requires 0 <= at < |Outgoing(edges, node)|
  ensures 0 <= OutgoingWitness(edges, node, at) < |edges|
  ensures edges[OutgoingWitness(edges, node, at)].from == node
  ensures edges[OutgoingWitness(edges, node, at)].to == Outgoing(edges, node)[at]
  decreases |edges|
{
  reveal Outgoing();
  if at < |Outgoing(edges[..|edges|-1], node)| then
    OutgoingWitness(edges[..|edges|-1], node, at)
  else |edges|-1
}

opaque function EdgeCost(edges: seq<CidEdge>, seen: set<string>): int
  ensures 0 <= EdgeCost(edges, seen) <= |edges|
  decreases |edges|
{
  if |edges| == 0 then 0 else (EdgeCost(edges[..|edges|-1], seen) +
    (if edges[|edges|-1].from in seen then 1 else 0))
}

lemma EdgeCostAdd(edges: seq<CidEdge>, seen: set<string>, node: string)
  requires node !in seen
  ensures EdgeCost(edges, seen + {node}) == EdgeCost(edges, seen) + |Outgoing(edges, node)|
{
  reveal EdgeCost();
  reveal Outgoing();
  if |edges| > 0 {
    EdgeCostAdd(edges[..|edges|-1], seen, node);
  }
}

lemma SeqSetBound(nodes: seq<string>)
  ensures |NodeSet(nodes)| <= |nodes|
{
  if |nodes| > 0 {
    SeqSetBound(nodes[..|nodes|-1]);
    assert NodeSet(nodes) == NodeSet(nodes[..|nodes|-1]) + {nodes[|nodes|-1]};
  }
}

predicate ClosedUnderEdges(allowed: set<string>, edges: seq<CidEdge>, root: string)
{
  root in allowed && forall i :: 0 <= i < |edges| && edges[i].from in allowed ==> edges[i].to in allowed
}

method graphReachability_domain()
{
  var domainEdges := [CidEdge("root", "child"), CidEdge("child", "root")];
  var reached := reachableCids(["root", "child", "isolated"], domainEdges, "root");
  assert "root" in reached;
  assert domainEdges[0].from in reached;
  assert domainEdges[0].to in reached;
  assert "child" in reached;
  assert ClosedUnderEdges({"root", "child"}, [CidEdge("root", "child"), CidEdge("child", "root")], "root");
  assert "isolated" !in reached;
  assert !shouldPruneDocumentChildren(true, 100, 1);
}

lemma EdgeCostEmpty(edges: seq<CidEdge>)
  ensures EdgeCost(edges, {}) == 0
{
  reveal EdgeCost();
  if |edges| > 0 { EdgeCostEmpty(edges[..|edges|-1]); }
}

lemma SubsetCard(left: set<string>, right: set<string>)
  requires left <= right
  ensures |left| <= |right|
  decreases |right|
{
  if right != {} {
    var key :| key in right;
    var smaller := right - {key};
    assert right == smaller + {key};
    assert key !in smaller;
    if key in left {
      assert left == (left - {key}) + {key};
      SubsetCard(left - {key}, smaller);
    } else {
      SubsetCard(left, smaller);
    }
  }
}

lemma NonnegativeProduct(left: int, right: int)
  requires left >= 0 && right >= 0
  ensures left * right >= 0
{
}

function NodeSet(nodes: seq<string>): set<string>
{
  set key | key in nodes
}
