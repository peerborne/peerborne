// lsc options: string-semantics=javascript-utf16

datatype BeeKEMForkPhase = available | active | quarantined

datatype BeeKEMForkAction = acquire | release | quarantine

function canAdvanceBeeKEMForkAnchor(phase: BeeKEMForkPhase, revision: int, action: BeeKEMForkAction, leaseMatches: bool, stopObserved: bool): bool
  requires (0 <= revision)
  requires (revision <= MAX_REVISION)
{
  if ((revision == MAX_REVISION) || phase.quarantined?) then
    false
  else
    if action.acquire? then
      (phase.available? && !(stopObserved))
    else
      if ((!phase.active?) || !(leaseMatches)) then
        false
      else
        if action.quarantine? then
          stopObserved
        else
          !(stopObserved)
}

lemma canAdvanceBeeKEMForkAnchor_ensures(phase: BeeKEMForkPhase, revision: int, action: BeeKEMForkAction, leaseMatches: bool, stopObserved: bool)
  requires (0 <= revision)
  requires (revision <= MAX_REVISION)
  ensures (canAdvanceBeeKEMForkAnchor(phase, revision, action, leaseMatches, stopObserved) <==> ((revision < MAX_REVISION) && (((action.acquire? && phase.available?) && !(stopObserved)) || ((phase.active? && leaseMatches) && ((action.release? && !(stopObserved)) || (action.quarantine? && stopObserved))))))
{
}

const MAX_REVISION: int := 9007199254740991

datatype ForkAnchor = ForkAvailable(revision: int)
  | ForkActive(revision: int, lease: int)
  | ForkQuarantined(revision: int, generation: int)
datatype ForkState = ForkState(anchor: ForkAnchor, stops: map<ForkAnchor, int>)
datatype ForkEvent = Observe(held: ForkAnchor, observer: int, generation: int)
  | Attempt(expected: ForkAnchor, action: BeeKEMForkAction, owner: int,
      freshLease: int, committed: bool)

function ForkPhase(anchor: ForkAnchor): BeeKEMForkPhase
{
  match anchor
  case ForkAvailable(_) => BeeKEMForkPhase.available
  case ForkActive(_, _) => BeeKEMForkPhase.active
  case ForkQuarantined(_, _) => BeeKEMForkPhase.quarantined
}

predicate ForkOwns(anchor: ForkAnchor, owner: int)
{
  anchor.ForkActive? && anchor.lease == owner
}

predicate ForkRevisionValid(state: ForkState)
{
  0 <= state.anchor.revision <= MAX_REVISION
}

// A store scope begins with an independently provisioned available anchor.
// The store compares the entire expected record in one durable CAS and cannot
// roll back or reset that scope. The runtime supplies the caller's actual lease
// and a fresh token on acquisition. Observations are authenticated before this
// model's boundary; closing drains admitted observers before clean release.
// An observation without a committed quarantine leaves the durable active
// record present, which another session cannot acquire or release.
function ForkStep(state: ForkState, event: ForkEvent): ForkState
  requires ForkRevisionValid(state)
  ensures ForkRevisionValid(ForkStep(state, event))
{
  var anchor := state.anchor;
  match event
  case Observe(held, observer, generation) =>
    if held == anchor && ForkOwns(anchor, observer) &&
       anchor !in state.stops
    then ForkState(anchor, state.stops[anchor := generation])
    else state
  case Attempt(expected, action, owner, freshLease, committed) =>
    if committed && expected == anchor && canAdvanceBeeKEMForkAnchor(
      ForkPhase(anchor), anchor.revision, action, ForkOwns(anchor, owner),
      anchor in state.stops)
    then
      var revision := anchor.revision + 1;
      var next := match action
        case acquire => ForkActive(revision, freshLease)
        case release => ForkAvailable(revision)
        case quarantine => ForkQuarantined(revision, state.stops[anchor]);
      ForkState(next, state.stops)
    else state
}

function ForkHistory(state: ForkState, events: seq<ForkEvent>): ForkState
  requires ForkRevisionValid(state)
  ensures ForkRevisionValid(ForkHistory(state, events))
  decreases |events|
{
  if |events| == 0 then state
  else ForkHistory(ForkStep(state, events[0]), events[1..])
}

lemma beeKEMForkAnchor_allHistories(state: ForkState, events: seq<ForkEvent>)
  requires ForkRevisionValid(state)
  ensures ForkHistory(state, events).anchor.revision >= state.anchor.revision
  ensures state.anchor.ForkQuarantined? ==>
    ForkHistory(state, events).anchor == state.anchor
  ensures state.anchor.ForkActive? && state.anchor in state.stops ==>
    ForkHistory(state, events).anchor == state.anchor ||
    ForkHistory(state, events).anchor ==
      ForkQuarantined(state.anchor.revision + 1, state.stops[state.anchor])
  decreases |events|
{
  if |events| > 0 {
    var after := ForkStep(state, events[0]);
    beeKEMForkAnchor_allHistories(after, events[1..]);
    if state.anchor.ForkActive? && state.anchor in state.stops {
      if after.anchor == state.anchor {
        assert after.stops == state.stops;
      } else {
        assert after.anchor ==
          ForkQuarantined(state.anchor.revision + 1, state.stops[state.anchor]);
      }
    }
  }
}

predicate ForkAttemptLacksLease(anchor: ForkAnchor, event: ForkEvent)
{
  event.Attempt? &&
  (event.expected != anchor ||
    (anchor.ForkActive? && !ForkOwns(anchor, event.owner)))
}

lemma beeKEMForkAnchor_nonOwnerHistory(state: ForkState, events: seq<ForkEvent>)
  requires ForkRevisionValid(state)
  requires forall i :: 0 <= i < |events| ==>
    ForkAttemptLacksLease(state.anchor, events[i])
  ensures ForkHistory(state, events) == state
  decreases |events|
{
  if |events| > 0 {
    assert ForkAttemptLacksLease(state.anchor, events[0]);
    assert ForkStep(state, events[0]) == state;
    forall i | 0 <= i < |events[1..]|
      ensures ForkAttemptLacksLease(state.anchor, events[1..][i])
    {
      assert events[1..][i] == events[i + 1];
    }
    beeKEMForkAnchor_nonOwnerHistory(state, events[1..]);
  }
}

method beeKEMForkAnchor_domain()
{
  var available := ForkAvailable(0);
  var active := ForkActive(1, 11);
  var nextAvailable := ForkAvailable(2);
  var successor := ForkActive(3, 22);
  var stopped := ForkQuarantined(2, 9);
  var start := ForkState(available, map[]);
  var acquire := Attempt(available, BeeKEMForkAction.acquire, 0, 11, true);
  var release := Attempt(active, BeeKEMForkAction.release, 11, 0, true);
  var quarantine := Attempt(active, BeeKEMForkAction.quarantine, 11, 0, true);
  var stop := Observe(active, 11, 9);
  var interrupted := Attempt(active, BeeKEMForkAction.quarantine, 11, 0, false);
  var newOwner := Attempt(nextAvailable, BeeKEMForkAction.acquire, 0, 22, true);

  var live := ForkStep(start, acquire);
  assert live.anchor == active;
  var closed := ForkStep(live, release);
  assert closed.anchor == nextAvailable;
  var current := ForkStep(closed, newOwner);
  assert current.anchor == successor;
  var foreignRelease :=
    Attempt(successor, BeeKEMForkAction.release, 11, 0, true);
  beeKEMForkAnchor_nonOwnerHistory(current, [release, foreignRelease, release]);
  assert ForkHistory(current, [release, foreignRelease, release]).anchor == successor;

  var observed := ForkStep(live, stop);
  assert observed.anchor == active && active in observed.stops &&
    observed.stops[active] == 9;
  assert ForkStep(observed, interrupted) == observed;
  assert ForkStep(observed, release) == observed;
  var quarantined := ForkStep(observed, quarantine);
  assert quarantined.anchor == stopped;
  beeKEMForkAnchor_allHistories(observed, [release, quarantine, release]);
  beeKEMForkAnchor_allHistories(quarantined, [release, acquire]);
  assert ForkHistory(quarantined, [release, acquire]).anchor == stopped;
  assert !canAdvanceBeeKEMForkAnchor(
    BeeKEMForkPhase.active, MAX_REVISION, BeeKEMForkAction.release, true, false);
}
