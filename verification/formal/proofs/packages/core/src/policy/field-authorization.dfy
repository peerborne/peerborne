  requires (scanned <= 131072)
  requires (0 <= distinct)
  requires (distinct <= 4096)
  requires (0 <= units)
  requires (units <= 1048576)
  requires (0 <= additional)
  requires (additional <= 9007199254740991)
  requires (0 <= addedUnits)
  requires (addedUnits <= 9007199254740991)
{
  ((((additional >= 1) && (additional <= (131072 - scanned))) && (known || (distinct < 4096))) && (addedUnits <= (1048576 - units)))
}

