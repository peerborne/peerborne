    invariant (0 <= index)
    invariant (index <= |grant|)
    invariant forall i: int :: ((0 <= i) ==> (i < index) ==> (grant[i] == target[i]))
    decreases (|grant| - index)
  {
    if (grant[index] != target[index]) {
      return false;
    }
    index := (index + 1);
  }
  return true;
}

