predicate FieldPrefix(grant: seq<string>, target: seq<string>)
{
  |grant| <= |target| && forall i :: 0 <= i < |grant| ==> grant[i] == target[i]
}

predicate FieldGranted(grants: seq<seq<string>>, target: seq<string>)
{
  exists j :: 0 <= j < |grants| && FieldPrefix(grants[j], target)
}

predicate FieldOverlap(first: seq<string>, second: seq<string>)
{
  FieldPrefix(first, second) || FieldPrefix(second, first)
}

lemma field_prefix_transitive(first: seq<string>, second: seq<string>, third: seq<string>)
  requires FieldPrefix(first, second) && FieldPrefix(second, third)
  ensures FieldPrefix(first, third)
{
  forall i | 0 <= i < |first|
    ensures first[i] == third[i]
  {
    assert first[i] == second[i] && second[i] == third[i];
  }
}

lemma field_prefix_comparable(first: seq<string>, second: seq<string>, target: seq<string>)
  requires FieldPrefix(first, target) && FieldPrefix(second, target)
  ensures FieldOverlap(first, second)
{
  if |first| <= |second| {
    forall i | 0 <= i < |first|
      ensures first[i] == second[i]
    {
      assert first[i] == target[i] && second[i] == target[i];
    }
  } else {
    forall i | 0 <= i < |second|
      ensures second[i] == first[i]
    {
      assert first[i] == target[i] && second[i] == target[i];
    }
  }
}

lemma field_protected_noninterference(grants: seq<seq<string>>, protectedPath: seq<string>, target: seq<string>)
  requires FieldGranted(grants, target)
  requires forall j :: 0 <= j < |grants| ==> !FieldOverlap(grants[j], protectedPath)
  ensures !FieldOverlap(target, protectedPath)
{
  var j :| 0 <= j < |grants| && FieldPrefix(grants[j], target);
  if FieldPrefix(target, protectedPath) {
    field_prefix_transitive(grants[j], target, protectedPath);
  }
  if FieldPrefix(protectedPath, target) {
    field_prefix_comparable(grants[j], protectedPath, target);
  }
}

lemma field_grants_attenuate(parent: seq<seq<string>>, child: seq<seq<string>>, target: seq<string>)
  requires forall j :: 0 <= j < |child| ==> FieldGranted(parent, child[j])
  requires FieldGranted(child, target)
  ensures FieldGranted(parent, target)
{
  var j :| 0 <= j < |child| && FieldPrefix(child[j], target);
  var k :| 0 <= k < |parent| && FieldPrefix(parent[k], child[j]);
  field_prefix_transitive(parent[k], child[j], target);
}

function FieldAccepted(grants: seq<seq<string>>, batches: seq<seq<seq<string>>>, active: seq<bool>): seq<seq<string>>
  requires |batches| == |active|
  decreases |batches|
{
  if |batches| == 0 then [] else
    (if active[0] && (forall i :: 0 <= i < |batches[0]| ==> FieldGranted(grants, batches[0][i]))
      then batches[0] else []) + FieldAccepted(grants, batches[1..], active[1..])
}

method field_all_histories(grants: seq<seq<string>>, protectedPath: seq<string>, batches: seq<seq<seq<string>>>, active: seq<bool>)
  returns (admitted: seq<seq<string>>)
  requires |grants| <= 4294967295 && |batches| == |active|
  requires forall j :: 0 <= j < |grants| ==> |grants[j]| <= 4294967295
  requires forall b :: 0 <= b < |batches| ==> |batches[b]| <= 4294967295
  requires forall b, i :: 0 <= b < |batches| && 0 <= i < |batches[b]| ==> |batches[b][i]| <= 4294967295
  requires forall j :: 0 <= j < |grants| ==> !FieldOverlap(grants[j], protectedPath)
  ensures admitted == FieldAccepted(grants, batches, active)
  ensures forall i :: 0 <= i < |admitted| ==> FieldGranted(grants, admitted[i]) && !FieldOverlap(admitted[i], protectedPath)
  decreases |batches|
{
  if |batches| == 0 {
    admitted := [];
  } else {
    var rejected := firstUnauthorizedFieldPath(grants, batches[0]);
    if rejected == -1 {
      forall i | 0 <= i < |batches[0]|
        ensures FieldGranted(grants, batches[0][i])
      {
        var j :| 0 <= j < |grants| && |grants[j]| <= |batches[0][i]| &&
          forall k :: 0 <= k < |grants[j]| ==> grants[j][k] == batches[0][i][k];
        assert FieldPrefix(grants[j], batches[0][i]);
      }
    } else if FieldGranted(grants, batches[0][rejected]) {
      var j :| 0 <= j < |grants| && FieldPrefix(grants[j], batches[0][rejected]);
      assert |grants[j]| <= |batches[0][rejected]|;
      assert forall k :: 0 <= k < |grants[j]| ==> grants[j][k] == batches[0][rejected][k];
      assert false;
    }
    var current: seq<seq<string>> := [];
    if active[0] && rejected == -1 {
      current := batches[0];
      forall i | 0 <= i < |current|
        ensures FieldGranted(grants, current[i]) && !FieldOverlap(current[i], protectedPath)
      {
        var j :| 0 <= j < |grants| && |grants[j]| <= |current[i]| &&
          forall k :: 0 <= k < |grants[j]| ==> grants[j][k] == current[i][k];
        assert FieldPrefix(grants[j], current[i]);
        field_protected_noninterference(grants, protectedPath, current[i]);
      }
    }
    assert (rejected == -1) <==> (forall i :: 0 <= i < |batches[0]| ==> FieldGranted(grants, batches[0][i]));
    var rest := field_all_histories(grants, protectedPath, batches[1..], active[1..]);
    admitted := current + rest;
  }
}

method fieldAuthorization_domain()
{
  var exact := isFieldPathPrefix(["user", "name"], ["user", "name", "first"]);
  var ancestor := grantsFieldPath([["user", "name"]], ["user"]);
  assert exact && !ancestor;
  var grants: seq<seq<string>> := [["allowed"]];
  var targets: seq<seq<string>> := [["allowed", "child"]];
  assert FieldPrefix(grants[0], targets[0]);
  assert FieldGranted(grants, targets[0]);
  assert !FieldOverlap(grants[0], ["protected"]) by {
    assert grants[0][0] != ["protected"][0];
  }
  forall i | 0 <= i < |targets|
    ensures exists j :: (0 <= j < |grants| && |grants[j]| <= |targets[i]| &&
      (forall k :: 0 <= k < |grants[j]| ==> grants[j][k] == targets[i][k]))
  {
    assert i == 0;
    assert |grants[0]| <= |targets[i]|;
    assert forall k :: 0 <= k < |grants[0]| ==> grants[0][k] == targets[i][k];
  }
  var allowed := firstUnauthorizedFieldPath(grants, targets);
  assert allowed == -1;
  assert canAdmitFieldInspection(0, 131072, 0, false, 0, 1048576);
  assert !canAdmitFieldInspection(131072, 1, 0, false, 0, 0);
  assert !canAdmitFieldInspection(0, 1, 4096, false, 0, 0);
  assert canAdmitFieldInspection(0, 1, 4096, true, 0, 0);
  var admitted := field_all_histories(grants, ["protected"], [targets], [true]);
  assert admitted == targets;
  field_grants_attenuate([["allowed"]], [["allowed", "child"]], ["allowed", "child", "leaf"]);
}
